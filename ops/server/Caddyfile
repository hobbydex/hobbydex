# Caddyfile for hobbydex.com on its own server. Installed to /etc/caddy/Caddyfile by setup.sh.
# The site is a static build: /srv/hobbydex/current is a symlink to the newest release directory.
# HTTPS certificates are automatic (Let's Encrypt); ports 80 and 443 must be open and the DNS
# records must point here. Before DNS moves, setup.sh --pre-dns writes /etc/caddy/tls.d/internal.conf
# (`tls internal`) so the site can be tested with `tools/smoke.mjs --insecure --resolve ...`;
# delete that file and `systemctl reload caddy` when DNS has moved.

www.hobbydex.com {
	import tls.d/*
	redir https://hobbydex.com{uri} permanent
}

hobbydex.com {
	import tls.d/*

	# BEGIN web-bot-auth directory (generated: python3 -I tools/web_bot_auth.py directory-headers)
	@botdirectory path /.well-known/http-message-signatures-directory
	header @botdirectory {
		Content-Type application/http-message-signatures-directory+json
		Signature-Input `sig1=("@authority";req);created=1793822980;expires=1799006980;keyid="WsEm09fJOh9aKQpR9MLuIPWiT_TCsbNk79kruzYbhmA";alg="ed25519";tag="http-message-signatures-directory"`
		Signature `sig1=:yRcezdSZuNA6pMEl+U8eAC6eFpdi3n1KJDw8wB7Wg+ovfFxvicIdyypFrf8zQ6b9Ls/wSPEdsjQkHiY+qpqyDQ==:`
	}
	# END web-bot-auth directory

	root * /srv/hobbydex/current
	encode zstd gzip

	# The build writes no .gz/.br files, so there is nothing for `precompressed`; Caddy compresses
	# on the fly and caches nothing, which is fine at this size.

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Hashed file names never change: Astro assets and the Pagefind index and fragments.
	@immutable path /_astro/* /pagefind/index/* /pagefind/fragment/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Everything else (HTML, sitemaps, data/rc.json, the unhashed scripts) changes with each deploy.
	@mutable not path /_astro/* /pagefind/index/* /pagefind/fragment/*
	header @mutable Cache-Control "public, max-age=300, must-revalidate"

	# The site has no server-side redirects: Astro writes redirect stubs as HTML pages.
	# Directory URLs ("/x/" -> "/x/index.html") are served
	# by file_server's own index handling, and "/x" is redirected to "/x/" (trailingSlash is "always").
	file_server

	# The build has no 404.html yet; until it does, a 404 shows Caddy's plain "Not Found".
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
