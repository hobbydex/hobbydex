---
// A release drawn as its own outline (`art`), else its kit type's icon (a release never borrows its kit's
// outline: on a chassis platform that is another car), in the
// release's colour(s): one colour fills the shape, two or three stand side by side as vertical bands; metals
// get a sheen, see-through colours a light fill. White, see-through and very dark colours get a thin outline
// so they read on a light and a dark page alike. No colour (or an unknown word) draws the shape in the
// current text colour, like the type icon. Art is path data for a 48x24 viewBox, front of the car to the left.
import { wideIcons } from '../lib/wideIcons';
import { colourShades } from '../lib/colourDot';
import { kitTypeIcon, kitTypeOne } from '../lib/kitTypes';
// kit pages and lists draw the kit itself by passing its outline as `kitArt`
interface Props { category?: string; color?: string; size?: string; id: string; class?: string; art?: string; kitArt?: string }
const { category, color, size = '1.4em', id, class: cls, art, kitArt } = Astro.props;
const shape = art || kitArt;
const icon = kitTypeIcon(category);
const wide = !!shape || wideIcons.has(icon);
const w = wide ? 48 : 24, h = 24;
const shades = colourShades(color);
const uid = 'ra-' + id.replace(/[^a-z0-9]+/gi, '-');
const href = shape ? `#${uid}-p` : `/icons.svg#${icon}`;
const label = [kitTypeOne[category ?? 'car'] ?? category ?? '', color ?? ''].filter(Boolean).join(', ');
const n = shades?.length ?? 0, bw = n ? w / n : w;
// relative luminance of a #rrggbb shade, to outline the darkest ones (black on a dark page)
const lum = (c: string) => /^#[0-9a-f]{6}$/i.test(c) ? [1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16) / 255).reduce((a, v, i) => a + v * [0.2126, 0.7152, 0.0722][i], 0) : 1;
const dark = shades?.some((s) => !s.see && lum(s.c) < 0.15);   // black: outlined in the text colour, which shows on a dark page only
const edge = dark || shades?.some((s) => s.c === '#ffffff' || s.see);
// the outline: 0.6 of 24 units on a large drawing, about a pixel on a small one (an inline icon in a row)
const small = parseFloat(size) < 2.5 && /em$/.test(size);
---
<svg class={cls ? `relart ${cls}` : 'relart'} viewBox={`0 0 ${w} ${h}`} style={`width:${wide ? `calc(${size} * 2)` : size};height:${size}`} role="img" aria-label={label}><title>{label}</title>
  {(shape || shades) && <defs>
    {shape && <path id={`${uid}-p`} d={shape} />}
    {n > 1 && shades!.map((_, i) => <clipPath id={`${uid}-c${i}`}><rect x={i * bw} y="0" width={bw} height={h} /></clipPath>)}
    {shades?.some((s) => s.metal) && <linearGradient id={`${uid}-m`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#000" stop-opacity="0.2" /><stop offset="0.4" stop-color="#fff" stop-opacity="0.55" /><stop offset="0.6" stop-color="#fff" stop-opacity="0.05" /><stop offset="1" stop-color="#000" stop-opacity="0.3" /></linearGradient>}
  </defs>}
  {shades ? <>
    {shades.map((s, i) => <use href={href} fill={s.see ? 'rgba(150,150,160,0.35)' : s.c} clip-path={n > 1 ? `url(#${uid}-c${i})` : undefined} />)}
    {shades.map((s, i) => s.metal && <use href={href} fill={`url(#${uid}-m)`} clip-path={n > 1 ? `url(#${uid}-c${i})` : undefined} />)}
    {edge && <use href={href} fill="none" stroke={dark ? 'var(--fg)' : 'var(--muted)'} stroke-width={small ? 1.4 : 0.6} />}
  </> : <use href={href} fill="currentColor" />}
</svg>
