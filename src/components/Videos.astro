---
// The maker's own videos of a release, kit or part (documents of kind video, from the maker's official YouTube
// channel): a small thumbnail, the title as the channel gives it, the channel and the day. Nothing is embedded and
// nothing is stored: the thumbnail is YouTube's own, hot-linked from i.ytimg.com, and both it and the title open
// the video on YouTube in a new tab. `brand` adds the brand's name and `releases` the linked releases as links
// (the recent-videos page uses both).
import type { Doc } from '../lib/data';
import { isoText, db, url, brandName } from '../lib/data';
interface Props { videos: Doc[]; limit?: number; heading?: string | false; id?: string; brand?: boolean; releases?: boolean }
const { limit = 6, heading = 'Videos', id = 'videos', brand = false, releases = false } = Astro.props;
// newest first, undated last (a list may join a kit's videos and its releases')
const videos = [...Astro.props.videos].sort((a, b) => (b.date ?? '').localeCompare(a.date ?? '') || a.title.localeCompare(b.title));
const vid = (d: Doc) => new URL(d.url!).searchParams.get('v') ?? '';
const first = videos.slice(0, limit), rest = videos.slice(limit);
const length = (s?: number) => (s ? `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}` : '');
---
{videos.length > 0 && <>
  {heading !== false && <h2 id={id}>{heading} <span class="muted">({videos.length})</span></h2>}
  {[first, rest].filter((list) => list.length > 0).map((list, i) => {
    const ul = <ul class="videos">{list.map((d) => <li>
    <div class="media">
      <a class="thumb" href={d.url} rel="nofollow noopener" target="_blank" tabindex="-1" aria-hidden="true"><img src={`https://i.ytimg.com/vi/${vid(d)}/mqdefault.jpg`} width="128" height="72" loading="lazy" decoding="async" referrerpolicy="no-referrer" alt={d.title} />{d.duration_s && <span class="len">{length(d.duration_s)}</span>}</a>
      {releases && (d.releases ?? []).some((r) => db.release.get(r)) && <span class="rels">{(d.releases ?? []).filter((r) => db.release.get(r)).map((r) => <a href={url.release(r)}>{db.release.get(r)!.name}</a>)}</span>}
    </div>
    <span class="text"><a href={d.url} rel="nofollow noopener" target="_blank">{d.title}</a>
      <span class="muted">{[brand && d.brand ? brandName(d.brand) : undefined, d.channel ?? 'YouTube', d.date && isoText(d.date)].filter(Boolean).join(' · ')}</span></span>
  </li>)}</ul>;
    return i === 0 ? ul : <details class="allvideos"><summary>Show all {videos.length} videos</summary>{ul}</details>;
  })}
</>}

<style>
  .videos { list-style: none; padding: 0; margin: 0.5rem 0 1rem; display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); }
  .videos li { display: flex; gap: 0.6rem; align-items: flex-start; min-width: 0; }
  .thumb { position: relative; flex: none; display: block; line-height: 0; }
  /* overflow and the small font keep the alt text inside the box while the thumbnail loads or when it is blocked */
  .thumb img { width: 128px; height: 72px; object-fit: cover; overflow: hidden; font-size: 0.65rem; color: var(--muted); border-radius: 4px; background: var(--surface); border: 1px solid var(--border-muted); }
  .len { position: absolute; right: 4px; bottom: 4px; padding: 0 0.25rem; line-height: 1.3; font-size: 0.7rem; color: #fff; background: #000c; border-radius: 3px; }
  .text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; overflow-wrap: anywhere; line-height: 1.3; }
  .text .muted { font-size: 0.8rem; }
  .media { flex: none; width: 128px; min-width: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  /* the release links sit under the thumbnail, as wide as it, and wrap inside it */
  .rels { display: flex; flex-wrap: wrap; gap: 0.1rem 0.5rem; font-size: 0.75rem; line-height: 1.3; overflow-wrap: anywhere; }
  @media (max-width: 40rem) { .videos { grid-template-columns: 1fr; } .media { width: 112px; } .thumb img { width: 112px; height: 63px; } }
  .allvideos > summary { cursor: pointer; margin: 0 0 0.5rem; }
</style>
