---
// A line icon from /icons.svg, drawn in the current text colour (works in light and dark mode).
import { wideIcons } from '../lib/wideIcons';
interface Props { name: string; label?: string; size?: string }
const { name, label, size } = Astro.props;
---
<svg class={wideIcons.has(name) ? 'icon wide' : 'icon'} style={size ? (wideIcons.has(name) ? `width:calc(${size} * 2);height:${size}` : `width:${size};height:${size}`) : undefined} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}><use href={`/icons.svg#${name}`} /></svg>
