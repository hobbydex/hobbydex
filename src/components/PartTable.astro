---
// A filterable, sortable table of parts with their category's key spec columns.
// Ticked rows can be shown side by side.
import { db, url, brandName, byPartNo, partLabel, partRest, type Part } from '../lib/data';
import Discontinued from './Discontinued.astro';
import HideDiscontinued from './HideDiscontinued.astro';
import Icon from './Icon.astro';
import { columns, specOf, type Column } from '../lib/categoryColumns';
import { plugLinks } from '../lib/plugs';
import { paintChip } from '../lib/paintSwatch';
import { colourDot } from '../lib/colourDot';
// fields: the columns to show, when the page picks its own (the ESC and motor compare pages); else the category's key fields
interface Props { category: string; parts: Part[]; showBrand?: boolean; fields?: Column[] }
const { category, parts, showBrand = true, fields } = Astro.props;
const all = fields ?? columns[category] ?? [];
const isDisc = (p: Part) => p.status === 'discontinued';
const raw = parts.map((p) => { const s = specOf(p); return { p, vals: all.map((c) => c.get(p, s)) }; });
// a column none of these parts has a value for is left out (the Radio column on an ESC maker's page)
const keep = all.map((_, i) => raw.some((r) => r.vals[i] !== undefined));
const cols = all.filter((_, i) => keep[i]);
const rows = raw.map(({ p, vals }) => ({ p, vals: vals.filter((_, i) => keep[i]) }))
  // brand, then current before discontinued, then part number (natural order: PS-2 before PS-10); a column header click re-sorts
  .sort((a, b) => brandName(a.p.brand).localeCompare(brandName(b.p.brand)) || (isDisc(a.p) ? 1 : 0) - (isDisc(b.p) ? 1 : 0) || byPartNo(a.p, b.p));
const hasDisc = parts.some(isDisc);
const brands = [...new Set(parts.map((p) => p.brand))].sort((a, b) => brandName(a).localeCompare(brandName(b)));
// a dropdown for each text column with a short list of values (mounting, rim size, vehicle, ...)
const picks = cols.map((c, i) => ({ c, i, // a column with pick false has no dropdown; a multi column (a list in one cell, scales) offers each item
  choices: c.num || c.field.compare_only || c.pick === false ? [] : [...new Set(rows.flatMap((r) => { const v = r.vals[i]; return v === undefined ? [] : c.multi ? String(v).split(', ') : [String(v)]; }))].sort() as string[] }))
  .filter((x) => x.choices.length > 1 && x.choices.length <= 60);
// a column with filter = range gets a from-to box on its largest number (watts: "100 AC / 250 DC" counts as 250)
const ranges = cols.map((c, i) => ({ c, i })).filter(({ c }) => c.field.filter === 'range');
---
<div class="parttable" data-pagefind-ignore>
  <p class="websearch">
    <span class="sfield"><Icon name="search" /><input type="search" class="q search-box" placeholder="Filter by number or name" aria-label="Filter" /></span>
    {showBrand && brands.length > 1 && <select class="brand" aria-label="Brand"><option value="">every brand</option>{brands.map((b) => <option value={b}>{brandName(b)}</option>)}</select>}
    {picks.map(({ c, i, choices }) => <select class="pick" data-col={i} data-multi={c.multi ? '' : undefined} data-key={c.label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')} aria-label={c.label}><option value="">any {c.label.toLowerCase()}</option>{choices.map((v) => <option>{v}</option>)}</select>)}
    {ranges.map(({ c, i }) => <span class="rangef" data-col={i} data-key={c.label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}>{c.label} <input type="number" class="rmin" min="0" inputmode="numeric" placeholder="from" aria-label={`${c.label} from`} /> <input type="number" class="rmax" min="0" inputmode="numeric" placeholder="to" aria-label={`${c.label} to`} /></span>)}
    {cols.length > 0 && <label><input type="checkbox" class="known" /> only with specs</label>}
    {hasDisc && <HideDiscontinued />}
    <button type="button" class="btn cmp" disabled>Compare ticked</button>
    <button type="button" class="btn clear" hidden>Clear ticks</button>
    <span class="muted count"></span>
  </p>
  <div class="side"></div>
  <div class="tablescroll"><table>
    <thead><tr><th></th><th data-k="text">Part</th>{cols.map((c) => <th data-k={c.num ? 'num' : 'text'} class={`${c.num ? 'num' : ''}${c.field.compare_only ? ' conly' : ''}`}>{c.label}</th>)}</tr></thead>
    <tbody>
      {rows.map(({ p, vals }) => <tr data-brand={p.brand} data-known={vals.some((v) => v !== undefined) ? '1' : ''} data-discontinued={isDisc(p) ? '' : undefined}>
        <td><input type="checkbox" autocomplete="off" aria-label={`Compare ${partLabel(p)}`} /></td>
        <td><a href={url.part(p.id)}>{showBrand && `${brandName(p.brand)} `}{partLabel(p)}</a>{partRest(p) && <span class="muted"> {partRest(p)}</span>}<Discontinued item={p} />{isDisc(p) && (db.replacedBy.get(p.id) ?? []).map((r) => <span class="muted"> replaced by <a href={url.part(r.id)}>{partLabel(r)}</a></span>)}</td>
        {vals.map((v, i) => { const f = cols[i].field.field, paint = p.category === 'paint';
          const sw = f === 'color' && paint ? paintChip(p, 22, 'circle') : undefined;
          // a named colour (not a paint): a dot from the fixed palette
          const dot = (f === 'color' || f === 'wheel_color') && !paint ? colourDot((p as unknown as Record<string, string | undefined>)[f]) : '';
          return <td class={`${cols[i].num ? 'num' : ''}${cols[i].field.compare_only ? ' conly' : ''}`}>{sw && <span class="swatch" title="approximate colour" set:html={sw} />}{dot && <Fragment set:html={dot} />}{cols[i].plug && v ? (cols[i].multi ? String(v).split(', ') : [String(v)]).map((name, k) => <>{k > 0 && ', '}{plugLinks(name).map((l, j) => <>{j > 0 && '/'}{l.spec ? <a href={url.spec(l.spec)}>{l.text}</a> : l.text}</>)}</>) : (v ?? '')}</td>; })}
      </tr>)}
    </tbody>
  </table></div>
</div>
<script>
  for (const box of document.querySelectorAll<HTMLElement>('.parttable')) {
    const table = box.querySelector('table')!, body = table.tBodies[0];
    const q = box.querySelector<HTMLInputElement>('.q')!, brand = box.querySelector<HTMLSelectElement>('.brand');
    const rangeBoxes = [...box.querySelectorAll<HTMLElement>('.rangef')];
    const picks = [...box.querySelectorAll<HTMLSelectElement>('.pick')], known = box.querySelector<HTMLInputElement>('.known');
    const cmp = box.querySelector<HTMLButtonElement>('.cmp')!, clear = box.querySelector<HTMLButtonElement>('.clear')!, side = box.querySelector<HTMLElement>('.side')!, count = box.querySelector<HTMLElement>('.count')!;
    const valueOf = (tr: HTMLTableRowElement, s: HTMLSelectElement): string[] => s === brand ? [tr.dataset.brand!] : s.dataset.multi !== undefined ? tr.cells[Number(s.dataset.col) + 2].textContent!.split(', ') : [tr.cells[Number(s.dataset.col) + 2].textContent!];
    // a row passes every filter but `skip`: the choices of one select are the values left by the other filters
    const passes = (tr: HTMLTableRowElement, skip: HTMLSelectElement | null) => {
      const text = q.value.trim().toLowerCase();
      return (!text || tr.cells[1].textContent!.toLowerCase().includes(text)) && (!known?.checked || !!tr.dataset.known)
        && [brand, ...picks].every((s) => !s || s === skip || !s.value || valueOf(tr, s).includes(s.value))
        && rangeBoxes.every((r) => {
          const lo = r.querySelector<HTMLInputElement>('.rmin')!.value, hi = r.querySelector<HTMLInputElement>('.rmax')!.value;
          if (lo === '' && hi === '') return true;
          const nums = (tr.cells[Number(r.dataset.col) + 2].textContent!.match(/\d+(?:\.\d+)?/g) ?? []).map(Number);
          if (!nums.length) return false;
          const top = Math.max(...nums);
          return (lo === '' || top >= Number(lo)) && (hi === '' || top <= Number(hi));
        });
    };
    // the filters live in the URL (?q=...&brand=...&<spec>=...&specs=1), so a filtered view can be shared and survives a reload
    const keyOf = (s: HTMLSelectElement) => s === brand ? 'brand' : s.dataset.key!;
    const params = new URLSearchParams(location.search);
    q.value = params.get('q') ?? '';
    for (const s of [brand, ...picks]) if (s) s.value = params.get(keyOf(s)) ?? '';
    if (known) known.checked = params.get('specs') === '1';
    for (const r of rangeBoxes) { r.querySelector<HTMLInputElement>('.rmin')!.value = params.get(`${r.dataset.key}-min`) ?? ''; r.querySelector<HTMLInputElement>('.rmax')!.value = params.get(`${r.dataset.key}-max`) ?? ''; }
    const remember = () => {
      const u = new URLSearchParams(location.search);
      for (const k of ['q', 'specs', ...[brand, ...picks].filter(Boolean).map((s) => keyOf(s!)), ...rangeBoxes.flatMap((r) => [`${r.dataset.key}-min`, `${r.dataset.key}-max`])]) u.delete(k);
      for (const r of rangeBoxes) for (const [cls, suffix] of [['.rmin', 'min'], ['.rmax', 'max']]) { const v = r.querySelector<HTMLInputElement>(cls)!.value; if (v !== '') u.set(`${r.dataset.key}-${suffix}`, v); }
      if (q.value.trim()) u.set('q', q.value.trim());
      for (const s of [brand, ...picks]) if (s?.value) u.set(keyOf(s), s.value);
      if (known?.checked) u.set('specs', '1');
      const qs = u.toString();
      history.replaceState(null, '', (qs ? `?${qs}` : location.pathname) + location.hash);
    };
    const filter = () => {
      remember();
      let shown = 0;
      const off = document.documentElement.classList.contains('hide-discontinued');
      for (const tr of body.rows) { tr.hidden = !passes(tr, null); if (!tr.hidden && !(off && tr.dataset.discontinued !== undefined)) shown++; }
      count.textContent = `${shown} of ${body.rows.length}`;
      // cascade: a brushed motor's size filter offers brushed sizes only (the chosen value always stays)
      for (const s of [brand, ...picks]) {
        if (!s) continue;
        const left = new Set([...body.rows].filter((tr) => passes(tr, s)).flatMap((tr) => valueOf(tr, s)));
        for (const o of s.options) { const off = !!o.value && o.value !== s.value && !left.has(o.value); o.hidden = off; o.disabled = off; }
      }
    };
    for (const el of [q, brand, ...picks, known]) el?.addEventListener(el === q ? 'input' : 'change', filter);
    for (const r of rangeBoxes) r.addEventListener('input', filter);
    window.addEventListener('discontinued-toggle', filter);
    filter();
    table.tHead!.querySelectorAll<HTMLTableCellElement>('th[data-k]').forEach((th) => {
      let dir = -1; th.style.cursor = 'pointer';
      th.addEventListener('click', () => {
        dir = -dir; const i = th.cellIndex, num = th.dataset.k === 'num';
        const val = (tr: HTMLTableRowElement) => tr.cells[i].textContent!.trim();
        [...body.rows].sort((a, b) => {
          const x = val(a), y = val(b);
          if (!x) return 1; if (!y) return -1;
          return (num ? parseFloat(x) - parseFloat(y) : x.localeCompare(y, undefined, { numeric: true })) * dir;
        }).forEach((tr) => body.appendChild(tr));
      });
    });
    const ticked = () => [...body.querySelectorAll<HTMLInputElement>('input:checked')].map((c) => c.closest('tr')!);
    const update = () => { const k = ticked().length; cmp.disabled = k < 2; cmp.textContent = k ? `Compare ${k} ticked` : 'Compare ticked'; clear.hidden = !k; };
    body.addEventListener('change', update);
    update();
    clear.addEventListener('click', () => {
      for (const c of body.querySelectorAll<HTMLInputElement>('input:checked')) c.checked = false;
      side.replaceChildren(); update();
    });
    cmp.addEventListener('click', () => {
      const trs = ticked(), heads = [...table.tHead!.rows[0].cells].slice(1).map((c) => c.textContent);
      const tb = document.createElement('table');
      heads.forEach((h, i) => {
        const r = tb.insertRow(); const th = document.createElement('th'); th.textContent = h; r.appendChild(th);
        for (const tr of trs) { const td = r.insertCell(); td.innerHTML = tr.cells[i + 1].innerHTML; }
      });
      const scroll = document.createElement('div'); scroll.className = 'tablescroll'; scroll.appendChild(tb);
      side.replaceChildren(Object.assign(document.createElement('h2'), { textContent: 'Side by side' }), scroll);
      side.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>
<style>
  /* compare_only fields: kept in the DOM for the side by side view */
  .parttable table .conly { display: none; }
  /* a long option (mount holes) must not push the filter row past a phone's width */
  .parttable .websearch select { max-width: 100%; }
  .parttable .rangef input { width: 5.5em; }
</style>
