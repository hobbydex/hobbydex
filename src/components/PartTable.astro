---
// A filterable, sortable table of parts with their category's key spec columns.
// Ticked rows can be shown side by side.
import { url, brandName, type Part } from '../lib/data';
import { columns, specOf } from '../lib/categoryColumns';
import { paintChip } from '../lib/paintSwatch';
import { colourDot } from '../lib/colourDot';
interface Props { category: string; parts: Part[]; showBrand?: boolean }
const { category, parts, showBrand = true } = Astro.props;
const cols = columns[category] ?? [];
const short = (p: Part) => (p.name.startsWith(p.number) ? p.name.slice(p.number.length).trim() : p.name === p.number ? '' : p.name);
const rows = parts.map((p) => { const s = specOf(p); return { p, vals: cols.map((c) => c.get(p, s)) }; })
  // brand, then part number (natural order: PS-2 before PS-10); a column header click re-sorts
  .sort((a, b) => brandName(a.p.brand).localeCompare(brandName(b.p.brand)) || a.p.number.localeCompare(b.p.number, undefined, { numeric: true }));
const brands = [...new Set(parts.map((p) => p.brand))].sort((a, b) => brandName(a).localeCompare(brandName(b)));
// a dropdown for each text column with a short list of values (mounting, rim size, vehicle, ...)
const picks = cols.map((c, i) => ({ c, i, choices: c.num || c.field.compare_only ? [] : [...new Set(rows.map((r) => r.vals[i]).filter((v) => v !== undefined))].sort() as string[] }))
  .filter((x) => x.choices.length > 1 && x.choices.length <= 60);
---
<div class="parttable" data-pagefind-ignore>
  <p class="websearch">
    <input type="search" class="q" placeholder="Filter by number or name" aria-label="Filter" />
    {showBrand && brands.length > 1 && <select class="brand" aria-label="Brand"><option value="">every brand</option>{brands.map((b) => <option value={b}>{brandName(b)}</option>)}</select>}
    {picks.map(({ c, i, choices }) => <select class="pick" data-col={i} data-key={c.label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')} aria-label={c.label}><option value="">any {c.label.toLowerCase()}</option>{choices.map((v) => <option>{v}</option>)}</select>)}
    {cols.length > 0 && <label><input type="checkbox" class="known" /> only with specs</label>}
    <button type="button" class="btn cmp" disabled>Compare ticked</button>
    <button type="button" class="btn clear" hidden>Clear ticks</button>
    <span class="muted count"></span>
  </p>
  <div class="side"></div>
  <table>
    <thead><tr><th></th><th data-k="text">Part</th>{cols.map((c) => <th data-k={c.num ? 'num' : 'text'} class={`${c.num ? 'num' : ''}${c.field.compare_only ? ' conly' : ''}`}>{c.label}</th>)}</tr></thead>
    <tbody>
      {rows.map(({ p, vals }) => <tr data-brand={p.brand} data-known={vals.some((v) => v !== undefined) ? '1' : ''}>
        <td><input type="checkbox" autocomplete="off" aria-label={`Compare ${p.number}`} /></td>
        <td><a href={url.part(p.id)}>{showBrand && `${brandName(p.brand)} `}{p.number}</a>{short(p) && <span class="muted"> {short(p)}</span>}</td>
        {vals.map((v, i) => { const f = cols[i].field.field, paint = p.category === 'paint';
          const sw = f === 'color' && paint ? paintChip(p, 22, 'circle') : undefined;
          // a named colour (not a paint): a dot from the fixed palette
          const dot = (f === 'color' || f === 'wheel_color') && !paint ? colourDot((p as unknown as Record<string, string | undefined>)[f]) : '';
          return <td class={`${cols[i].num ? 'num' : ''}${cols[i].field.compare_only ? ' conly' : ''}`}>{sw && <span class="swatch" title="approximate colour" set:html={sw} />}{dot && <Fragment set:html={dot} />}{v ?? ''}</td>; })}
      </tr>)}
    </tbody>
  </table>
</div>
<script>
  for (const box of document.querySelectorAll<HTMLElement>('.parttable')) {
    const table = box.querySelector('table')!, body = table.tBodies[0];
    const q = box.querySelector<HTMLInputElement>('.q')!, brand = box.querySelector<HTMLSelectElement>('.brand');
    const picks = [...box.querySelectorAll<HTMLSelectElement>('.pick')], known = box.querySelector<HTMLInputElement>('.known');
    const cmp = box.querySelector<HTMLButtonElement>('.cmp')!, clear = box.querySelector<HTMLButtonElement>('.clear')!, side = box.querySelector<HTMLElement>('.side')!, count = box.querySelector<HTMLElement>('.count')!;
    const valueOf = (tr: HTMLTableRowElement, s: HTMLSelectElement) => s === brand ? tr.dataset.brand : tr.cells[Number(s.dataset.col) + 2].textContent;
    // a row passes every filter but `skip`: the choices of one select are the values left by the other filters
    const passes = (tr: HTMLTableRowElement, skip: HTMLSelectElement | null) => {
      const text = q.value.trim().toLowerCase();
      return (!text || tr.cells[1].textContent!.toLowerCase().includes(text)) && (!known?.checked || !!tr.dataset.known)
        && [brand, ...picks].every((s) => !s || s === skip || !s.value || valueOf(tr, s) === s.value);
    };
    // the filters live in the URL (?q=...&brand=...&<spec>=...&specs=1), so a filtered view can be shared and survives a reload
    const keyOf = (s: HTMLSelectElement) => s === brand ? 'brand' : s.dataset.key!;
    const params = new URLSearchParams(location.search);
    q.value = params.get('q') ?? '';
    for (const s of [brand, ...picks]) if (s) s.value = params.get(keyOf(s)) ?? '';
    if (known) known.checked = params.get('specs') === '1';
    const remember = () => {
      const u = new URLSearchParams(location.search);
      for (const k of ['q', 'specs', ...[brand, ...picks].filter(Boolean).map((s) => keyOf(s!))]) u.delete(k);
      if (q.value.trim()) u.set('q', q.value.trim());
      for (const s of [brand, ...picks]) if (s?.value) u.set(keyOf(s), s.value);
      if (known?.checked) u.set('specs', '1');
      const qs = u.toString();
      history.replaceState(null, '', (qs ? `?${qs}` : location.pathname) + location.hash);
    };
    const filter = () => {
      remember();
      let shown = 0;
      for (const tr of body.rows) { tr.hidden = !passes(tr, null); if (!tr.hidden) shown++; }
      count.textContent = `${shown} of ${body.rows.length}`;
      // cascade: a brushed motor's size filter offers brushed sizes only (the chosen value always stays)
      for (const s of [brand, ...picks]) {
        if (!s) continue;
        const left = new Set([...body.rows].filter((tr) => passes(tr, s)).map((tr) => valueOf(tr, s)));
        for (const o of s.options) { const off = !!o.value && o.value !== s.value && !left.has(o.value); o.hidden = off; o.disabled = off; }
      }
    };
    for (const el of [q, brand, ...picks, known]) el?.addEventListener(el === q ? 'input' : 'change', filter);
    filter();
    table.tHead!.querySelectorAll<HTMLTableCellElement>('th[data-k]').forEach((th) => {
      let dir = -1; th.style.cursor = 'pointer';
      th.addEventListener('click', () => {
        dir = -dir; const i = th.cellIndex, num = th.dataset.k === 'num';
        const val = (tr: HTMLTableRowElement) => tr.cells[i].textContent!.trim();
        [...body.rows].sort((a, b) => {
          const x = val(a), y = val(b);
          if (!x) return 1; if (!y) return -1;
          return (num ? Number(x) - Number(y) : x.localeCompare(y, undefined, { numeric: true })) * dir;
        }).forEach((tr) => body.appendChild(tr));
      });
    });
    const ticked = () => [...body.querySelectorAll<HTMLInputElement>('input:checked')].map((c) => c.closest('tr')!);
    const update = () => { const k = ticked().length; cmp.disabled = k < 2; cmp.textContent = k ? `Compare ${k} ticked` : 'Compare ticked'; clear.hidden = !k; };
    body.addEventListener('change', update);
    update();
    clear.addEventListener('click', () => {
      for (const c of body.querySelectorAll<HTMLInputElement>('input:checked')) c.checked = false;
      side.replaceChildren(); update();
    });
    cmp.addEventListener('click', () => {
      const trs = ticked(), heads = [...table.tHead!.rows[0].cells].slice(1).map((c) => c.textContent);
      const tb = document.createElement('table');
      heads.forEach((h, i) => {
        const r = tb.insertRow(); const th = document.createElement('th'); th.textContent = h; r.appendChild(th);
        for (const tr of trs) { const td = r.insertCell(); td.innerHTML = tr.cells[i + 1].innerHTML; }
      });
      side.replaceChildren(Object.assign(document.createElement('h2'), { textContent: 'Side by side' }), tb);
      side.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>
<style>
  /* compare_only fields: kept in the DOM for the side by side view */
  .parttable table .conly { display: none; }
</style>
