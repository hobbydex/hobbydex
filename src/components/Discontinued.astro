---
// The mark beside the name of a discontinued release or part (status "discontinued"); renders nothing for any other status.
import Icon from './Icon.astro';
interface Props { item: { status?: string } }
const { item } = Astro.props;
---
{item.status === 'discontinued' && <span class="disc" title="Discontinued"><Icon name="discontinued" size="1em" /><span class="sr-only">discontinued</span></span>}
