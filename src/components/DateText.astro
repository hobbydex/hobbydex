---
// A date column cell: the date text, plus a "*" that shows the seen note on hover, focus or tap (abbr.doubt in
// global.css) when only a seen_by bound dates the release. `year` shows the year text (yearTextPlain) instead.
// A release that is announced (status, or only an announcement date) shows a megaphone before its date, in place of
// the word "announced".
import Icon from './Icon.astro';
import { seenNote, dateTextPlain, isoText, releasedOf, seenOnly, yearTextPlain, statusOf, isComing, comingText } from '../lib/data';
interface Props { r: { year?: number; released?: string; announced?: string; seen_by?: string; seen_by_source?: string; model_year?: number; status?: string }; year?: boolean; verbose?: boolean }
const { r, year, verbose } = Astro.props;
const announced = statusOf(r) === 'announced' || (!releasedOf(r) && !!r.announced);
const when = releasedOf(r) ? (year ? yearTextPlain(r) : isoText(releasedOf(r)!)) : r.announced ? isoText(r.announced) : undefined;
---
{isComing(r)
  ? <span class="coming-date" title={comingText(r) + ' (coming, not out yet)'}><Icon name="expected" label={comingText(r) + ' (coming, not out yet)'} size="1em" /> {when}</span>
  : seenOnly(r)
  ? <span class="seen-date" title="Seen by this day (not the release date)"><Icon name="seenby" label="Seen by this day (not the release date)" size="1em" /> {isoText(r.seen_by!)}</span>
  : announced && when ? <span class="announced" title={releasedOf(r) ? `announced, due ${when}` : `announced ${when}`}><Icon name="announced" label="announced" size="1em" /> {when}</span> : year ? yearTextPlain(r) : dateTextPlain(r)}{seenOnly(r) && <abbr class="doubt seen" tabindex="0" data-tip={seenNote(r)} aria-label={seenNote(r)}>*</abbr>}
