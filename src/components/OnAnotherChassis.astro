---
// Releases of a type built on a platform of another type (Tamiya race trucks on the TT-01E touring car kit).
import Discontinued from './Discontinued.astro';
import DateText from './DateText.astro';
import DateDoubt from './DateDoubt.astro';
import DoubtNote from './DoubtNote.astro';
import { db, url, brandName, yearDoubt, type Release } from '../lib/data';
interface Props { rs: Release[] }
const { rs } = Astro.props;
---
{rs.length > 0 && <>
  <h2>On another chassis <span class="muted">({rs.length})</span></h2>
  <p class="muted">Releases of this type built on a platform of another type.</p>
  <table class="releases">
    <tr><th>Release</th><th>Brand</th><th>Platform</th><th class="num">Year</th></tr>
    {rs.map((r) => <tr><td class="name"><a href={url.release(r.id)}>{r.name}</a><Discontinued item={r} /></td><td data-label="Brand"><a href={url.brand(r.brand)}>{brandName(r.brand)}</a></td><td data-label="Platform"><a href={url.platform(r.kit)}>{db.kit.get(r.kit)?.name}</a></td><td class="num" data-label="Year"><DateText r={r} year /><DateDoubt reason={yearDoubt(r)} /></td></tr>)}
  </table>
  <DoubtNote on={rs.some((r) => !!yearDoubt(r))} />
</>}
<style>
  @media (max-width: 600px) { table.releases td[data-label]:not(:empty) { display: inline-block; white-space: normal; } }
</style>
