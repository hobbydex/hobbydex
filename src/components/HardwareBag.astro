---
// A hardware bag: one inline SVG in millimetres. Each spec is a symbol (its drawing from src/assets/hardware,
// made by tools/hardware/make_drawings.py); its copies are <use> elements placed in mm, five per row, up to 20 per
// spec and then "+N". Groups run largest drawing first, each with a caption. One 1 cm bar sits under the last row,
// left-aligned with the bottom-left item, its ticks pointing down. The svg is as wide as its page column, but at most
// 12 px per mm, so a single small part is not blown up. Lines are currentColor with non-scaling strokes; the silhouette
// takes the part's colour, or the page background when it has none. A rubber seal fills the bearing's shield face.
import { colourShades } from '../lib/colourDot';
import { db } from '../lib/data';
import { hardwareFile, hardwareSvg, type BagItem } from '../lib/hardwareBag';

interface Props { items: BagItem[]; seal?: string; color?: string }
const { items, seal, color } = Astro.props;
const COLS = 5, CAP = 20, BAR = 10, MARGIN = 0.5, MAX_PX_PER_MM = 12;
const SEAL_FILL = 'var(--seal-rubber, #8a8f98)'; // a rubber seal (2RS/RS) face; a metal shield keeps the part's fill

const num = (v: unknown) => (typeof v === 'number' ? String(v) : String(v ?? ''));
const shortName = (id: string) => {
  const s = db.spec.get(id) as Record<string, unknown> | undefined;
  if (!s) return id.split('/').pop()!;
  switch (s.category) {
    case 'bearing': return `${num(s.bore_mm)}x${num(s.outer_mm)}x${num(s.width_mm)}`;
    case 'nut': return `${num(s.thread)} ${num(s.type)}`;
    case 'washer': return `${num(s.bore_mm)}x${num(s.outer_mm)}x${num(s.thickness_mm)}`;
    case 'eclip': return `${num(s.shaft_mm)} mm e-clip`;
    case 'pinion': return s.pitch_dp ? `${num(s.teeth)}T ${num(s.pitch_dp)}dp` : `${num(s.teeth)}T mod ${num(s.module)}`;
    default: return `${num(s.thread ?? s.diameter_mm)}x${num(s.length_mm)}`;
  }
};
const fullName = (id: string) => db.spec.get(id)?.name ?? id.split('/').pop()!;
const luminance = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
  .reduce((a, v, i) => a + v * [0.2126, 0.7152, 0.0722][i], 0);

// the part's colour: silhouette fill, and the ink for the lines on it (light ink on a dark fill)
const shade = colourShades(color)?.[0]?.c;
const fill = shade ?? 'var(--bg, #fff)';
const ink = shade ? (luminance(shade) < 0.3 ? '#f2f2f5' : '#1a1a1f') : 'currentColor';

// the groups, largest drawing first; a spec listed twice is one group
const groups = [...new Map(items.filter((i) => hardwareFile(i.spec)).map((i) => [i.spec, i.qty])).entries()]
  .map(([spec, qty]) => {
    const useSeal = !!seal && (seal === 'rubber' || seal === 'rubber-metal') && spec.startsWith('spec/bearing/');
    const file = hardwareFile(spec)!;
    const svg = hardwareSvg(file)!;
    const vb = svg.match(/viewBox="([^"]+)"/)![1].split(' ').map(Number) as [number, number, number, number];
    return {
      spec, qty, useSeal, vb,
      id: `hb-${file.replace(/\.svg$/, '')}${useSeal ? '-seal' : ''}`,
      pitchX: Number(svg.match(/data-pitch-x="([^"]+)"/)![1]), pitchY: Number(svg.match(/data-pitch-y="([^"]+)"/)![1]),
      sil: svg.match(/<path class="sil" d="([^"]*)"/)![1], seg: svg.match(/<path class="seal" d="([^"]*)"/)?.[1],
      lines: svg.match(/<g class="lines"[^>]*>([\s\S]*?)<\/g>/)![0],
    };
  })
  .sort((a, b) => b.vb[2] * b.vb[3] - a.vb[2] * a.vb[3]);

// the layout in mm: captions, rows of copies, the bar. The caption font grows with a wide bag (at least 2.2 mm,
// a width/28 otherwise) so it stays readable when the whole bag is drawn small on a phone.
const symbols = new Map<string, string>();
groups.forEach((g) => {
  if (symbols.has(g.id)) return;
  symbols.set(g.id, `<symbol id="${g.id}" viewBox="${g.vb.join(' ')}"><path d="${g.sil}" fill-rule="evenodd"/>`
    + `${g.useSeal && g.seg ? `<path d="${g.seg}" fill-rule="evenodd" style="fill:${SEAL_FILL}"/>` : ''}${g.lines}</symbol>`);
});
function layout(FONT: number) {
  const parts: string[] = [];
  let y = 0, width = BAR;
  groups.forEach((g) => {
    const [, , vw, vh] = g.vb;
    const total = g.qty ?? 1, n = Math.min(total, CAP), more = total - n;
    parts.push(`<text x="0" y="${(y + FONT).toFixed(2)}" font-size="${FONT.toFixed(2)}" fill="currentColor">${shortName(g.spec)}${g.qty !== undefined ? ` x ${g.qty}` : ''}</text>`);
    const top = y + FONT * 1.5;
    let lastX = 0, lastY = top;
    for (let k = 0; k < n; k++) {
      const x = (k % COLS) * g.pitchX, yy = top + Math.floor(k / COLS) * g.pitchY;
      parts.push(`<use href="#${g.id}" x="${x.toFixed(2)}" y="${yy.toFixed(2)}" width="${vw.toFixed(2)}" height="${vh.toFixed(2)}" style="fill:${fill};color:${ink}"/>`);
      lastX = x + vw; lastY = yy + vh / 2;
      width = Math.max(width, x + vw);
    }
    if (more > 0) {
      parts.push(`<text x="${(lastX + 0.5).toFixed(2)}" y="${(lastY + FONT / 3).toFixed(2)}" font-size="${FONT.toFixed(2)}" fill="currentColor">+${more}</text>`);
      width = Math.max(width, lastX + 0.5 + FONT * 2);
    }
    const rows = Math.ceil(n / COLS);
    y = top + (rows - 1) * g.pitchY + vh + FONT * 0.8;
  });
  // the bar: 1.5 mm below the last row, left-aligned with the first item, ticks down; "1 cm" below it
  const barY = y - FONT * 0.8 + 1.5;
  const ticks: string[] = [];
  for (let m = 0; m <= BAR; m++) {
    const k = m === 0 || m === BAR ? 1.2 : m === BAR / 2 ? 0.85 : 0.6;
    ticks.push(`<line x1="${m}" y1="${barY.toFixed(2)}" x2="${m}" y2="${(barY + k).toFixed(2)}"/>`);
  }
  parts.push(`<g class="hbbar" stroke="currentColor" stroke-width="0.12" fill="none"><path d="M0 ${barY.toFixed(2)} H${BAR}"/>${ticks.join('')}</g>`);
  parts.push(`<text x="${BAR / 2}" y="${(barY + 1.2 + FONT).toFixed(2)}" font-size="${FONT.toFixed(2)}" text-anchor="middle" fill="currentColor">1 cm</text>`);
  return { parts: parts.join(''), width, height: barY + 1.2 + FONT * 1.3 };
}
const first = layout(2.2);
const FONT = Math.max(2.2, (first.width + 2 * MARGIN) / 28);
const { parts: body, width, height } = FONT === 2.2 ? first : layout(FONT);
const label = groups.map((g) => `${g.qty !== undefined ? `${g.qty} x ` : ''}${fullName(g.spec)}`).join(', ');
const vbox = [-MARGIN, -MARGIN, width + 2 * MARGIN, height + 2 * MARGIN].map((v) => v.toFixed(2)).join(' ');
const maxWidth = ((width + 2 * MARGIN) * MAX_PX_PER_MM).toFixed(0);
---
{groups.length > 0 && (
  <svg class="hardwarebag" viewBox={vbox} role="img" aria-label={label} style={`max-width: ${maxWidth}px`} font-family="sans-serif">
    <defs set:html={[...symbols.values()].join('')} />
    <Fragment set:html={body} />
  </svg>
)}
<style>
  .hardwarebag { display: block; width: 100%; height: auto; margin: 0.5rem 0 1rem; overflow: visible; --seal-rubber: #8a8f98; }
  @media (prefers-color-scheme: dark) { .hardwarebag { --seal-rubber: #6b7079; } }
  .hardwarebag [vector-effect] { vector-effect: non-scaling-stroke; }
</style>
