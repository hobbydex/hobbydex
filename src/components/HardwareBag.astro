---
// A hardware bag: one inline SVG in millimetres. Each spec is a symbol (its drawing from src/assets/hardware,
// made by tools/hardware/make_drawings.py); its copies are <use> elements placed in mm, five per row, up to 20 per
// spec and then "+N". Groups run largest drawing first, each with a caption. One 1 cm bar sits under the last row,
// left-aligned with the bottom-left item, its ticks pointing down. The svg is as wide as its page column, but at most
// 12 px per mm, so a single small part is not blown up. Lines are currentColor with non-scaling strokes; the silhouette
// takes the part's colour, else its finish or material tone, else the page background. A rubber seal fills the bearing's shield face.
// A caption prints the count the data states ("3x8 x 4"), and no count when it states none. A screw caption adds its
// head word ("3x8 countersunk") when the bag holds more than one head type of that size. A bag that draws only some
// of a set's rows says so on its first line ("10 of 18 items drawn"). A bag whose items state no quantity says
// "quantities not stated" on its first line, or "some quantities not stated" when only some items lack one.
import { colourShades } from '../lib/colourDot';
import { db } from '../lib/data';
import { hardwareFile, hardwareSvg, metalTone, type BagItem } from '../lib/hardwareBag';

interface Props { items: BagItem[]; drawn?: number; total?: number; seal?: string; color?: string; finish?: string; material?: string }
const { items, drawn, total, seal, color, finish, material } = Astro.props;
const partial = drawn !== undefined && total !== undefined && drawn < total ? `${drawn} of ${total} items drawn` : undefined;
const COLS = 5, CAP = 20, BAR = 10, MARGIN = 0.5, MAX_PX_PER_MM = 12;
const SEAL_FILL = 'var(--seal-rubber, #8a8f98)'; // a rubber seal (2RS/RS) face; a metal shield keeps the part's fill

const num = (v: unknown) => (typeof v === 'number' ? String(v) : String(v ?? ''));
const shortName = (id: string) => {
  const s = db.spec.get(id) as Record<string, unknown> | undefined;
  if (!s) return id.split('/').pop()!;
  switch (s.category) {
    case 'bearing': return `${num(s.bore_mm)}x${num(s.outer_mm)}x${num(s.width_mm)}`;
    case 'nut': return `${num(s.thread)} ${num(s.type)}`;
    case 'washer': return `${num(s.bore_mm)}x${num(s.outer_mm)}x${num(s.thickness_mm)}`;
    case 'eclip': return `${num(s.shaft_mm)} mm e-clip`;
    case 'pinion': return s.pitch_dp ? `${num(s.teeth)}T ${num(s.pitch_dp)}dp` : `${num(s.teeth)}T mod ${num(s.module)}`;
    default: return `${num(s.thread ?? s.diameter_mm)}x${num(s.length_mm)}`;
  }
};
const specOf = (id: string) => db.spec.get(id) as Record<string, unknown> | undefined;
const headWord = (id: string) => String(specOf(id)?.head ?? '').replace(/-/g, ' ');
const fullName = (id: string) => db.spec.get(id)?.name ?? id.split('/').pop()!;
const luminance = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
  .reduce((a, v, i) => a + v * [0.2126, 0.7152, 0.0722][i], 0);

// the part's colour: silhouette fill, and the ink for the lines on it (light ink on a dark fill). With no colour, the
// tone of its finish or material (CSS variables --hb-<tone>, set below), else the page background.
// a rubber-sealed bearing's colour is the colour of its seals: the rings stay metal and the seal face takes the colour
const sealed = (seal === 'rubber' || seal === 'rubber-metal') && items.length > 0 && items.every((i) => i.spec.startsWith('spec/bearing/'));
const sealShade = sealed ? colourShades(color)?.[0]?.c : undefined;
const shade = sealed ? undefined : colourShades(color)?.[0]?.c;
// metal hardware (screws, nuts, washers, pins, e-clips, bearings, pinions) is steel unless the part says otherwise: silver rather than the page background
const steelByDefault = items.length > 0 && items.every((i) => /^spec\/(eclip|bearing|screw|nut|washer|pin|pinion)\//.test(i.spec));
const tone = shade ? undefined : metalTone(finish, material) ?? (steelByDefault ? 'steel' : undefined);
const fill = shade ?? (tone ? `var(--hb-${tone})` : 'var(--bg, #fff)');
const ink = shade ? (luminance(shade) < 0.3 ? '#f2f2f5' : '#1a1a1f') : tone ? `var(--hb-${tone}-ink)` : 'currentColor';

// the groups, largest drawing first; a spec listed twice is one group
const groups = [...new Map(items.filter((i) => hardwareFile(i.spec, i.point)).map((i) => [hardwareFile(i.spec, i.point)!, i])).values()]
  .map(({ spec, qty, copies, point }) => {
    const useSeal = !!seal && (seal === 'rubber' || seal === 'rubber-metal') && spec.startsWith('spec/bearing/');
    const file = hardwareFile(spec, point)!;
    const svg = hardwareSvg(file)!;
    const vb = svg.match(/viewBox="([^"]+)"/)![1].split(' ').map(Number) as [number, number, number, number];
    return {
      spec, qty, copies, useSeal, vb,
      id: `hb-${file.replace(/\.svg$/, '')}${useSeal ? '-seal' : ''}`,
      pitchX: Number(svg.match(/data-pitch-x="([^"]+)"/)![1]), pitchY: Number(svg.match(/data-pitch-y="([^"]+)"/)![1]),
      sil: svg.match(/<path class="sil" d="([^"]*)"/)![1], seg: svg.match(/<path class="seal" d="([^"]*)"/)?.[1],
      lines: svg.match(/<g class="lines"[^>]*>([\s\S]*?)<\/g>/)![0],
    };
  })
  .sort((a, b) => b.vb[2] * b.vb[3] - a.vb[2] * a.vb[3]);

// a screw's caption carries its head word when the bag holds another head type of the same size (M3x6 button, M3x6 countersunk)
const headsOfSize = new Map<string, Set<string>>();
groups.forEach((g) => {
  if (specOf(g.spec)?.category !== 'screw') return;
  const size = shortName(g.spec);
  headsOfSize.set(size, (headsOfSize.get(size) ?? new Set()).add(headWord(g.spec)));
});
const caption = (g: (typeof groups)[number]) => {
  const size = shortName(g.spec);
  const head = specOf(g.spec)?.category === 'screw' && headsOfSize.get(size)!.size > 1 ? ` ${headWord(g.spec)}` : '';
  return `${size}${head}${g.qty !== undefined ? ` x ${g.qty}` : ''}`;
};

// the lines above the groups: the partial line, then a line for the quantities the data does not state
const unstated = groups.filter((g) => g.qty === undefined).length;
const qtyNote = unstated === 0 ? undefined : unstated === groups.length ? 'quantities not stated' : 'some quantities not stated';
const headLines = [partial, qtyNote].filter((line): line is string => !!line);

// the layout in mm: captions, rows of copies, the bar. The caption font grows with a wide bag (at least 2.2 mm,
// a width/28 otherwise) so it stays readable when the whole bag is drawn small on a phone.
const symbols = new Map<string, string>();
groups.forEach((g) => {
  if (symbols.has(g.id)) return;
  symbols.set(g.id, `<symbol id="${g.id}" viewBox="${g.vb.join(' ')}"><path d="${g.sil}" fill-rule="evenodd"/>`
    + `${g.useSeal && g.seg ? `<path d="${g.seg}" fill-rule="evenodd" style="fill:${sealShade ?? SEAL_FILL}"/>` : ''}${g.lines}</symbol>`);
});
function layout(FONT: number) {
  const parts: string[] = [];
  let y = 0, width = BAR;
  headLines.forEach((line, i) => {
    parts.push(`<text class="hbnote" x="0" y="${(FONT + i * FONT * 1.8).toFixed(2)}" font-size="${FONT.toFixed(2)}" font-style="italic" fill="currentColor">${line}</text>`);
    width = Math.max(width, FONT * 0.55 * line.length);
  });
  y = headLines.length * FONT * 1.8;
  groups.forEach((g) => {
    const [, , vw, vh] = g.vb;
    const n = Math.min(g.copies, CAP), more = g.copies - n;
    const text = caption(g);
    parts.push(`<text x="0" y="${(y + FONT).toFixed(2)}" font-size="${FONT.toFixed(2)}" fill="currentColor">${text}</text>`);
    width = Math.max(width, FONT * 0.55 * text.length);
    const top = y + FONT * 1.5;
    let lastX = 0, lastY = top;
    for (let k = 0; k < n; k++) {
      const x = (k % COLS) * g.pitchX, yy = top + Math.floor(k / COLS) * g.pitchY;
      parts.push(`<use href="#${g.id}" x="${x.toFixed(2)}" y="${yy.toFixed(2)}" width="${vw.toFixed(2)}" height="${vh.toFixed(2)}" style="fill:${fill};color:${ink}"/>`);
      lastX = x + vw; lastY = yy + vh / 2;
      width = Math.max(width, x + vw);
    }
    if (more > 0) {
      parts.push(`<text x="${(lastX + 0.5).toFixed(2)}" y="${(lastY + FONT / 3).toFixed(2)}" font-size="${FONT.toFixed(2)}" fill="currentColor">+${more}</text>`);
      width = Math.max(width, lastX + 0.5 + FONT * 2);
    }
    const rows = Math.ceil(n / COLS);
    y = top + (rows - 1) * g.pitchY + vh + FONT * 0.8;
  });
  // the bar: 1.5 mm below the last row, left-aligned with the first item, ticks down; "1 cm" below it
  const barY = y - FONT * 0.8 + 1.5;
  const ticks: string[] = [];
  for (let m = 0; m <= BAR; m++) {
    const k = m === 0 || m === BAR ? 1.2 : m === BAR / 2 ? 0.85 : 0.6;
    ticks.push(`<line x1="${m}" y1="${barY.toFixed(2)}" x2="${m}" y2="${(barY + k).toFixed(2)}"/>`);
  }
  parts.push(`<g class="hbbar" stroke="currentColor" stroke-width="0.12" fill="none"><path d="M0 ${barY.toFixed(2)} H${BAR}"/>${ticks.join('')}</g>`);
  parts.push(`<text x="${BAR / 2}" y="${(barY + 1.2 + FONT).toFixed(2)}" font-size="${FONT.toFixed(2)}" text-anchor="middle" fill="currentColor">1 cm</text>`);
  return { parts: parts.join(''), width, height: barY + 1.2 + FONT * 1.3 };
}
const first = layout(2.2);
const FONT = Math.max(2.2, (first.width + 2 * MARGIN) / 28);
const { parts: body, width, height } = FONT === 2.2 ? first : layout(FONT);
const label = headLines.map((line) => `${line}: `).join('') + groups.map((g) => `${g.qty !== undefined ? `${g.qty} x ` : ''}${fullName(g.spec)}`).join(', ');
const vbox = [-MARGIN, -MARGIN, width + 2 * MARGIN, height + 2 * MARGIN].map((v) => v.toFixed(2)).join(' ');
const maxWidth = ((width + 2 * MARGIN) * MAX_PX_PER_MM).toFixed(0);
---
{groups.length > 0 && (
  <svg class="hardwarebag" viewBox={vbox} role="img" aria-label={label} style={`max-width: ${maxWidth}px`} font-family="sans-serif">
    <defs set:html={[...symbols.values()].join('')} />
    <Fragment set:html={body} />
  </svg>
)}
<style>
  .hardwarebag { display: block; width: 100%; height: auto; margin: 0.5rem 0 1rem; overflow: visible; --seal-rubber: #8a8f98;
    --hb-steel: #c9ccd1; --hb-steel-ink: #3b3f46; --hb-darkzinc: #807e72; --hb-darkzinc-ink: #26241f; --hb-black: #2b2e33; --hb-black-ink: #f2f2f5;
    --hb-titanium: #a39e96; --hb-titanium-ink: #3a3733; --hb-aluminium: #dfe2e6; --hb-aluminium-ink: #4a4f57; --hb-brass: #c8a24a; --hb-brass-ink: #5a4312;
    --hb-copper: #b8683d; --hb-copper-ink: #5a2b14; --hb-plastic: #f2efe6; --hb-plastic-ink: #5c5850; }
  @media (prefers-color-scheme: dark) { :root:not([data-color-mode="light"]) .hardwarebag { --seal-rubber: #6b7079;
    --hb-steel: #b9bec6; --hb-steel-ink: #1e2126; --hb-darkzinc: #6f6d64; --hb-darkzinc-ink: #1c1b18; --hb-black: #4a4e55; --hb-black-ink: #e6e8ec;
    --hb-titanium: #8f8a84; --hb-titanium-ink: #1e1c1a; --hb-aluminium: #cfd3d9; --hb-aluminium-ink: #20232a; --hb-brass: #a8843a; --hb-brass-ink: #2a1f08;
    --hb-copper: #a3583a; --hb-copper-ink: #2a1208; --hb-plastic: #d8d4c9; --hb-plastic-ink: #2c2a26; } }
  :root[data-color-mode="dark"] .hardwarebag { --seal-rubber: #6b7079;
    --hb-steel: #b9bec6; --hb-steel-ink: #1e2126; --hb-darkzinc: #6f6d64; --hb-darkzinc-ink: #1c1b18; --hb-black: #4a4e55; --hb-black-ink: #e6e8ec;
    --hb-titanium: #8f8a84; --hb-titanium-ink: #1e1c1a; --hb-aluminium: #cfd3d9; --hb-aluminium-ink: #20232a; --hb-brass: #a8843a; --hb-brass-ink: #2a1f08;
    --hb-copper: #a3583a; --hb-copper-ink: #2a1208; --hb-plastic: #d8d4c9; --hb-plastic-ink: #2c2a26; }
  .hardwarebag [vector-effect] { vector-effect: non-scaling-stroke; }
</style>
