---
// one source document of a record, labelled with its kind: "Product page: <site>", "Video: <title> (<channel>, <date>)",
// "Manual: <title>". The link is the maker's page that lists the document (never the file); a video links the video
// itself. A document with no page shows its title and the file's host.
import { db, docPage } from '../lib/data';
import { docKindLabel, hostLabel, pageLabel } from '../lib/docFacts';
const { id, released } = Astro.props as { id: string; released?: string };
const d = db.doc.get(id);
const page = d && (d.kind === 'video' ? d.url : docPage(d, released));
// a product page is named by its site, and its language when the address gives one
const text = d && page && d.kind === 'product_page' ? (pageLabel(page) === hostLabel(page) ? hostLabel(page) : `${hostLabel(page)} (${pageLabel(page)})`) : d?.title;
const meta = d ? [!page && d.url && new URL(d.url).hostname, d.kind === 'video' && d.channel, d.version, d.date].filter(Boolean) : [];
---
{d ? <>{docKindLabel(d.kind)}: {page ? <a href={page} rel="nofollow">{text}</a> : text}{meta.length > 0 && <span class="muted"> ({meta.join(', ')})</span>}</> : id}
