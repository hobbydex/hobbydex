---
// Web search button with engine choice, an optional copy icon button (CopyButton) and outbound reference links.
import type { Link } from '../lib/data';
import CopyButton from './CopyButton.astro';
interface Props { query: string; copy?: string; copyLabel?: string; links?: Link[] }
const { query, copy, copyLabel = 'Copy number', links = [] } = Astro.props;
// fan and community sites are courtesy links, not sources: shown apart, and labelled so
const own = links.filter((l) => l.kind !== 'fan-site'), fans = links.filter((l) => l.kind === 'fan-site');
---
<p class="websearch" data-pagefind-ignore data-q={query}>
  <a class="btn" href={`https://www.google.com/search?q=${encodeURIComponent(query)}`} rel="nofollow noopener" target="_blank">Search the web</a>
  <select aria-label="Search engine"><option value="google">Google</option><option value="ddg">DuckDuckGo</option><option value="bing">Bing</option><option value="ecosia">Ecosia</option></select>
  {copy && <CopyButton text={copy} label={copyLabel} class="btn" />}
  {own.map((l) => <a class="btn" href={l.url} rel="noopener" target="_blank">{l.site}</a>)}
</p>
{fans.length > 0 && <p class="fanlinks muted" data-pagefind-ignore>Also on {fans.map((l, i) => <>{i > 0 && ', '}<a href={l.url} rel="noopener" target="_blank">{l.site}</a></>)}, a fan site; a courtesy link, not a source for Hobbydex.</p>}
<script>
  const ENGINES: Record<string, string> = {
    google: 'https://www.google.com/search?q=', ddg: 'https://duckduckgo.com/?q=', bing: 'https://www.bing.com/search?q=', ecosia: 'https://www.ecosia.org/search?q=',
  };
  for (const box of document.querySelectorAll<HTMLElement>('.websearch[data-q]')) {
    const a = box.querySelector('a')!, sel = box.querySelector('select')!;
    const q = box.dataset.q ?? '';
    const set = () => { a.href = (ENGINES[sel.value] ?? ENGINES.google) + encodeURIComponent(q); };
    try { const saved = localStorage.getItem('hobbydex-engine'); if (saved && ENGINES[saved]) sel.value = saved; } catch {}
    set();
    sel.addEventListener('change', () => { set(); try { localStorage.setItem('hobbydex-engine', sel.value); } catch {} });
  }
</script>
