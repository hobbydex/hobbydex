---
// Where this record lives in the data repo (view only; reports go through an issue, see /faq/).
interface Props { path?: string; id?: string }
const { path, id } = Astro.props;
const issue = `${'https://github.com/hobbydex/hobbydex-rc'}/issues/new?title=${encodeURIComponent((id ?? path ?? '') + ': ')}&body=${encodeURIComponent(`Page: https://hobbydex.com${Astro.url.pathname}\n\nWhat is wrong or missing:\n`)}`;
const repo = 'https://github.com/hobbydex/hobbydex-rc';
---
{path && <p class="muted datalink" data-pagefind-ignore>Data: <a href={`${repo}/blob/main/${path}`} rel="noopener">{path.split('/').pop()}</a> on GitHub · <a href={issue} rel="noopener">report an error</a></p>}
