---
import '../styles/global.css';
interface Props { title: string; description?: string; jsonld?: unknown; kind?: string; sub?: string }
const { title, description, jsonld, kind, sub } = Astro.props;
---
<!doctype html>
<html lang="en" data-color-mode="auto" data-light-theme="light" data-dark-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Hobbydex</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#0969da" />
    <script is:inline>
      // the saved theme choice (auto, light, dark) applies before the page paints
      try { const t = localStorage.getItem('hobbydex-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.colorMode = t; } catch (e) {}
    </script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <header class="site" data-pagefind-ignore>
      <a class="logo" href="/"><img src="/favicon.svg" alt="" width="22" height="22" /> Hobbydex</a>
      <nav>
        <a href="/rc/">RC cars</a>
        <a href="/rc/kits/">Kits</a>
        <a href="/search/">Search</a>
        <a href="https://github.com/hobbydex">GitHub</a>
      </nav>
      <button type="button" class="theme" aria-label="Theme: auto" title="Theme: auto (follows the system)"><svg class="icon"><use href="/icons.svg#theme-auto" /></svg></button>
      <script is:inline>
        (() => {
          const b = document.querySelector('header.site .theme'), html = document.documentElement, modes = ['auto', 'light', 'dark'];
          const label = { auto: 'auto (follows the system)', light: 'light', dark: 'dark' };
          const show = (m) => { b.querySelector('use').setAttribute('href', `/icons.svg#theme-${m}`); b.title = `Theme: ${label[m]}`; b.setAttribute('aria-label', `Theme: ${m}`); };
          show(html.dataset.colorMode || 'auto');
          b.addEventListener('click', () => {
            const m = modes[(modes.indexOf(html.dataset.colorMode || 'auto') + 1) % 3];
            html.dataset.colorMode = m; show(m);
            try { m === 'auto' ? localStorage.removeItem('hobbydex-theme') : localStorage.setItem('hobbydex-theme', m); } catch (e) {}
          });
        })();
      </script>
    </header>
    <main data-pagefind-body>
      {kind && <span hidden data-pagefind-meta={`type:${kind}`} data-pagefind-filter={`type:${kind}`} />}
      {sub && <span hidden data-pagefind-meta={`sub:${sub}`} />}
      <slot />
    </main>
    <footer class="site" data-pagefind-ignore>
      Open hobby parts database. Facts only: part numbers, names and fitment with their source; no prices, stock or images.
      Data and corrections: <a href="https://github.com/hobbydex/hobbydex-rc">hobbydex/hobbydex-rc</a>.
      Download everything as one file: <a href="/data/rc.json">rc.json</a> (CC0). <a href="/audit/">Data audit</a>.
    </footer>
  </body>
</html>
