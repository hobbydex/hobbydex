---
import '../styles/global.css';
interface Props { title: string; description?: string; jsonld?: unknown; kind?: string; sub?: string }
const { title, description, jsonld, kind, sub } = Astro.props;
---
<!doctype html>
<html lang="en" data-color-mode="auto" data-light-theme="light" data-dark-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Hobbydex</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#0969da" />
    <script is:inline>
      // the saved theme choice (auto, light, dark) applies before the page paints
      try { const t = localStorage.getItem('hobbydex-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.colorMode = t; } catch (e) {}
    </script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <header class="site" data-pagefind-ignore>
      <a class="logo" href="/"><img src="/favicon.svg" alt="" width="22" height="22" /> Hobbydex</a>
      <nav>
        <a href="/rc/">RC cars</a>
        <a href="/rc/platforms/">Platforms</a>
        <a href="/search/">Search</a>
        <a href="/faq/">FAQ</a>
        <a class="gh" href="https://github.com/hobbydex">GitHub</a>
      </nav>
      <button type="button" class="theme" aria-label="Theme: auto" title="Theme: auto (follows the system)"><svg class="icon"><use href="/icons.svg#theme-auto" /></svg></button>
      <script src="/theme.js" defer></script>
    </header>
    {/* SIZE: the built site is kept small for GitHub Pages (about 1 GB soft limit; 1.1 GB in 2026-10): shared
        scripts are external cached files (public/theme.js and astro.config.mjs assetsInlineLimit) rather than
        inline on each of 115k pages. Measured 2026-10-13: the pagefind index is ~55 MB in real bytes and taking
        the tables out of it would save only ~13 MB, so tables stay searchable; part pages (~5.8 KB each) are the
        bulk. Only kits, releases, parts, specs and brands are searchable; list pages are not. */}
    <main data-pagefind-body={kind ? "" : undefined}>
      {kind && <span hidden data-pagefind-meta={`type:${kind}`} data-pagefind-filter={`type:${kind}`} />}
      {sub && <span hidden data-pagefind-meta={`sub:${sub}`} />}
      <slot />
    </main>
    <footer class="site" data-pagefind-ignore>
      Open hobby parts database. Facts only: part numbers, names and fitment with their source; no prices, stock or images.
      The data is maintained by the project, not crowdsourced: tell us about an error, a missing brand or a better source by <a href="https://github.com/hobbydex/hobbydex-rc/issues/new">opening an issue</a>; see the <a href="/faq/">FAQ</a>.
      The data is public on <a href="https://github.com/hobbydex/hobbydex-rc">GitHub</a> and as one file: <a href="/data/rc.json">rc.json</a>. <a href="/stats/">Statistics</a> · <a href="/audit/">Data audit</a>.
    </footer>
  </body>
</html>
