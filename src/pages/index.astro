---
import Icon from '../components/Icon.astro';
import ReleaseArt from '../components/ReleaseArt.astro';
import Discontinued from '../components/Discontinued.astro';
import { kitTypeOne } from '../lib/kitTypes';
import { releasesByType } from '../lib/releaseTypes';
import Base from '../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { db, url, brandName, dateKey, dateDoubt, isComing, releasedOf, releasesByMake, bodiesByMake } from '../lib/data';
import DateText from '../components/DateText.astro';
import DateDoubt from '../components/DateDoubt.astro';
import DoubtNote from '../components/DoubtNote.astro';
import ScanButton from '../components/ScanButton.astro';
import ColourSwitch from '../components/ColourSwitch.astro';
import { dateRows, colourLabels, groupName, releaseColour } from '../lib/colourways';

const top = <T,>(m: Map<T, number>, n: number) => [...m.entries()].sort((a, b) => b[1] - a[1]).slice(0, n);
const byCat = new Map<string, number>();
for (const p of db.parts) if (p.category) byCat.set(p.category, (byCat.get(p.category) ?? 0) + 1);
// platforms by how many parts of other brands are made to fit them: what Hobbydex adds over a maker's own site
const upgrades = new Map<string, number>(), upgradeBrands = new Map<string, Set<string>>();
for (const p of db.parts) for (const k of new Set((p.fits ?? []).map((f) => f.kit))) {
  const kit = db.kit.get(k);
  if (!kit || kit.brand === p.brand) continue;
  upgrades.set(k, (upgrades.get(k) ?? 0) + 1);
  if (!upgradeBrands.has(k)) upgradeBrands.set(k, new Set());
  upgradeBrands.get(k)!.add(p.brand);
}
const upgraded = top(upgrades, 12);
// car makers by how many releases (kits and RTRs) we have: part counts favour sellers of per-car bearing or screw kits
const byBrand = new Map<string, number>();
for (const r of db.releases) byBrand.set(r.brand, (byBrand.get(r.brand) ?? 0) + 1);
const brands = top(byBrand, 12);
// the newest rows: one per colourway group (the same car in several colours is one row, lib/colourways.ts), of the
// releases that are not discontinued; one row per kit, so one platform cannot fill the list
const seenKit = new Set<string>();
const out = db.releases.filter((r) => r.status !== 'discontinued' && !isComing(r));
const latest = dateRows(out, dateKey, () => 0)
  .filter((x) => !seenKit.has(x.head.kit) && seenKit.add(x.head.kit)).slice(0, 10);
// announced and not out yet, soonest first: their own group above the latest releases, never labelled Released;
// all of them, so a later date is never pushed off the list by newer announcements
const coming = dateRows(db.releases.filter(isComing), (r) => { const d = releasedOf(r)!; return d.length === 4 ? d + '-13' : d; }, () => 0)
  .sort((a, b) => a.key.localeCompare(b.key));
const max = (xs: [unknown, number][]) => Math.max(...xs.map((x) => x[1]));
// the hero's car: the site's own buggy icon (public/icons.svg#buggy, 48x24, front to the left, wheels on
// y=23.2), split into body and wing (its first two subpaths) and the two wheels, so the suspension can work
const buggy = (readFileSync('public/icons.svg', 'utf8').match(/<symbol id="buggy"[^>]*>\s*<path[^>]*d="([^"]+)"/) ?? [])[1] ?? '';
const parts = buggy.split('Z').filter((x) => x.trim()).map((x) => x + 'Z');
const BODY = parts.slice(0, 2).join(''), WHEELS = parts.slice(2).join('');
// the band's lower edge is a rolling wave; the car rides it in and lifts off the crest at three quarters of
// the width, hanging just above it with the dirt it kicked up (one run; with reduced motion the end pose at
// once). The drawing scales with the width, so a phone shows the whole run. GROUND is the edge, AIR the car's
// line: the wave up its rising face, then a rising arc that leaves it along the same slope.
const GROUND = 'M-200 140 C 0 140 100 112 250 112 S 520 150 680 142 S 840 96 900 96 S 1010 146 1120 150 L 1400 150';
const AIR = 'M-200 140 C 0 140 100 112 250 112 S 520 150 680 142 C 779.2 137.0 816.9 120.5 845.5 108.7 C 901.0 85.8 930.5 68.7 975.5 60.7';
// debris: thrown back and up from under the rear wheel while the car leaves the crest; the specks ride along
// with the car (they are in its frame) and hang just behind it at the end. [x, y, r] in the car's frame
// (its middle at 0, wheels on y=0, front to the right): the rear wheel touches down near x=-30.
// RUN_IN: before the path the car drives in along the flat from further left (RUN_IN seconds at the path's
// speed, about 372 units/s), so on very wide screens, which show more of the left, it still enters unseen.
const RUN_IN = 1.4, RUN_DX = 521, T0 = RUN_IN;
const KICK = [-30, -1], KICK_AT = T0 + 2.7;
const DIRT = [[-44, -8, 2.4], [-52, -16, 1.8], [-58, -5, 2.0], [-66, -22, 1.4], [-74, -11, 1.2], [-82, -26, 0.9], [-40, -2, 1.5]];
---
<Base title="Open hobby parts database" description="Hobbydex: which parts are in my RC car, what fits it, and what is it equivalent to. Open data, no prices, no images of our own.">
  <h1 class="sr-only">Hobbydex</h1>
  <section class="home-hero">
    <p class="tagline">The open RC database: what's new, what's inside, what fits.</p>
    <form class="home-search" action="/search/" method="get" role="search">
      <ScanButton />
      <div class="ac">
        <input type="search" name="q" id="home-q" placeholder="Part number, part name, platform or brand" aria-label="Search"
          role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="home-ac" autocomplete="off" />
        <div class="ac-pop" id="home-pop" hidden>
          <div class="ac-status" id="home-ac-status" role="status"></div>
          <ul class="ac-list" id="home-ac" role="listbox" aria-label="Suggestions"></ul>
          <a class="ac-all" id="home-ac-all" href="/search/">All results</a>
        </div>
      </div>
      <button type="submit" aria-label="Search"><Icon name="search" /><span class="label">Search</span></button>
    </form>
    <svg class="hero-edge" viewBox="0 0 1200 170" preserveAspectRatio="xMaxYMax meet" aria-hidden="true" focusable="false">
      <path class="below" d={`M-3000 140 L${GROUND.slice(1)} V 171 H -3000 Z`} />
      <g><animateTransform attributeName="transform" type="translate" from={`${-RUN_DX} 0`} to="0 0" dur={`${RUN_IN}s`} fill="freeze" />
      <g class="car">
        <g transform="translate(-48 -46.4) scale(2)"><g transform="translate(48 0) scale(-1 1)">
          <path d={WHEELS} fill-rule="evenodd" />
          <g><path d={BODY} fill-rule="evenodd" /><animateTransform attributeName="transform" type="translate" values="0 0; 0 0; 0 1.2; 0 -1" keyTimes="0; 0.7; 0.9; 1" calcMode="spline" keySplines="0 0 1 1; 0.4 0 0.6 1; 0.3 0 0.4 1" dur="3.2s" begin={`${T0}s`} fill="freeze" /></g>
        </g></g>
        <g class="dirt">{DIRT.map(([x, y, r], i) => <circle cx={KICK[0]} cy={KICK[1]} r={r} opacity="0">
          <animate attributeName="cx" from={KICK[0]} to={x} begin={`${KICK_AT + i * 0.04}s`} dur="0.5s" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines="0.2 0.6 0.4 1" />
          <animate attributeName="cy" from={KICK[1]} to={y} begin={`${KICK_AT + i * 0.04}s`} dur="0.5s" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines="0.2 0.6 0.4 1" />
          <set attributeName="opacity" to="1" begin={`${KICK_AT + i * 0.04}s`} fill="freeze" />
        </circle>)}</g>
        <!-- nose up in the air: the car pitches back as it leaves the crest and stays so -->
        <animateTransform attributeName="transform" type="rotate" values="0; 0; -5" keyTimes="0; 0.85; 1" calcMode="spline" keySplines="0 0 1 1; 0.3 0 0.4 1" dur="3.2s" begin={`${T0}s`} fill="freeze" additive="sum" />
        <animateMotion dur="3.2s" begin={`${T0}s`} fill="freeze" rotate="auto" path={AIR} />
      </g></g>
    </svg>
  </section>
  <script is:inline>
    // reduced motion: the hero car stands where its drive would end
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { const e = document.querySelector('.hero-edge'); e && e.setCurrentTime && (e.pauseAnimations(), e.setCurrentTime(7)); }
  </script>
  <script is:inline>
    // suggestions as you type: the best few results of the /search/ ranking under the box. Arrow keys pick one,
    // Enter opens it; Enter without a pick (or the button) opens the full search page, as before.
    (() => {
      const q = document.getElementById('home-q'), pop = document.getElementById('home-pop'), list = document.getElementById('home-ac');
      const status = document.getElementById('home-ac-status'), all = document.getElementById('home-ac-all');
      const SHOW = 8, MIN = 3, labels = { part: 'part', spec: 'spec', release: 'release', platform: 'platform', brand: 'brand', make: 'make' };
      const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      let ready, active = -1, seq = 0, timer;
      // the index loads on the first focus, so it is usually in by the time the first word is typed
      const load = () => ready ??= (async () => {
        const [{ rankedSearch }, platforms, pagefind] = await Promise.all([import('/search-rank.js'),
          fetch('/search-platforms.json').then((r) => r.json()).catch(() => []), import('/pagefind/pagefind.js')]);
        await pagefind.options({ ranking: { termSimilarity: 9, termFrequency: 0.2, termSaturation: 1.2, pageLength: 0.5 } });
        await pagefind.init();
        return (text, stale) => rankedSearch(pagefind, text, platforms, stale);
      })();
      const open = (on) => { pop.hidden = !on; q.setAttribute('aria-expanded', String(on && list.children.length > 0)); if (!on) pick(-1); };
      const pick = (i) => {
        const items = list.children; active = i;
        for (let k = 0; k < items.length; k++) items[k].setAttribute('aria-selected', String(k === i));
        if (i >= 0) { q.setAttribute('aria-activedescendant', items[i].id); items[i].scrollIntoView({ block: 'nearest' }); } else q.removeAttribute('aria-activedescendant');
      };
      // each run has its number; a run whose number is no longer the newest stops and draws nothing, so a slow
      // search for "to" never holds up the one for "toyota" (two letters match most of the index)
      async function suggest() {
        const my = ++seq, stale = () => my !== seq;
        try { await run(stale); } catch (e) { if (!stale()) { status.textContent = 'Search failed to load: ' + (e && e.message ? e.message : e); list.innerHTML = ''; } }
      }
      async function run(stale) {
        const text = q.value.trim();
        all.href = '/search/' + (text ? '?q=' + encodeURIComponent(text) : ''); all.textContent = text ? `All results for "${text}"` : 'All results';
        if (text.length < MIN) { list.innerHTML = ''; open(false); return; }
        open(true);
        status.textContent = ready ? 'Searching...' : 'Loading the search index...';
        const search = await load();
        if (stale()) return;
        status.textContent = 'Searching...';
        const r = await search(text, stale);
        if (!r || stale()) return;
        const words = text.toLowerCase().split(/\s+/).filter((w) => w.length > 1).map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
        const re = words.length ? new RegExp('(' + words.join('|') + ')', 'ig') : null;
        list.innerHTML = r.datas.slice(0, SHOW).map((d, i) => { const t = d.meta.type || '';
          return `<li role="option" id="home-ac-${i}" aria-selected="false"><a href="${esc(d.url)}" tabindex="-1"><span class="badge">${esc(labels[t] || t)}</span>`
            + `<span class="t">${re ? esc(d.meta.title || d.url).replace(re, '<mark>$1</mark>') : esc(d.meta.title || d.url)}</span>`
            + (d.filters && d.filters.status && d.filters.status.includes('discontinued') ? ' <span class="disc" title="Discontinued"><svg class="icon" aria-hidden="true"><use href="/icons.svg#discontinued"/></svg><span class="sr-only"> discontinued</span></span>' : '')
            + (d.meta.sub ? `<span class="sub">${esc(d.meta.sub)}</span>` : '') + '</a></li>'; }).join('');
        status.textContent = r.hits.length ? `${r.hits.length} result${r.hits.length === 1 ? '' : 's'}` : 'No results';
        active = -1; open(document.activeElement === q);
      }
      q.addEventListener('focus', () => { load().catch(() => {}); if (q.value.trim() && list.children.length) open(true); });
      q.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(suggest, 150); });
      q.addEventListener('keydown', (e) => {
        const n = list.children.length;
        if (e.key === 'ArrowDown' && n) { e.preventDefault(); if (pop.hidden) open(true); pick((active + 1) % n); }
        else if (e.key === 'ArrowUp' && n) { e.preventDefault(); pick(active <= 0 ? n - 1 : active - 1); }
        else if (e.key === 'Escape' && !pop.hidden) { e.preventDefault(); open(false); }
        else if (e.key === 'Enter' && active >= 0 && !pop.hidden) { e.preventDefault(); location.href = list.children[active].querySelector('a').href; }
      });
      // a click in the list lands before the box loses focus
      pop.addEventListener('mousedown', (e) => e.preventDefault());
      q.addEventListener('blur', () => open(false));
    })();
  </script>
  <div class="stats">
    <a class="stat" href="/rc/brands/"><b>{db.brands.length}</b> brands</a>
    <a class="stat" href="/rc/platforms/"><b>{db.kits.length}</b> platforms</a>
    <a class="stat" href="/rc/releases/"><b>{db.releases.length}</b> releases</a>
    <a class="stat" href="/rc/types/"><b>{releasesByType.size}</b> car types</a>
    <a class="stat" href="/rc/makes/"><b>{new Set([...releasesByMake.keys(), ...bodiesByMake.keys()]).size}</b> car makes</a>
    <a class="stat" href="/search/?type=part"><b>{db.parts.length}</b> parts</a>
    <a class="stat" href="/rc/categories/"><b>{byCat.size}</b> part categories</a>
    <a class="stat" href="/rc/specs/"><b>{db.specs.length}</b> generic specs</a>
  </div>

  <h2>New and upcoming</h2>
  <table class="home-new">
    <tr><th class="num">Date</th><th>Release</th></tr>
    {[...coming, ...latest].map(({ group: g, head: r }) => { const k = db.kit.get(r.kit); const cat = r.category ?? k?.category; const labels = colourLabels(g); return <tr><td class="num"><DateText r={r} /><DateDoubt reason={dateDoubt(r)} /></td>
      <td><span class="muted" title={kitTypeOne[cat ?? 'car']}><ReleaseArt id={r.id} category={cat} art={r.art} color={g.length > 1 ? undefined : releaseColour(r)} size="1em" /></span> <a href={url.release(r.id)}>{brandName(r.brand)} {groupName(g)}</a><Discontinued item={r} />
        {g.length > 1 && <ColourSwitch label="Colours of this release" size="inline" items={g.map((x, i) => ({ id: x.id, number: x.number, colour: labels[i], text: x.livery, current: false, href: url.release(x.id) }))} />}
        {k && (k.placeholder ? <span class="muted relplat">chassis not yet known</span> : <span class="muted relplat">platform <a href={url.platform(r.kit)}>{k.name}</a></span>)}</td></tr>; })}
  </table>
  <p><a href="/rc/releases/">Show more</a> <span class="muted">· every release, newest first</span></p>
  <p><a href="/rc/latest/">Latest of everything</a> <span class="muted">· new cars, bodies, servos, radios, ESCs, motors, batteries and other parts</span></p>
  <DoubtNote on={[...coming, ...latest].some((x) => x.group.some((r) => !!dateDoubt(r)))} />

  <div class="home-grid">
    <section>
      <h2>Most upgraded platforms <span class="muted">· parts from other brands that fit</span></h2>
      <ul class="hbars">
        {upgraded.map(([k, n]) => { const kit = db.kit.get(k)!; const nb = upgradeBrands.get(k)!.size; return <li><a href={url.platform(k)}>{brandName(kit.brand)} {kit.name}</a>
          <span class="bar" style={`width:${(n / max(upgraded)) * 100}%`} title={`${brandName(kit.brand)} ${kit.name}: ${n} parts from ${nb} other brands`}></span><span class="v">{n}</span></li>; })}
      </ul>
    </section>
    <section>
      <h2>Releases by brand <span class="muted">· <a href="/rc/brands/">all brands</a> · <a href="/stats/">statistics</a></span></h2>
      <ul class="hbars">
        {brands.map(([b, n]) => <li><a href={url.brand(b)}>{brandName(b)}</a>
          <span class="bar" style={`width:${(n / max(brands)) * 100}%`} title={`${brandName(b)}: ${n} releases`}></span><span class="v">{n}</span></li>)}
      </ul>
    </section>
  </div>

  <p><a href="/rc/">Browse RC cars</a> · <a href="/rc/scan/">Scan a barcode</a> · <a href="/rc/compare/">Compare two releases</a> · <a href="/rc/categories/">Part categories</a> · <a href="/rc/specs/">Generic specs</a> · <a href="/rc/servos/">Compare servos</a> · <a href="/rc/escs/">Compare ESCs</a> · <a href="/rc/motors/">Compare motors</a></p>
</Base>
