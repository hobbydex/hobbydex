---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Search" description="Search Hobbydex by part number, part name, kit, release or brand, and filter by part category, drive or real vehicle make.">
  <h1>Search</h1>
  <div class="sfield"><Icon name="search" /><input class="search-box" id="q" type="search" placeholder="Part number, part name, platform or brand" autocomplete="off" autofocus /></div>
  <div class="search-filters" id="filters" role="group" aria-label="Result type">
    <button data-type="" aria-pressed="true">All</button>
    <button data-type="part" aria-pressed="false">Parts</button>
    <button data-type="spec" aria-pressed="false">Specs</button>
    <button data-type="release" aria-pressed="false">Releases</button>
    <button data-type="platform" aria-pressed="false">Platforms</button>
    <button data-type="brand" aria-pressed="false">Brands</button>
    <select id="cat" aria-label="Part category"><option value="">any category</option></select>
    <select id="drive" aria-label="Platform drive"><option value="">any drive</option></select>
    <select id="make" aria-label="Real vehicle make"><option value="">any make</option></select>
  </div>
  <div class="search-status" id="status"></div>
  <ul class="search-results" id="results"></ul>
  <div class="search-more" id="more" hidden><button id="more-btn">Show more</button></div>
  <script is:inline>
    (async () => {
      const q = document.getElementById('q'), results = document.getElementById('results'), status = document.getElementById('status');
      const more = document.getElementById('more'), moreBtn = document.getElementById('more-btn'), filters = document.getElementById('filters');
      let pagefind;
      // show the query and that we are working at once; the index takes a moment to load
      const params = new URLSearchParams(location.search);
      if (params.get('q')) q.value = params.get('q');
      // listing every part (130,000+) without a query takes a long time: ask for a query instead
      const browseAll = (t, c) => t === 'part' && !c;
      if (params.get('q') || params.get('category') || (params.get('type') && !browseAll(params.get('type'), params.get('category')))) status.textContent = 'Searching...';
      const [{ rankedSearch }, platforms] = await Promise.all([import('/search-rank.js'),   // shared with tests/search.test.mjs
        fetch('/search-platforms.json').then((r) => r.json()).catch(() => [])]);
      try {
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.options({ ranking: { termSimilarity: 9, termFrequency: 0.2, termSaturation: 1.2, pageLength: 0.5 } });
        await pagefind.init();
      } catch (e) {
        status.textContent = 'Search index failed to load: ' + (e && e.message ? e.message : e);
        return;
      }
      let type = '', cat = '', drive = '', make = '', hits = [], shown = 0, listed = new Set();
      const catSel = document.getElementById('cat'), driveSel = document.getElementById('drive'), makeSel = document.getElementById('make');
      const DRIVES = ['2WD', '4WD', 'FWD', '6WD', '8WD', 'Tracks'];
      // the filter lists (a few hundred KB) load after the first search, not before it
      async function loadFilters() {
        try {
          const f = await pagefind.filters();
          const fill = (sel, counts, order) => {
            for (const [name, n] of Object.entries(counts || {}).sort(order)) {
              const o = document.createElement('option'); o.value = name; o.textContent = `${name} (${n})`; sel.appendChild(o);
            }
          };
          fill(catSel, f.category, (a, b) => a[0].localeCompare(b[0]));
          fill(driveSel, f.drive, (a, b) => (DRIVES.indexOf(a[0]) + 1 || 99) - (DRIVES.indexOf(b[0]) + 1 || 99));
          fill(makeSel, f.make, (a, b) => a[0].localeCompare(b[0]));   // real vehicle makes a release or body shell replicates
          catSel.value = cat; driveSel.value = drive; makeSel.value = make;
        } catch (e) {}
      }
      const filt = () => { const f = {}; if (type) f.type = type; if (cat) { f.category = cat; f.type = 'part'; } if (drive) { f.drive = drive; f.type = 'platform'; } if (make) f.make = make; return f; };
      const PAGE = 20;
      const labels = { part: 'part', spec: 'spec', release: 'release', platform: 'platform', brand: 'brand' };
      // the same mark as Discontinued.astro, after the title of a discontinued part or release
      const DISC = '<span class="disc" title="Discontinued"><svg class="icon" aria-hidden="true"><use href="/icons.svg#discontinued"/></svg><span class="sr-only"> discontinued</span></span>';
      const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const mark = (text, terms) => {
        let out = esc(text);
        for (const t of terms) if (t.length > 1) out = out.replace(new RegExp('(' + t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig'), '<mark>$1</mark>');
        return out;
      };
      async function render() {
        const terms = q.value.trim().split(/\s+/).filter(Boolean);
        const batch = hits.slice(shown, shown + PAGE);
        const data = await Promise.all(batch.map((h) => h.data()));
        for (const d of data) {
          if (listed.has(d.url)) continue;   // a platform matched by title can come again in pagefind's tail
          listed.add(d.url);
          const li = document.createElement('li');
          const t = d.meta.type || '';
          const disc = d.filters && d.filters.status && d.filters.status.includes('discontinued') ? ' ' + DISC : '';
          li.innerHTML = `<span class="badge">${esc(labels[t] || t)}</span><a href="${esc(d.url)}">${mark(d.meta.title || d.url, terms)}</a>${disc}` + (d.meta.sub ? `<span class="sub">${esc(d.meta.sub)}</span>` : '');
          results.appendChild(li);
        }
        shown += batch.length;
        more.hidden = shown >= hits.length;
      }
      // one search at a time: pagefind's worker runs them in turn, so typing would queue up a search per
      // keystroke; a query typed meanwhile runs when the current one ends, and only the newest one
      let running = false, again = false;
      async function search() {
        if (running) { again = true; return; }
        running = true;
        try { await runSearch(); } finally { running = false; }
        if (again) { again = false; search(); }
      }
      async function runSearch() {
        const text = q.value.trim(), stale = () => again;   // a newer query is waiting
        const qs = new URLSearchParams(); if (text) qs.set('q', text); if (type) qs.set('type', type); if (cat) qs.set('category', cat); if (drive) qs.set('drive', drive); if (make) qs.set('make', make);
        history.replaceState(null, '', qs.toString() ? `?${qs}` : location.pathname);
        const clear = () => { results.innerHTML = ''; shown = 0; more.hidden = true; hits = []; listed = new Set(); };
        if (!text && !type && !cat && !drive && !make) { clear(); status.textContent = ''; return; }
        if (!text && !make && browseAll(type, cat)) { clear(); status.textContent = 'Type a part number or name to search the parts, or pick a category.'; q.focus(); return; }
        status.textContent = 'Searching...';
        let found;
        try {
          // a plain query: re-ranked (see search-rank.js); with a filter, pagefind's order;
          // an empty query with a type selected lists every page of that type, by title
          found = text && !type && !cat && !drive && !make ? (await rankedSearch(pagefind, text, platforms, stale))?.hits
            : (text ? await pagefind.search(text, { filters: filt() }) : await pagefind.search(null, { filters: filt(), sort: { title: 'asc' } })).results;
        }
        catch (e) { status.textContent = 'Search failed: ' + (e && e.message ? e.message : e); return; }
        if (!found || stale()) return;
        // the old results stay until the new ones are in
        clear(); hits = found;
        status.textContent = hits.length ? `${hits.length} ${text ? 'result' : labels[type || (drive ? 'platform' : '')] || 'page'}${hits.length === 1 ? '' : 's'}` : 'No results';
        await render();
      }
      // a search starts once typing pauses: one started mid-word cannot be stopped and delays the next
      let timer; q.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(search, 250); });
      moreBtn.addEventListener('click', render);
      filters.addEventListener('click', (e) => {
        const b = e.target.closest('button'); if (!b) return;
        type = b.dataset.type;
        for (const x of filters.querySelectorAll('button')) x.setAttribute('aria-pressed', String(x === b));
        search();
      });
      catSel.addEventListener('change', () => { cat = catSel.value; if (cat) { drive = ''; driveSel.value = ''; } search(); });
      driveSel.addEventListener('change', () => { drive = driveSel.value; if (drive) { cat = ''; catSel.value = ''; make = ''; makeSel.value = ''; } search(); });
      makeSel.addEventListener('change', () => { make = makeSel.value; if (make) { drive = ''; driveSel.value = ''; } search(); });
      if (params.get('category')) { cat = params.get('category'); catSel.value = cat; }
      if (params.get('drive')) { drive = params.get('drive'); driveSel.value = drive; }
      if (params.get('make')) { make = params.get('make'); makeSel.value = make; }
      // ?type=kit: links from before kits were called platforms
      if (params.get('type')) { type = params.get('type') === 'kit' ? 'platform' : params.get('type'); for (const x of filters.querySelectorAll('button')) x.setAttribute('aria-pressed', String(x.dataset.type === type)); }
      // a query typed while the index loaded counts too
      if (q.value.trim() || cat || drive || make || type) await search();
      loadFilters();
    })();
  </script>
</Base>
