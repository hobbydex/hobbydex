---
import Base from '../../../layouts/Base.astro';
import { db, key, url } from '../../../lib/data';
import { catName } from '../../../lib/categories';
import Icon from '../../../components/Icon.astro';
import ReleaseArt from '../../../components/ReleaseArt.astro';
import { kitTypeIcon, kitTypeOne, kitTypeLabel, kitTypeOrder } from '../../../lib/kitTypes';
import { byCategory, categories } from '../../../lib/categoryIndex';
export function getStaticPaths() {
  return db.brands.map((b) => ({ params: { brand: key(b.id)[0] }, props: { brand: b } }));
}
const { brand } = Astro.props;
const kits = db.kitsByBrand.get(brand.id) ?? [];
const parts = db.partsByBrand.get(brand.id) ?? [];
// many kits: one table per kit type, with the years the kit's releases span
const MANY = 12;
const kitRows = kits.map((k) => {
  const rs = db.releasesByKit.get(k.id) ?? [];
  const ys = rs.map((r) => r.year).filter((y): y is number => !!y);
  return { k, n: rs.length, from: ys.length ? Math.min(...ys) : undefined, to: ys.length ? Math.max(...ys) : undefined };
});
const kitGroups = kitTypeOrder.concat([...new Set(kits.map((k) => k.category ?? 'car'))].filter((c) => !kitTypeOrder.includes(c)))
  .map((t) => [t, kitRows.filter((r) => (r.k.category ?? 'car') === t).sort((a, b) => a.k.name.localeCompare(b.k.name, undefined, { numeric: true }))] as const)
  .filter(([, rs]) => rs.length > 0);
const years = (r: { from?: number; to?: number }) => (r.from === undefined ? '' : r.from === r.to ? `${r.from}` : `${r.from}-${r.to}`);
const cats = categories.map((c) => [c, byCategory.get(c)!.get(brand.id)?.length ?? 0] as const).filter(([, n]) => n > 0);
---
<Base title={brand.name} description={`${brand.name}: kits and parts in Hobbydex.`} kind="brand">
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / {brand.name}</div>
  <h1 data-pagefind-meta="title" data-pagefind-weight="10" data-pagefind-sort="title">{brand.name}</h1>
  <dl class="facts">
    {brand.legal_name && <><dt>Legal name</dt><dd>{brand.legal_name}</dd></>}
    {brand.country && <><dt>Country</dt><dd>{brand.country}</dd></>}
    {brand.website && <><dt>Website</dt><dd><a href={brand.website} rel="nofollow">{brand.website}</a></dd></>}
    <dt>Status</dt><dd>{brand.status}</dd>
  </dl>
  {brand.notes && <p class="muted">{brand.notes}</p>}
  {kits.length > MANY && <><h2>Kits <span class="muted">({kits.length})</span></h2>
  <div class="kitfilter" data-pagefind-ignore>
    <input type="search" class="search-box" placeholder={`Filter ${brand.name} kits by name, scale or drive`} aria-label="Filter kits" autocomplete="off" />
    <p class="muted">By type: {kitGroups.map(([t, rs], i) => <>{i > 0 && ' · '}<a href={`#type-${t}`}><Icon name={kitTypeIcon(t)} /> {kitTypeLabel[t] ?? t}</a> <span class="muted">{rs.length}</span></>)}</p>
  </div>
  {kitGroups.map(([t, rs]) => <section class="kitgroup" id={`type-${t}`}>
    <h3><Icon name={kitTypeIcon(t)} size="1.5rem" /> <a href={`/rc/kits/types/${t}/`}>{kitTypeLabel[t] ?? t}</a> <span class="muted">({rs.length})</span></h3>
    <table class="kits">
      <thead><tr><th>Kit</th><th>Scale</th><th>Drive</th><th>Power</th><th class="num">Releases</th><th>Years</th></tr></thead>
      <tbody>{rs.map((r) => <tr data-q={[r.k.name, r.k.scale, r.k.drive, r.k.power, kitTypeOne[t] ?? t].filter(Boolean).join(' ').toLowerCase()}>
        <td><a href={url.kit(r.k.id)}>{r.k.name}</a></td><td>{r.k.scale}</td><td>{r.k.drive}</td><td>{r.k.power}</td><td class="num">{r.n || ''}</td><td>{years(r)}</td></tr>)}</tbody>
    </table>
  </section>)}
  <script>
    for (const box of document.querySelectorAll<HTMLElement>('.kitfilter')) {
      const input = box.querySelector('input')!;
      input.addEventListener('input', () => {
        const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
        for (const g of document.querySelectorAll<HTMLElement>('.kitgroup')) {
          let shown = 0;
          for (const tr of g.querySelectorAll<HTMLElement>('tbody tr')) { const ok = terms.every((w) => (tr.dataset.q ?? '').includes(w)); tr.hidden = !ok; if (ok) shown++; }
          g.hidden = shown === 0;
        }
      });
    }
  </script></>}
  {kits.length > 0 && kits.length <= MANY && <><h2>Kits</h2>
  <ul class="cards">{kits.map((k) => <li class="kitcard"><a href={`/rc/kits/types/${k.category || 'car'}/`} title={kitTypeOne[k.category ?? 'car'] ?? k.category}>{k.art ? <ReleaseArt id={k.id} category={k.category} kitArt={k.art} size="2rem" /> : <Icon name={kitTypeIcon(k.category)} size="2rem" />}</a><span><a href={url.kit(k.id)}><b>{k.name}</b></a><br /><span class="muted">{[k.scale, kitTypeOne[k.category ?? 'car'] ?? k.category, k.drive, k.power].filter(Boolean).join(' · ')}</span></span></li>)}</ul></>}
  <h2>Parts <span class="muted">({parts.length})</span></h2>
  {cats.length > 0 && <p data-pagefind-ignore class="bycat">By category: {cats.map(([c, n], i) => <>{i > 0 && ' · '}<a href={`/rc/categories/${c}/${key(brand.id)[0]}/`}><Icon name={c} /> {catName(c)}</a> <span class="muted">{n}</span></>)}</p>}
  {parts.length > 0 && <div class="brandsearch" data-pagefind-ignore data-src={`/rc/brands/${key(brand.id)[0]}/parts.json`} data-base={`/rc/parts/${key(brand.id)[0]}/`} data-cats={JSON.stringify(Object.fromEntries(cats.map(([c]) => [c, catName(c)])))}>
    <input type="search" class="search-box" placeholder={`Find a ${brand.name} part by number or name`} aria-label="Find a part" autocomplete="off" />
    <p class="muted status"></p>
    <table class="results" hidden><thead><tr><th>Number</th><th>Name</th><th>Category</th></tr></thead><tbody></tbody></table>
  </div>}
  <script>
    const MAX = 30;
    for (const box of document.querySelectorAll<HTMLElement>('.brandsearch')) {
      const input = box.querySelector('input')!, table = box.querySelector('table')!, list = table.tBodies[0], status = box.querySelector<HTMLElement>('.status')!;
      const cats: Record<string, string> = JSON.parse(box.dataset.cats ?? '{}');
      let rows: [string, string, string][] | null = null, loading: Promise<void> | null = null;
      const load = () => (loading ??= fetch(box.dataset.src!).then((r) => r.json()).then((d) => { rows = d; }));
      const href = (n: string) => box.dataset.base + n.split('/').map(encodeURIComponent).join('/') + '/';
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
      const show = async () => {
        await load();
        const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
        list.replaceChildren(); table.hidden = true;
        if (!terms.length) { status.textContent = `${rows!.length} parts: type a number or a few words of the name.`; return; }
        // number prefix matches first, then everything else that has every term
        const hits = rows!.filter(([n, name]) => { const t = `${n} ${name}`.toLowerCase(); return terms.every((w) => t.includes(w)); })
          .sort((a, b) => Number(!a[0].toLowerCase().startsWith(terms[0])) - Number(!b[0].toLowerCase().startsWith(terms[0])) || a[0].localeCompare(b[0], undefined, { numeric: true }));
        status.textContent = hits.length > MAX ? `${hits.length} matches, showing the first ${MAX}: keep typing to narrow down.` : `${hits.length} match${hits.length === 1 ? '' : 'es'}.`;
        for (const [n, name, cat] of hits.slice(0, MAX)) {
          const tr = document.createElement('tr');
          tr.innerHTML = `<td class="num"><a href="${esc(href(n))}">${esc(n)}</a></td><td>${esc(name)}</td><td class="muted">`
            + (cat ? `<svg class="icon" aria-hidden="true"><use href="/icons.svg#${esc(cat)}"/></svg> ${esc(cats[cat] ?? cat)}` : '') + '</td>';
          list.appendChild(tr);
        }
        table.hidden = hits.length === 0;
      };
      input.addEventListener('focus', () => { load().then(show); }, { once: true });
      input.addEventListener('input', show);
      input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const a = list.querySelector('a'); if (a) location.href = a.href; } });
    }
  </script>
</Base>
