---
import Standards from '../../../../components/Standards.astro';
import { shownNote, isSourceNote } from '../../../../lib/notes';
import SourceNote from '../../../../components/SourceNote.astro';
import FactSource from '../../../../components/FactSource.astro';
import DateText from '../../../../components/DateText.astro';
import DateDoubt from '../../../../components/DateDoubt.astro';
import DoubtNote from '../../../../components/DoubtNote.astro';
import { gtinLabel } from '../../../../lib/gtin';
import WebSearch from '../../../../components/WebSearch.astro';
import Videos from '../../../../components/Videos.astro';
import FanLinks from '../../../../components/FanLinks.astro';
import CopyButton from '../../../../components/CopyButton.astro';
import { similarServos, servoRow, shortName } from '../../../../lib/servos';
import Base from '../../../../layouts/Base.astro';
import Discontinued from '../../../../components/Discontinued.astro';
import { db, key, url, brandName, partLabel, byReleaseDate, dateDoubt, brandGone, docPage, dateSource, heatsinksByCan, canDiameter, type Fits , yearDoubt } from '../../../../lib/data';
import { catName } from '../../../../lib/categories';
import Icon from '../../../../components/Icon.astro';
import ReleaseArt from '../../../../components/ReleaseArt.astro';
import DataLink from '../../../../components/DataLink.astro';
import { paintSwatch, paintChip } from '../../../../lib/paintSwatch';
import { colourDot } from '../../../../lib/colourDot';
import { partDrawing } from '../../../../lib/specDrawings';
import { radioUnitLabel, figureLabel } from '../../../../lib/radio';
import { fileRows, makerOwnLinks, listedBelow } from '../../../../lib/docFacts';
export function getStaticPaths() {
  // a former id (renamed or corrected) or another number the part is sold under (numbers) keeps working:
  // its page redirects to the current one; a number listed twice is one route
  const taken = new Set(db.parts.map((p) => p.id));
  const moved = db.parts.flatMap((x) => [...(x.former_ids ?? []), ...(x.numbers ?? []).map((n) => `part/${key(x.brand)[0]}/${n}`)]
    .map((f) => ({ f, to: x.id }))).filter(({ f }) => !taken.has(f) && taken.add(f))
    .map(({ f, to }) => ({ params: { brand: key(f)[0], number: key(f)[1] }, props: { redirect: url.part(to) } }));
  return [...db.parts.map((p) => ({ params: { brand: key(p.id)[0], number: key(p.id)[1] }, props: { part: p } })), ...moved];
}
if (Astro.props.redirect) return Astro.redirect(Astro.props.redirect, 301);
const part = Astro.props.part!;   // set on every page that is not a redirect
const brand = db.brand.get(part.brand);
const uses = [...(db.usesByPart.get(part.id) ?? [])].sort((a, b) => byReleaseDate(a.release, b.release));
// every kit this part belongs to: through a release's contents or the brand's fitment lists
const kitMap = new Map<string, { roles: Set<string>; releases: number; fits: Fits[] }>();
for (const u of uses) {
  const k = kitMap.get(u.release.kit) ?? { roles: new Set<string>(), releases: 0, fits: [] };
  k.roles.add(u.role === 'kit' ? 'in the box' : u.role); k.releases++; kitMap.set(u.release.kit, k);
}
for (const f of part.fits ?? []) {
  const k = kitMap.get(f.kit) ?? { roles: new Set<string>(), releases: 0, fits: [] };
  k.fits.push(f); kitMap.set(f.kit, k);
}
// the date's source: the month page of a catalogue of new items, when one dates this part
const dated = dateSource(part);
const kitsOf = [...kitMap.entries()].map(([id, v]) => ({ id, kit: db.kit.get(id), ...v })).sort((a, b) => (a.kit?.name ?? a.id).localeCompare(b.kit?.name ?? b.id));
const replacedBy = db.replacedBy.get(part.id) ?? [];
const replaces = part.supersedes ? db.part.get(part.supersedes) : undefined;
const upgradeFor = [...new Set((part.fits ?? []).map((f) => f.replaces).filter((x): x is string => !!x))].map((id) => db.part.get(id)).filter((x): x is NonNullable<typeof x> => !!x);
const upgrades = db.upgradesFor.get(part.id) ?? [];
const rebrandOf = (part.rebrand_of ?? []).map((r) => db.part.get(r.part)).filter((x): x is NonNullable<typeof x> => !!x);
const soldAs = db.rebrandsOf.get(part.id) ?? [];
// part-to-part links from names, both ways: "requires TKR5150" here, "Required by" there
const FWD: Record<string, string> = { requires: 'Requires', fits: 'Fits', 'use-with': 'Use with', for: 'Made for', replaces: 'Replaces', 'same-colour': 'Same colour' };
const BACK: Record<string, string> = { requires: 'Required by', fits: 'Fitted with', 'use-with': 'Used with', for: 'Accessories', replaces: 'Replaced by', 'same-colour': 'Same colour' };
const relRows = [...(part.related ?? []).map((r) => ({ label: FWD[r.relation] ?? r.relation, p: db.part.get(r.part) })),
  ...(db.relatedTo.get(part.id) ?? []).map((r) => ({ label: BACK[r.relation] ?? r.relation, p: r.part }))].filter((r) => r.p)
  .filter((r, i, all) => all.findIndex((o) => o.label === r.label && o.p!.id === r.p!.id) === i);   // same-colour is recorded on both paints
const relGroups = [...new Set(relRows.map((r) => r.label))].map((label) => ({ label, parts: relRows.filter((r) => r.label === label).map((r) => r.p!) }));
const similar = part.category === 'servo' ? similarServos(part.id) : [];
// the other versions of a range (winds, kV), lowest first
const rating = (o: typeof part) => o.turns ?? (o.kv ? -o.kv : 0);
const range = part.range ? (db.partsByRange.get(part.range) ?? []).filter((o) => o.id !== part.id).sort((a, b) => rating(b) - rating(a)) : [];
const swatch = paintSwatch(part, 'large');
// a nitro or gas engine: class, displacement, bore x stroke, fuel
const engine = part.category === 'engine-fuel' ? [part.engine_class && `${part.engine_class} class`, part.displacement_cc && `${part.displacement_cc} cc`,
  part.bore_mm && part.stroke_mm ? `bore x stroke ${part.bore_mm} x ${part.stroke_mm} mm` : part.bore_mm && `bore ${part.bore_mm} mm`, part.fuel].filter(Boolean).join(', ') : '';
const chip = paintChip(part, 120);
const isWheel = part.category === 'tire' || part.category === 'wheel';
// the wheel facts in one line, the colours with their dot
const wheelFacts = [part.wheel_size && `${part.wheel_size} rim`, part.compound && `${part.compound} compound`, part.mounting && ({ 'pre-mounted': 'pre-mounted on wheels', 'pre-mounted-not-glued': 'mounted on wheels, not glued', 'wheels-included': 'wheels included, to be mounted', unmounted: 'tires only, no wheels' } as Record<string, string>)[part.mounting],
  part.wheel_color && { dot: colourDot(part.wheel_color), text: `${part.wheel_color} wheels` }, part.color && { dot: colourDot(part.color), text: part.color },
  part.offset_mm !== undefined && `offset ${part.offset_mm > 0 ? '+' : ''}${part.offset_mm} mm`, part.beadlock && 'beadlock'].filter((x): x is string | { dot: string; text: string } => !!x);
const drawing = partDrawing(part);
const drawStd = drawing?.standard ? db.standardByCode.get(drawing.standard) : undefined;
// a part of a brand that prints no item numbers has none: the name is its title, there is no number to copy
const numName = part.number ? `${part.number} ${part.name}` : part.name;
// unloaded speed of a brushless motor: kV x nominal LiPo voltage, for the cells the maker states (else 2S and 3S)
const noLoad = (kv: number, cells?: number[]) => {
  const [lo, hi] = cells?.length === 2 ? cells : [2, 3];
  const list = [];
  for (let c = lo; c <= Math.min(hi, lo + 5); c++) { const v = Math.round(c * 3.7 * 10) / 10; list.push([c, v, Math.round((kv * v) / 100) * 100] as [number, number, number]); }
  return list;
};
// a motor: the clamp-on heat sinks and fan mounts for its can, any brand; a heat sink: the can it takes
const motorCan = part.category === 'motor' ? canDiameter(part) : undefined;
const sinks = motorCan ? (heatsinksByCan.get(motorCan) ?? []) : [];
// the maker's pages for the part's manual, parts list and exploded view, as on a release; its own links (not fan sites)
const partFiles = fileRows((part.documents ?? []).map((id) => db.doc.get(id)).filter((d) => d !== undefined));
const partLinks = makerOwnLinks(part.links);
import SeenNote from '../../../../components/SeenNote.astro';
import RealVehicle from '../../../../components/RealVehicle.astro';
---
<Base title={numName} description={`${brand?.name} ${numName}: which platforms use it.`} kind="part" sub={brand?.name}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href={url.brand(part.brand)}>{brandName(part.brand)}</a>{brandGone(part.brand) && <span class="muted"> (brand defunct)</span>} / {partLabel(part)}</div>
  {part.category && <span hidden data-pagefind-filter={`category:${catName(part.category)}`} />}
  <h1><span data-pagefind-meta="title" data-pagefind-weight="10" data-pagefind-sort="title">{part.number && <>{part.number} <span class="muted">·</span> </>}{part.name}</span>{part.status === 'discontinued' && <span hidden data-pagefind-filter="status:discontinued" />}<Discontinued item={part} />{part.status === 'discontinued' && replacedBy.length > 0 && <span class="muted replaced"> replaced by {replacedBy.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{partLabel(r)}</a></>)}</span>}</h1>
  {part.sources?.name && <p><FactSource field="name" url={part.sources.name} dot={false} /></p>}
  {(part as { name_source?: string }).name_source === 'ocr' && <p class="muted ocrname" data-pagefind-ignore>This name was read by OCR from a scanned manual and is not checked yet; it may contain reading errors.</p>}
  <WebSearch query={`"${part.number ?? part.name}" ${brand?.name ?? ''}`.trim()} copy={part.number} links={part.links} />
  <div class="factsrow">
  <dl class="facts">
    <dt>Brand</dt><dd><a href={url.brand(part.brand)}>{brandName(part.brand)}</a></dd>
    {part.depicts && <><dt>Real vehicle</dt><dd><RealVehicle depicts={part.depicts!} /><span hidden data-pagefind-filter={part.depicts.make ? `make:${part.depicts.make}` : undefined} /></dd></>}
    {part.number && <><dt>Part number</dt><dd>{part.number}{(part.numbers ?? []).length > 0 && <> <span class="muted">, also sold as</span> {(part.numbers ?? []).map((n, i) => <>{i > 0 && ','} {n} <CopyButton text={n} label={`Copy ${n}`} class="btn" /></>)}</>}</dd></>}
    {part.category && <><dt>Category</dt><dd><a href={`/rc/categories/${part.category}/`}>{catName(part.category)}</a> <span class="muted">· <a href={`/rc/categories/${part.category}/${key(part.brand)[0]}/`}>more from {brandName(part.brand)}</a></span>{part.sources?.category && <FactSource field="category" url={part.sources.category} />}</dd></>}
    {partLinks.length > 0 && <><dt>Product page</dt><dd>{partLinks.map((l, i, a) => <>{i > 0 && ' · '}<a href={l.url} rel="nofollow noopener" target="_blank">{a.length > 1 ? l.site : 'manufacturer website'}</a></>)}</dd></>}
    {partFiles.map(([label, ds]) => <><dt>{label}</dt><dd>{ds.map((d, i) => <>{i > 0 && ' · '}<a href={d.page} rel="nofollow">{ds.length > 1 ? d.title.replace(/^.*?: /, '') : 'manufacturer website'}</a></>)}</dd></>)}
    {part.released && <><dt>Released</dt><dd><DateText r={part} /><DateDoubt reason={dateDoubt(part)} />{dated && <span class="muted"> · listed in <a href={dated.href} rel="nofollow">{dated.doc.title.replace(/:.*$/, '')}</a></span>}</dd></>}
    {replaces && <><dt>Replaces</dt><dd><a href={url.part(replaces.id)}>{partLabel(replaces)}</a> {replaces.number && replaces.name}<Discontinued item={replaces} /></dd></>}
    {rebrandOf.length > 0 && <><dt>Rebrand of</dt><dd>{rebrandOf.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{brandName(r.brand)} {partLabel(r)}</a> {r.number && r.name}<Discontinued item={r} /></>)}</dd></>}
    {relGroups.map((g) => <><dt>{g.label}</dt><dd>{g.parts.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{partLabel(r)}</a> {r.number && r.name}<Discontinued item={r} /></>)}</dd></>)}
    {soldAs.length > 0 && <><dt>Also sold as</dt><dd>{soldAs.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{brandName(r.brand)} {partLabel(r)}</a> {r.number && r.name}<Discontinued item={r} /></>)}</dd></>}
    {upgradeFor.length > 0 && <><dt>Upgrade for</dt><dd>{upgradeFor.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{partLabel(r)}</a> {r.number && r.name}<Discontinued item={r} /></>)}</dd></>}
    {replacedBy.length > 0 && <><dt>Replaced by</dt><dd>{replacedBy.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{partLabel(r)}</a> {r.number && r.name}<Discontinued item={r} /></>)}</dd></>}
    {part.pack_qty && <><dt>Pack</dt><dd>{part.pack_qty} pcs</dd></>}
    {part.gtin && <><dt>{gtinLabel(part.gtin)}</dt><dd><Icon name="barcode" /> {part.gtin}</dd></>}
    {part.former_names && part.former_names.length > 0 && <><dt>Formerly listed as</dt><dd>{part.former_names.join('; ')}</dd></>}
    {part.material && <><dt>Material</dt><dd>{part.material === 'carbon' ? 'carbon fibre' : part.material}{part.material_grade && ` ${part.material_grade}`}{part.strength_class && ` ${part.strength_class}`}{part.finish && `, ${part.finish}`}</dd></>}
    {part.thread_type && <><dt>Thread</dt><dd>{part.thread_type}</dd></>}
    {part.seal && <><dt>Seal</dt><dd>{({ open: 'open', metal: 'metal shields (ZZ)', rubber: 'rubber seals (2RS)', 'rubber-metal': 'rubber and metal' } as Record<string, string>)[part.seal] ?? part.seal}</dd></>}
    {part.lubricant && <><dt>Lubricant</dt><dd>{part.lubricant}</dd></>}
    {part.category === 'paint' && (part.paint_type || part.finish) && <><dt>Paint</dt><dd>{[part.paint_type, part.finish?.replace(/-/g, ' ')].filter(Boolean).join(', ')}</dd></>}
    {part.category === 'paint' && part.application && <><dt>Apply with</dt><dd>{[part.application].flat().map((a) => ({ 'spray-can': 'spray can', marker: 'paint pen' } as Record<string, string>)[a] ?? a).join(' or ')}</dd></>}
    {part.category === 'paint' && (swatch || part.color) && <><dt>Colour</dt><dd class="paintcolour">{chip && <span set:html={chip} />}{swatch && <span set:html={swatch} />}{part.color}{swatch && <span class="muted"> · approximate colour, sampled from {brandName(part.brand)}'s colour chart; screens show colours differently</span>}</dd></>}
    {part.viscosity_wt && <><dt>Viscosity</dt><dd>{part.viscosity_wt} wt <span class="muted">(the brand's own scale)</span></dd></>}
    {part.volume_ml && <><dt>Volume</dt><dd>{part.pack_qty && part.pack_qty > 1 ? `${part.pack_qty} x ${part.volume_ml} ml` : `${part.volume_ml} ml`}</dd></>}
    {isWheel && wheelFacts.length > 0 && <><dt>{part.category === 'tire' ? 'Tire' : 'Wheel'}</dt><dd>{wheelFacts.map((f, i) => <>{i > 0 && ', '}{typeof f === 'string' ? f : <><Fragment set:html={f.dot} />{f.text}</>}</>)}</dd></>}
    {!isWheel && part.category !== 'paint' && part.color && <><dt>Colour</dt><dd><Fragment set:html={colourDot(part.color)} />{part.color}</dd></>}
    {part.teeth && part.category === 'spur-gear' && <><dt>Gear</dt><dd>{part.teeth}T{part.pitch_dp ? `, ${part.pitch_dp} pitch` : part.module ? `, module ${part.module}` : ''}</dd></>}
    {part.bore_mm && !engine && <><dt>Bore</dt><dd>{part.bore_mm} mm</dd></>}
    {engine && <><dt>Engine</dt><dd>{engine}</dd></>}
    {part.output_hp && <><dt>Output</dt><dd>{part.output_hp} hp{part.output_rpm && ` at ${part.output_rpm.toLocaleString('en')} rpm`}</dd></>}
    {part.rpm_range && <><dt>Practical rpm</dt><dd>{part.rpm_range.map((r) => r.toLocaleString('en')).join(' - ')} rpm</dd></>}
    {part.capacity_mah && <><dt>Battery</dt><dd>{part.chemistry?.toUpperCase()} {part.cells}S {part.capacity_mah} mAh{part.c_rating && ` ${part.c_rating}C`}{part.case && `, ${part.case} case`}</dd></>}
    {part.radio_unit && <><dt>Radio</dt><dd>{radioUnitLabel[part.radio_unit] ?? part.radio_unit}</dd></>}
    {part.dimensions_mm && <><dt>{figureLabel(part, 'size')}</dt><dd>{part.dimensions_mm.join(' x ')} mm</dd></>}
    {part.weight_g && <><dt>{figureLabel(part, 'weight')}</dt><dd>{part.weight_g} g</dd></>}
    {part.connector && <><dt>Plug</dt><dd>{part.connector}</dd></>}
    {(part.kv || part.turns) && <><dt>Motor</dt><dd title="kV: rpm per volt without load. T: turns of wire per pole, fewer is faster.">{[part.kv && `${part.kv} kV`, part.turns && `${part.turns}T`, part.diameter_mm && part.length_mm && `${part.diameter_mm} x ${part.length_mm} mm`, part.shaft_mm && `${part.shaft_mm} mm shaft`].filter(Boolean).join(', ')}</dd></>}
    {part.kv && part.category === 'motor' && <><dt>No-load rpm</dt><dd title="kV x nominal LiPo voltage (3.7 V per cell), without load; under load a motor turns slower.">{noLoad(part.kv, part.lipo_cells).map(([c, v, r]) => `${c}S (${v} V): about ${r.toLocaleString('en-US')} rpm`).join(' · ')}</dd></>}
    {part.motor_can_mm && <><dt>Motor can</dt><dd>{part.motor_can_mm} mm diameter <span class="muted">(clamps on a motor of this size)</span></dd></>}
    {part.mount_holes?.length && <><dt>Mounting holes</dt><dd>{part.mount_holes.map((h) => h.count ? `${h.count} x ${h.thread} on a ${h.circle_mm} mm bolt circle` : `${h.thread} on a ${h.circle_mm} mm bolt circle (number of holes not stated)`).join(', ')}</dd></>}
    {part.sensored !== undefined && <><dt>{part.category === 'motor' ? 'Sensors' : 'Sensor port'}</dt><dd>{part.category === 'motor' ? (part.sensored ? 'sensored' : 'sensorless') : (part.sensored ? 'yes, runs sensored motors' : 'no, sensorless motors only')}</dd></>}
    {part.current_a && <><dt>ESC</dt><dd>{part.current_a} A{part.peak_current_a && ` (${part.peak_current_a} A peak)`}</dd></>}
    {part.lipo_cells && <><dt>LiPo</dt><dd>{part.lipo_cells[0] === part.lipo_cells[1] ? `${part.lipo_cells[0]}S` : `${part.lipo_cells[0]}-${part.lipo_cells[1]}S`}</dd></>}
    {part.torque_kgcm && <><dt>Servo</dt><dd>{part.torque_kgcm} kg/cm{part.speed_s && `, ${part.speed_s} s/60°`}{part.voltage && ` at ${part.voltage} V`}{part.motor && `, ${part.motor}`}{part.gear_material && `, ${part.gear_material} gears`}</dd></>}
    {(part.bearings || part.bearing_kind) && <><dt>Bearings</dt><dd>{`${part.bearings ?? ''}${part.bearing_kind ? ` ${part.bearing_kind}` : ''} bearings`.trim()}</dd></>}
    {part.dead_band_us && <><dt>Dead band</dt><dd>{part.dead_band_us} µs</dd></>}
    {part.frequency_hz && <><dt>PWM frequency</dt><dd>{Array.isArray(part.frequency_hz) ? `${part.frequency_hz[0]} to ${part.frequency_hz[1]} Hz` : `${part.frequency_hz} Hz`}</dd></>}
    {part.channels && <><dt>Channels</dt><dd>{part.channels}</dd></>}
    {part.protocol && <><dt>Protocol</dt><dd>{part.protocol}</dd></>}
    {part.notes && <><dt>Notes</dt><dd>{part.notes}</dd></>}
    {part.applies_to && <><dt>Listed for</dt><dd>{part.applies_to}</dd></>}
  </dl>
  {part.art && <span class="typeicon"><ReleaseArt id={part.id} category={part.category} color={part.color} art={part.art} size="12rem" class="hero" /></span>}
  </div>
  <DoubtNote on={!!dateDoubt(part)} />
  <FanLinks links={part.links} />
  {drawing && <figure class="drawing" data-pagefind-ignore>
    <Fragment set:html={drawing.svg} />
    <figcaption class="muted">{drawing.spec ? <>{part.category === 'nut' && drawing.approximate ? 'Drawn' : 'To scale'}, from the generic size <a href={url.spec(drawing.spec.id)}>{drawing.spec.name}</a>{part.category === 'bearing' && part.seal && part.seal !== 'open' && ', with the shields or seals this part lists'}{part.category === 'screw' && (drawStd ? <>; head and socket sizes from <a href={url.standard(drawStd.id)}>{drawStd.code}</a></> : '; head proportions as usual for this type')}.</>
      : drawing.approximate ? 'Not to scale: the pitch of this gear is not in our data, so only its tooth count is drawn.' : 'To scale, from the tooth count and the pitch.'}{drawing.note && ` ${drawing.note}.`}</figcaption>
  </figure>}
  {upgrades.length > 0 && <>
    <h2>Upgrades for this part <span class="muted">({upgrades.length})</span></h2>
    <table>
      <tr><th class="num">Number</th><th>Name</th><th>Material</th></tr>
      {upgrades.map((u) => <tr><td class="num">{u.number && <a href={url.part(u.id)}>{u.number}</a>}</td><td>{u.category && <a class="caticon" href={`/rc/categories/${u.category}/`} title={catName(u.category)}><Icon name={u.category} /></a>} {u.number ? u.name : <a href={url.part(u.id)}>{u.name}</a>}<Discontinued item={u} /></td><td>{u.material === 'carbon' ? 'carbon fibre' : (u.material ?? '')}{u.material_grade && ` ${u.material_grade}`}</td></tr>)}
    </table></>}
  {(() => { const below = (part.documents ?? []).filter((id) => { const d = db.doc.get(id); return !d || listedBelow([d]).length > 0; }); return below.length > 0 && <>
    <h2>Documents</h2>
    <ul>{below.map((id) => { const d = db.doc.get(id); const w = d && docPage(d, part.released); return <li>{w ? <a href={w} rel="nofollow">{d!.title}</a> : (d?.title ?? id)}{d && !w && d.url && <span class="muted"> · {new URL(d.url).hostname}</span>}{d?.date && <span class="muted"> · {d.date}</span>}</li>; })}</ul></>; })()}
  {part.includes && part.includes.length > 0 && <>
    <h2>Includes <span class="muted">({part.includes.reduce((n, i) => n + (i.qty ?? 1), 0)} pcs)</span></h2>
    <table>
      <tr><th class="num">Qty</th><th>Item</th><th>Spec</th><th>Notes</th><th>Source</th></tr>
      {part.includes.map((i) => { const p = i.part ? db.part.get(i.part) : undefined; const sp = db.spec.get(i.spec ?? p?.equivalent_to?.[0]?.spec ?? ''); const d = i.source ? db.doc.get(i.source) : undefined; return <tr>
        <td class="num">{i.qty ?? ''}</td>
        <td>{i.part ? <><a href={url.part(i.part)}>{p ? (p.number ? `${p.number} ${p.name}` : p.name) : i.part}</a>{p && <Discontinued item={p} />}</> : (i.notes ?? sp?.name ?? i.spec)}</td>
        <td>{sp ? <a href={url.spec(sp.id)}>{sp.name}</a> : ''}</td><td class="muted">{i.part ? (i.notes ?? '') : ''}</td><td class="muted">{d?.title ?? i.source ?? ''}</td>
      </tr>; })}
    </table></>}
  {(kitsOf.length > 1 || (part.fits?.length ?? 0) > 0) && <>
    <h2>Fits these platforms <span class="muted">({kitsOf.length})</span></h2>
    <table>
      <tr><th>Platform</th><th>How</th><th>Source</th></tr>
      {kitsOf.map((k) => <tr><td><a href={url.platform(k.id)}>{k.kit ? `${brandName(k.kit.brand)} ${k.kit.name}` : k.id}</a></td>
        <td>{[...k.roles].join(', ')}{k.releases > 0 && ` (${k.releases} release${k.releases > 1 ? 's' : ''})`}{k.fits.map((f, i) => { const n = shownNote(f.notes); return <>{(k.releases > 0 || i > 0) && '; '}fitment list: {f.type}{n && (isSourceNote(n) ? <> <SourceNote text={n} /></> : <span class="muted"> · {n}</span>)}</>; })}</td>
        <td class="muted">{[...new Set(k.fits.map((f) => (f.source && db.doc.get(f.source)?.title) ?? f.source ?? ''))].filter(Boolean).join('; ')}</td></tr>)}
    </table></>}
  {sinks.length > 0 && <><h2>Heat sinks and fan mounts for a {motorCan} mm can <span class="muted">({sinks.length}, any brand)</span></h2>
    <p class="muted">Clamp-on heat sinks and motor fan mounts whose maker states this can diameter; check the length and the fan size on the part's page.</p>
    <ul>{sinks.map((h) => <li><a href={url.part(h.id)}>{brandName(h.brand)} {partLabel(h)}</a>{h.number && <span class="muted"> {h.name}</span>}<Discontinued item={h} /></li>)}</ul></>}
  {part.equivalent_to && part.equivalent_to.length > 0 && <>
    <h2>Equivalent to</h2>
    <table>
      <tr><th>Generic spec</th><th>Match</th><th>Standards</th><th>Source</th></tr>
      {part.equivalent_to.map((e) => { const sp = db.spec.get(e.spec); const d = e.source ? db.doc.get(e.source) : undefined; return <tr>
        <td><a href={url.spec(e.spec)}>{sp?.name ?? e.spec}</a></td><td>{e.match}</td><td><Standards codes={sp?.standards} /></td><td class="muted">{d?.title ?? e.source ?? ''}{e.notes && <><br />{e.notes}</>}</td>
      </tr>; })}
    </table></>}
  {range.length > 0 && part.range?.endsWith('-springs') && <><h2>Other springs in this series <span class="muted">({range.length})</span></h2>
    <table>
      <tr><th class="num">Number</th><th>Name</th><th>Rate</th><th class="num">Wire mm</th><th class="num">Length mm</th></tr>
      {[part, ...range].sort((a, b) => String(a.free_length_mm ?? '').localeCompare(String(b.free_length_mm ?? ''), undefined, { numeric: true }) || (a.wire_mm ?? a.rate_n_mm ?? a.rate_lb_in ?? 0) - (b.wire_mm ?? b.rate_n_mm ?? b.rate_lb_in ?? 0)).map((o) => <tr>
        <td class="num">{o.number && (o.id === part.id ? <strong>{o.number}</strong> : <a href={url.part(o.id)}>{o.number}</a>)}</td><td>{o.number || o.id === part.id ? o.name : <a href={url.part(o.id)}>{o.name}</a>}<Discontinued item={o} /></td>
        <td>{[o.rate, o.rate_n_mm && `${o.rate_n_mm} N/mm`, o.rate_lb_in && `${o.rate_lb_in} lb/in`].filter(Boolean).join(', ')}</td><td class="num">{o.wire_mm ?? ''}</td><td class="num">{o.free_length_mm ?? ''}</td></tr>)}
    </table></>}
  {range.length > 0 && !part.range?.endsWith('-springs') && <><h2>{part.range?.endsWith('-colours') ? 'Other colours' : <>Other versions <span class="muted">· same range</span></>}</h2>
    <ul>{range.map((o) => <li>{o.category !== 'paint' && <Fragment set:html={colourDot(o.color)} />}<a href={url.part(o.id)}>{partLabel(o)}</a> {o.number && o.name}<Discontinued item={o} /><span class="muted">{o.turns && ` · ${o.turns}T`}{o.kv && ` · ${o.kv} kV`}</span></li>)}</ul></>}
  {similar.length > 0 && <><h2>Similar servos <span class="muted">· same size class{servoRow(part.id)?.spline && ' and spline'}, closest torque and speed · <a href="/rc/servos/">compare all servos</a></span></h2>
    <ul>{similar.map(({ part: o }) => <li><a href={url.part(o.id)}>{brandName(o.brand)} {partLabel(o)}</a> {shortName(o)}<Discontinued item={o} /><span class="muted">{o.torque_kgcm && ` · ${o.torque_kgcm} kg·cm`}{o.speed_s && ` · ${o.speed_s} s/60°`}{o.voltage && ` at ${o.voltage} V`}</span></li>)}</ul></>}
  <Videos videos={db.videosByPart.get(part.id) ?? []} />
  <h2>Used in</h2>
  {uses.length === 0 ? <p class="muted">No release lists this part yet.</p> :
  <table>
    <tr><th class="num">Year</th><th>Release</th><th>Role</th></tr>
    {uses.map((u) => <tr><td class="num"><DateText r={u.release} year /><DateDoubt reason={yearDoubt(u.release)} /></td><td><a href={url.release(u.release.id)}>{brandName(u.release.brand)} {u.release.name}</a><Discontinued item={u.release} /></td><td><span class={`role ${u.role}`}>{u.role === 'kit' ? 'in the box' : u.role}</span></td></tr>)}
  </table>
  <DoubtNote on={uses.some((u) => !!yearDoubt(u.release))} />
  <SeenNote rows={uses.map((u) => u.release)} />}
  <p class="muted">Compatibility according to the manufacturer's parts lists; see each release for the source document.</p>
  <DataLink path={part.toml_path} id={part.id} />
</Base>
