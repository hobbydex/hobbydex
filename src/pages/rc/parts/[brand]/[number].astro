---
import Standards from '../../../../components/Standards.astro';
import WebSearch from '../../../../components/WebSearch.astro';
import { similarServos, servoRow, shortName } from '../../../../lib/servos';
import Base from '../../../../layouts/Base.astro';
import { db, key, url, brandName, yearOf, yearText } from '../../../../lib/data';
import { catName } from '../../../../lib/categories';
import Icon from '../../../../components/Icon.astro';
import DataLink from '../../../../components/DataLink.astro';
import { paintSwatch, paintChip } from '../../../../lib/paintSwatch';
import { colourDot } from '../../../../lib/colourDot';
export function getStaticPaths() {
  // a former id (renamed or corrected) keeps working: its page redirects to the current one
  const moved = db.parts.flatMap((x) => (x.former_ids ?? []).map((f) => ({ params: { brand: key(f)[0], number: key(f)[1] }, props: { redirect: url.part(x.id) } })));
  return [...db.parts.map((p) => ({ params: { brand: key(p.id)[0], number: key(p.id)[1] }, props: { part: p } })), ...moved];
}
if (Astro.props.redirect) return Astro.redirect(Astro.props.redirect, 301);
const part = Astro.props.part!;   // set on every page that is not a redirect
const brand = db.brand.get(part.brand);
const uses = [...(db.usesByPart.get(part.id) ?? [])].sort((a, b) => yearOf(a.release) - yearOf(b.release) || a.release.name.localeCompare(b.release.name));
// every kit this part belongs to: through a release's contents or the brand's fitment lists
const kitMap = new Map<string, { roles: Set<string>; releases: number; fit?: string }>();
for (const u of uses) {
  const k = kitMap.get(u.release.kit) ?? { roles: new Set<string>(), releases: 0 };
  k.roles.add(u.role === 'kit' ? 'in the box' : u.role); k.releases++; kitMap.set(u.release.kit, k);
}
for (const f of part.fits ?? []) {
  const k = kitMap.get(f.kit) ?? { roles: new Set<string>(), releases: 0 };
  k.fit = f.type; kitMap.set(f.kit, k);
}
const kitsOf = [...kitMap.entries()].map(([id, v]) => ({ id, kit: db.kit.get(id), ...v })).sort((a, b) => (a.kit?.name ?? a.id).localeCompare(b.kit?.name ?? b.id));
const replacedBy = db.replacedBy.get(part.id) ?? [];
const replaces = part.supersedes ? db.part.get(part.supersedes) : undefined;
const upgradeFor = [...new Set((part.fits ?? []).map((f) => f.replaces).filter((x): x is string => !!x))].map((id) => db.part.get(id)).filter((x): x is NonNullable<typeof x> => !!x);
const upgrades = db.upgradesFor.get(part.id) ?? [];
const rebrandOf = (part.rebrand_of ?? []).map((r) => db.part.get(r.part)).filter((x): x is NonNullable<typeof x> => !!x);
const soldAs = db.rebrandsOf.get(part.id) ?? [];
// part-to-part links from names, both ways: "requires TKR5150" here, "Required by" there
const FWD: Record<string, string> = { requires: 'Requires', fits: 'Fits', 'use-with': 'Use with', for: 'Made for', replaces: 'Replaces', 'same-colour': 'Same colour' };
const BACK: Record<string, string> = { requires: 'Required by', fits: 'Fitted with', 'use-with': 'Used with', for: 'Accessories', replaces: 'Replaced by', 'same-colour': 'Same colour' };
const relRows = [...(part.related ?? []).map((r) => ({ label: FWD[r.relation] ?? r.relation, p: db.part.get(r.part) })),
  ...(db.relatedTo.get(part.id) ?? []).map((r) => ({ label: BACK[r.relation] ?? r.relation, p: r.part }))].filter((r) => r.p)
  .filter((r, i, all) => all.findIndex((o) => o.label === r.label && o.p!.id === r.p!.id) === i);   // same-colour is recorded on both paints
const relGroups = [...new Set(relRows.map((r) => r.label))].map((label) => ({ label, parts: relRows.filter((r) => r.label === label).map((r) => r.p!) }));
const similar = part.category === 'servo' ? similarServos(part.id) : [];
// the other versions of a range (winds, kV), lowest first
const rating = (o: typeof part) => o.turns ?? (o.kv ? -o.kv : 0);
const range = part.range ? (db.partsByRange.get(part.range) ?? []).filter((o) => o.id !== part.id).sort((a, b) => rating(b) - rating(a)) : [];
const swatch = paintSwatch(part, 'large');
// a nitro or gas engine: class, displacement, bore x stroke, fuel
const engine = part.category === 'engine-fuel' ? [part.engine_class && `${part.engine_class} class`, part.displacement_cc && `${part.displacement_cc} cc`,
  part.bore_mm && part.stroke_mm ? `bore x stroke ${part.bore_mm} x ${part.stroke_mm} mm` : part.bore_mm && `bore ${part.bore_mm} mm`, part.fuel].filter(Boolean).join(', ') : '';
const chip = paintChip(part, 120);
const isWheel = part.category === 'tire' || part.category === 'wheel';
// the wheel facts in one line, the colours with their dot
const wheelFacts = [part.wheel_size && `${part.wheel_size} rim`, part.compound && `${part.compound} compound`, part.mounting && ({ 'pre-mounted': 'pre-mounted on wheels', 'pre-mounted-not-glued': 'mounted on wheels, not glued', 'wheels-included': 'wheels included, to be mounted', unmounted: 'tires only, no wheels' } as Record<string, string>)[part.mounting],
  part.wheel_color && { dot: colourDot(part.wheel_color), text: `${part.wheel_color} wheels` }, part.color && { dot: colourDot(part.color), text: part.color },
  part.offset_mm !== undefined && `offset ${part.offset_mm > 0 ? '+' : ''}${part.offset_mm} mm`, part.beadlock && 'beadlock'].filter((x): x is string | { dot: string; text: string } => !!x);
const jsonld = { '@context': 'https://schema.org', '@type': 'Product', name: part.name, mpn: part.number, sku: part.number, brand: { '@type': 'Brand', name: brand?.name } };
---
<Base title={`${part.number} ${part.name}`} description={`${brand?.name} ${part.number} ${part.name}: which kits use it.`} jsonld={jsonld} kind="part" sub={brand?.name}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href={url.brand(part.brand)}>{brandName(part.brand)}</a> / {part.number}</div>
  {part.category && <span hidden data-pagefind-filter={`category:${catName(part.category)}`} />}
  <h1 data-pagefind-meta="title" data-pagefind-weight="10" data-pagefind-sort="title">{part.number} <span class="muted">·</span> {part.name}</h1>
  {(part as { name_source?: string }).name_source === 'ocr' && <p class="muted ocrname" data-pagefind-ignore>This name was read by OCR from a scanned manual and is not checked yet; it may contain reading errors.</p>}
  <WebSearch query={`"${part.number}" ${brand?.name ?? ''}`.trim()} copy={part.number} links={part.links} />
  <dl class="facts">
    <dt>Brand</dt><dd><a href={url.brand(part.brand)}>{brandName(part.brand)}</a></dd>
    <dt>Part number</dt><dd>{part.number}</dd>
    {part.category && <><dt>Category</dt><dd><a href={`/rc/categories/${part.category}/`}>{catName(part.category)}</a> <span class="muted">· <a href={`/rc/categories/${part.category}/${key(part.brand)[0]}/`}>more from {brandName(part.brand)}</a></span></dd></>}
    {part.released && <><dt>Released</dt><dd>{part.released}</dd></>}
    {replaces && <><dt>Replaces</dt><dd><a href={url.part(replaces.id)}>{replaces.number}</a> {replaces.name}</dd></>}
    {rebrandOf.length > 0 && <><dt>Rebrand of</dt><dd>{rebrandOf.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{brandName(r.brand)} {r.number}</a> {r.name}</>)}</dd></>}
    {relGroups.map((g) => <><dt>{g.label}</dt><dd>{g.parts.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{r.number}</a> {r.name}</>)}</dd></>)}
    {soldAs.length > 0 && <><dt>Also sold as</dt><dd>{soldAs.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{brandName(r.brand)} {r.number}</a> {r.name}</>)}</dd></>}
    {upgradeFor.length > 0 && <><dt>Upgrade for</dt><dd>{upgradeFor.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{r.number}</a> {r.name}</>)}</dd></>}
    {replacedBy.length > 0 && <><dt>Replaced by</dt><dd>{replacedBy.map((r, i) => <>{i > 0 && ', '}<a href={url.part(r.id)}>{r.number}</a> {r.name}</>)}</dd></>}
    {part.pack_qty && <><dt>Pack</dt><dd>{part.pack_qty} pcs</dd></>}
    {part.former_names && part.former_names.length > 0 && <><dt>Formerly listed as</dt><dd>{part.former_names.join('; ')}</dd></>}
    {part.material && <><dt>Material</dt><dd>{part.material === 'carbon' ? 'carbon fibre' : part.material}{part.material_grade && ` ${part.material_grade}`}{part.strength_class && ` ${part.strength_class}`}{part.finish && `, ${part.finish}`}</dd></>}
    {part.thread_type && <><dt>Thread</dt><dd>{part.thread_type}</dd></>}
    {part.seal && <><dt>Seal</dt><dd>{({ open: 'open', metal: 'metal shields (ZZ)', rubber: 'rubber seals (2RS)', 'rubber-metal': 'rubber and metal' } as Record<string, string>)[part.seal] ?? part.seal}</dd></>}
    {part.lubricant && <><dt>Lubricant</dt><dd>{part.lubricant}</dd></>}
    {part.category === 'paint' && (part.paint_type || part.finish) && <><dt>Paint</dt><dd>{[part.paint_type, part.finish?.replace(/-/g, ' ')].filter(Boolean).join(', ')}</dd></>}
    {part.category === 'paint' && part.application && <><dt>Apply with</dt><dd>{[part.application].flat().map((a) => ({ 'spray-can': 'spray can', marker: 'paint pen' } as Record<string, string>)[a] ?? a).join(' or ')}</dd></>}
    {part.category === 'paint' && (swatch || part.color) && <><dt>Colour</dt><dd class="paintcolour">{chip && <span set:html={chip} />}{swatch && <span set:html={swatch} />}{part.color}{swatch && <span class="muted"> · approximate colour, sampled from {brandName(part.brand)}'s colour chart; screens show colours differently</span>}</dd></>}
    {part.viscosity_wt && <><dt>Viscosity</dt><dd>{part.viscosity_wt} wt <span class="muted">(the brand's own scale)</span></dd></>}
    {part.volume_ml && <><dt>Volume</dt><dd>{part.pack_qty && part.pack_qty > 1 ? `${part.pack_qty} x ${part.volume_ml} ml` : `${part.volume_ml} ml`}</dd></>}
    {isWheel && wheelFacts.length > 0 && <><dt>{part.category === 'tire' ? 'Tire' : 'Wheel'}</dt><dd>{wheelFacts.map((f, i) => <>{i > 0 && ', '}{typeof f === 'string' ? f : <><Fragment set:html={f.dot} />{f.text}</>}</>)}</dd></>}
    {!isWheel && part.category !== 'paint' && part.color && <><dt>Colour</dt><dd><Fragment set:html={colourDot(part.color)} />{part.color}</dd></>}
    {part.teeth && part.category === 'spur-gear' && <><dt>Gear</dt><dd>{part.teeth}T{part.pitch_dp ? `, ${part.pitch_dp} pitch` : part.module ? `, module ${part.module}` : ''}</dd></>}
    {part.bore_mm && !engine && <><dt>Bore</dt><dd>{part.bore_mm} mm</dd></>}
    {engine && <><dt>Engine</dt><dd>{engine}</dd></>}
    {part.output_hp && <><dt>Output</dt><dd>{part.output_hp} hp{part.output_rpm && ` at ${part.output_rpm.toLocaleString('en')} rpm`}</dd></>}
    {part.rpm_range && <><dt>Practical rpm</dt><dd>{part.rpm_range.map((r) => r.toLocaleString('en')).join(' - ')} rpm</dd></>}
    {part.capacity_mah && <><dt>Battery</dt><dd>{part.chemistry?.toUpperCase()} {part.cells}S {part.capacity_mah} mAh{part.c_rating && ` ${part.c_rating}C`}{part.case && `, ${part.case} case`}</dd></>}
    {part.dimensions_mm && <><dt>Size</dt><dd>{part.dimensions_mm.join(' x ')} mm</dd></>}
    {part.weight_g && <><dt>Weight</dt><dd>{part.weight_g} g</dd></>}
    {part.connector && <><dt>Plug</dt><dd>{part.connector}</dd></>}
    {(part.kv || part.turns) && <><dt>Motor</dt><dd>{[part.kv && `${part.kv} kV`, part.turns && `${part.turns}T`, part.diameter_mm && part.length_mm && `${part.diameter_mm} x ${part.length_mm} mm`, part.shaft_mm && `${part.shaft_mm} mm shaft`].filter(Boolean).join(', ')}</dd></>}
    {part.current_a && <><dt>ESC</dt><dd>{part.current_a} A{part.peak_current_a && ` (${part.peak_current_a} A peak)`}</dd></>}
    {part.lipo_cells && <><dt>LiPo</dt><dd>{part.lipo_cells[0] === part.lipo_cells[1] ? `${part.lipo_cells[0]}S` : `${part.lipo_cells[0]}-${part.lipo_cells[1]}S`}</dd></>}
    {part.torque_kgcm && <><dt>Servo</dt><dd>{part.torque_kgcm} kg/cm{part.speed_s && `, ${part.speed_s} s/60°`}{part.voltage && ` at ${part.voltage} V`}{part.motor && `, ${part.motor}`}{part.gear_material && `, ${part.gear_material} gears`}</dd></>}
    {part.channels && <><dt>Channels</dt><dd>{part.channels}</dd></>}
    {part.protocol && <><dt>Protocol</dt><dd>{part.protocol}</dd></>}
    {part.notes && <><dt>Notes</dt><dd>{part.notes}</dd></>}
    {part.applies_to && <><dt>Listed for</dt><dd>{part.applies_to}</dd></>}
  </dl>
  {upgrades.length > 0 && <>
    <h2>Upgrades for this part <span class="muted">({upgrades.length})</span></h2>
    <table>
      <tr><th class="num">Number</th><th>Name</th><th>Material</th></tr>
      {upgrades.map((u) => <tr><td class="num"><a href={url.part(u.id)}>{u.number}</a></td><td>{u.category && <a class="caticon" href={`/rc/categories/${u.category}/`} title={catName(u.category)}><Icon name={u.category} /></a>} {u.name}</td><td>{u.material === 'carbon' ? 'carbon fibre' : (u.material ?? '')}{u.material_grade && ` ${u.material_grade}`}</td></tr>)}
    </table></>}
  {part.documents && part.documents.length > 0 && <>
    <h2>Documents</h2>
    <ul>{part.documents.map((id) => { const d = db.doc.get(id); return <li>{d?.url ? <a href={d.url} rel="nofollow">{d.title}</a> : (d?.title ?? id)}{d?.date && <span class="muted"> · {d.date}</span>}</li>; })}</ul></>}
  {part.includes && part.includes.length > 0 && <>
    <h2>Includes <span class="muted">({part.includes.reduce((n, i) => n + (i.qty ?? 1), 0)} pcs)</span></h2>
    <table>
      <tr><th class="num">Qty</th><th>Item</th><th>Spec</th><th>Notes</th><th>Source</th></tr>
      {part.includes.map((i) => { const p = i.part ? db.part.get(i.part) : undefined; const sp = db.spec.get(i.spec ?? p?.equivalent_to?.[0]?.spec ?? ''); const d = i.source ? db.doc.get(i.source) : undefined; return <tr>
        <td class="num">{i.qty ?? ''}</td>
        <td>{i.part ? <a href={url.part(i.part)}>{p ? `${p.number} ${p.name}` : i.part}</a> : (i.notes ?? sp?.name ?? i.spec)}</td>
        <td>{sp ? <a href={url.spec(sp.id)}>{sp.name}</a> : ''}</td><td class="muted">{i.part ? (i.notes ?? '') : ''}</td><td class="muted">{d?.title ?? i.source ?? ''}</td>
      </tr>; })}
    </table></>}
  {kitsOf.length > 1 && <>
    <h2>Fits these kits <span class="muted">({kitsOf.length})</span></h2>
    <table>
      <tr><th>Kit</th><th>How</th></tr>
      {kitsOf.map((k) => <tr><td><a href={url.kit(k.id)}>{k.kit ? `${brandName(k.kit.brand)} ${k.kit.name}` : k.id}</a></td>
        <td class="muted">{[...k.roles].join(', ')}{k.releases > 0 && ` (${k.releases} release${k.releases > 1 ? 's' : ''})`}{k.fit && `${k.releases > 0 ? '; ' : ''}fitment list: ${k.fit}`}</td></tr>)}
    </table></>}
  {part.fits && part.fits.length > 0 && <>
    <h2>Fits <span class="muted">({part.fits.length} chassis)</span></h2>
    <table>
      <tr><th>Kit</th><th>Fit</th><th>Source</th></tr>
      {part.fits.map((f) => { const k = db.kit.get(f.kit); const d = f.source ? db.doc.get(f.source) : undefined; return <tr>
        <td><a href={url.kit(f.kit)}>{k ? `${brandName(k.brand)} ${k.name}` : f.kit}</a></td><td>{f.type}{f.notes && <span class="muted"> · {f.notes}</span>}</td><td class="muted">{d?.title ?? f.source ?? ''}</td>
      </tr>; })}
    </table></>}
  {part.equivalent_to && part.equivalent_to.length > 0 && <>
    <h2>Equivalent to</h2>
    <table>
      <tr><th>Generic spec</th><th>Match</th><th>Standards</th><th>Source</th></tr>
      {part.equivalent_to.map((e) => { const sp = db.spec.get(e.spec); const d = e.source ? db.doc.get(e.source) : undefined; return <tr>
        <td><a href={url.spec(e.spec)}>{sp?.name ?? e.spec}</a></td><td>{e.match}</td><td><Standards codes={sp?.standards} /></td><td class="muted">{d?.title ?? e.source ?? ''}{e.notes && <><br />{e.notes}</>}</td>
      </tr>; })}
    </table></>}
  {range.length > 0 && part.range?.endsWith('-springs') && <><h2>Other springs in this series <span class="muted">({range.length})</span></h2>
    <table>
      <tr><th class="num">Number</th><th>Name</th><th>Rate</th><th class="num">Wire mm</th><th class="num">Length mm</th></tr>
      {[part, ...range].sort((a, b) => String(a.free_length_mm ?? '').localeCompare(String(b.free_length_mm ?? ''), undefined, { numeric: true }) || (a.wire_mm ?? a.rate_n_mm ?? a.rate_lb_in ?? 0) - (b.wire_mm ?? b.rate_n_mm ?? b.rate_lb_in ?? 0)).map((o) => <tr>
        <td class="num">{o.id === part.id ? <strong>{o.number}</strong> : <a href={url.part(o.id)}>{o.number}</a>}</td><td>{o.name}</td>
        <td>{[o.rate, o.rate_n_mm && `${o.rate_n_mm} N/mm`, o.rate_lb_in && `${o.rate_lb_in} lb/in`].filter(Boolean).join(', ')}</td><td class="num">{o.wire_mm ?? ''}</td><td class="num">{o.free_length_mm ?? ''}</td></tr>)}
    </table></>}
  {range.length > 0 && !part.range?.endsWith('-springs') && <><h2>{part.range?.endsWith('-colours') ? 'Other colours' : <>Other versions <span class="muted">· same range</span></>}</h2>
    <ul>{range.map((o) => <li>{o.category !== 'paint' && <Fragment set:html={colourDot(o.color)} />}<a href={url.part(o.id)}>{o.number}</a> {o.name}<span class="muted">{o.turns && ` · ${o.turns}T`}{o.kv && ` · ${o.kv} kV`}</span></li>)}</ul></>}
  {similar.length > 0 && <><h2>Similar servos <span class="muted">· same size class{servoRow(part.id)?.spline && ' and spline'}, closest torque and speed · <a href="/rc/servos/">compare all servos</a></span></h2>
    <ul>{similar.map(({ part: o }) => <li><a href={url.part(o.id)}>{brandName(o.brand)} {o.number}</a> {shortName(o)}<span class="muted">{o.torque_kgcm && ` · ${o.torque_kgcm} kg·cm`}{o.speed_s && ` · ${o.speed_s} s/60°`}{o.voltage && ` at ${o.voltage} V`}</span></li>)}</ul></>}
  <h2>Used in</h2>
  {uses.length === 0 ? <p class="muted">No release lists this part yet.</p> :
  <table>
    <tr><th class="num">Year</th><th>Release</th><th>Role</th></tr>
    {uses.map((u) => <tr><td class="num">{yearText(u.release)}</td><td><a href={url.release(u.release.id)}>{brandName(u.release.brand)} {u.release.name}</a></td><td><span class={`role ${u.role}`}>{u.role === 'kit' ? 'in the box' : u.role}</span></td></tr>)}
  </table>}
  <p class="muted">Compatibility according to the manufacturer's parts lists; see each release for the source document.</p>
  <DataLink path={part.toml_path} />
</Base>
