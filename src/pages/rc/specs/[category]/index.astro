---
import Base from '../../../../layouts/Base.astro';
import { url } from '../../../../lib/data';
import { specLabel, specIntro, specGuide, specColumns, specsByCategory, linkedCount, MOTOR_SPEED_NOTE, BATTERY_NOTE } from '../../../../lib/specs';
import SpecFilter from '../../../../components/SpecFilter.astro';
export function getStaticPaths() {
  return [...specsByCategory.keys()].map((category) => ({ params: { category } }));
}
const { category } = Astro.params;
const specs = specsByCategory.get(category!)!;
const title = specLabel[category!] ?? category!;
const show = specColumns[category!] ?? [];
const cell = (s: Record<string, unknown>, k: string, unset = '') => typeof s[k] === 'boolean' ? (s[k] ? 'yes' : 'no') : s[k] === undefined ? unset : String(s[k]);
const washerNames: [string, string][] = [['under 1 mm', 'shim'], ['1 mm to under 3 mm', 'washer'], ['3 mm and up', 'spacer']];
---
<Base title={`${title}: generic specs`} description={`Every generic ${category} spec in Hobbydex and how many branded parts match it.`}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href="/rc/specs/">specs</a> / {category}</div>
  <h1>{title}</h1>
  {specIntro[category!] && <p>{specIntro[category!]}</p>}
  {specGuide[category!] && <dl class="specguide">{specGuide[category!].map(([t, d]) => <><dt>{t}</dt><dd>{d}</dd></>)}</dl>}
  {category === 'motor' && MOTOR_SPEED_NOTE.map((t) => <p>{t}</p>)}
  {category === 'battery' && BATTERY_NOTE.map(([h, t]) => <p><b>{h}.</b> {t}</p>)}
  {category === 'washer' && <table style="width:auto;margin-bottom:1rem">
    <tr><th>Thickness</th><th>Name</th></tr>
    {washerNames.map(([t, n]) => <tr><td>{t}</td><td>{n}</td></tr>)}
  </table>}
  <p class="muted">{specs.length} specs, sorted by size. Counts are branded parts linked to each spec.</p>
  <div class="specbox">
    <SpecFilter columns={show.map(([k, l, unset]) => ({ label: l, values: specs.map((s) => cell(s, k, unset)) }))} total={specs.length} />
    <div class="tablescroll"><table>
      <thead><tr><th>Spec</th>{show.map(([, l]) => <th>{l}</th>)}<th class="num">Parts</th><th class="num">Brands</th></tr></thead>
      <tbody>{specs.map((s) => { const n = linkedCount(s.id); return <tr>
        <td><a href={url.spec(s.id)}>{s.name ?? s.id}</a></td>{show.map(([k, , unset]) => <td>{cell(s, k, unset)}</td>)}<td class="num">{n.parts}</td><td class="num">{n.brands}</td>
      </tr>; })}</tbody>
    </table></div>
  </div>
</Base>
