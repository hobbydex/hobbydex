---
import { specLabel } from '../../../../lib/specs';
import { specFacts, threadRows } from '../../../../lib/specFacts';
import FactRows from '../../../../components/FactRows.astro';
import Base from '../../../../layouts/Base.astro';
import Standards from '../../../../components/Standards.astro';
import { specDrawing } from '../../../../lib/specDrawings';
import HardwareBag from '../../../../components/HardwareBag.astro';
import { hardwareFile, isApproxDrawing } from '../../../../lib/hardwareBag';
import { db, key, url, brandName, partLabel, yearOf, heatsinksByCan, canDiameter , yearDoubt } from '../../../../lib/data';
import DateText from '../../../../components/DateText.astro';
import DateDoubt from '../../../../components/DateDoubt.astro';
import DoubtNote from '../../../../components/DoubtNote.astro';
import DataLink from '../../../../components/DataLink.astro';
export function getStaticPaths() {
  return db.specs.map((s) => ({ params: { category: key(s.id)[0], slug: key(s.id)[1] }, props: { spec: s } }));
}
const { spec } = Astro.props;
const linked = db.partsBySpec.get(spec.id) ?? [];
const uses = linked.flatMap(({ part, link }) => (db.usesByPart.get(part.id) ?? []).map((u) => ({ part, link, ...u })))
  .sort((a, b) => yearOf(a.release) - yearOf(b.release) || a.release.name.localeCompare(b.release.name));
const title = spec.name ?? key(spec.id)[1];
const drawing = specDrawing(spec);
const drawStd = drawing?.standard ? db.standardByCode.get(drawing.standard) : undefined;
// servos: every servo of the same size class, whatever its spline, closest case first
const sameSize = spec.category !== 'servo' ? [] : db.specs.filter((o) => o.category === 'servo' && o.size_class === spec.size_class)
  .flatMap((o) => (db.partsBySpec.get(o.id) ?? []).map(({ part }) => ({ part, spline: o.spline_teeth as number | undefined })))
  .sort((a, b) => (a.part.dimensions_mm?.[0] ?? 999) - (b.part.dimensions_mm?.[0] ?? 999) || (a.part.dimensions_mm?.[2] ?? 999) - (b.part.dimensions_mm?.[2] ?? 999));
const plugs = [...new Set(linked.map(({ part }) => part.connector).filter((c): c is string => !!c))].sort();
// a connector spec: the leads and adapters that list this plug among theirs (the plug parts are `linked`)
const leads = spec.category === 'connector' ? db.leadsBySpec.get(spec.id) ?? [] : [];
// a connector spec: the batteries whose balance lead is this JST-XH size, and the parts whose main plug (`connector`) is it
const balanced = spec.category === 'connector' ? db.balanceBySpec.get(spec.id) ?? [] : [];
const plugged = spec.category === 'connector' ? db.plugsBySpec.get(spec.id) ?? [] : [];
const specCan = spec.category === 'motor' ? canDiameter(spec as { diameter_mm?: number; can?: unknown }) : undefined;
const specSinks = specCan ? (heatsinksByCan.get(specCan) ?? []) : [];
import SeenNote from '../../../../components/SeenNote.astro';
---
<Base title={title} description={`${title}: generic ${spec.category} spec, and which branded parts and kits match it.`} kind="spec" sub={spec.category} words={spec.category}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href="/rc/specs/">Specs</a> / <a href={`/rc/specs/${spec.category}/`}>{specLabel[spec.category] ?? spec.category}</a> / {key(spec.id)[1]}</div>
  <h1>{title}</h1>
  <dl class="facts">
    <dt>Category</dt><dd><a href={`/rc/specs/${spec.category}/`}>{specLabel[spec.category] ?? spec.category}</a></dd>
    <FactRows rows={threadRows(specFacts(spec))} />
    {spec.standards && <><dt>Standards</dt><dd><Standards codes={spec.standards} /></dd></>}
  </dl>
  {hardwareFile(spec.id) && <div data-pagefind-ignore><HardwareBag items={[{ spec: spec.id, qty: 1 }]} /></div>}
  {isApproxDrawing(spec.id) && <p class="muted" data-pagefind-ignore>The bag drawing's head proportions are interpolated between the neighbouring sizes of the screw table, not taken from the standard.</p>}
  {drawing && <figure class="drawing" data-pagefind-ignore>
    <Fragment set:html={drawing.svg} />
    {spec.category === 'screw' ? <figcaption class="muted">To scale. {drawStd ? <>Head and socket sizes from <a href={url.standard(drawStd.id)}>{drawStd.code}</a></> : drawing.standard ? <>Head and socket sizes from {drawing.standard}</> : <>Head proportions as usual for this type</>}{drawing.approximate && drawing.standard && '; this size is outside the standard\'s table, so the head is drawn with the usual proportions'}{spec.thread_type === 'self-tapping' && '; the point is drawn flat (ISO 7049-F style) and the thread per ISO 1478'}.</figcaption>
      : spec.category === 'nut' ? <figcaption class="muted">{drawing.approximate ? 'Drawn to the sizes the spec gives' : 'To scale'}{drawStd ? <>; sizes from <a href={url.standard(drawStd.id)}>{drawStd.code}</a></> : ''}.{drawing.note && ` ${drawing.note}.`}{String(spec.type).endsWith('nylon-lock') ? ' The nylon ring is shaded.' : ''}</figcaption>
      : spec.category === 'connector' ? <figcaption class="muted">{drawing.approximate ? 'Not to scale' : 'To scale'}{drawing.note && `: ${drawing.note}`}.</figcaption>
      : <figcaption class="muted">{drawing.approximate ? 'Drawn to the usual sizes' : 'To scale'}.{drawing.note && ` ${drawing.note}.`}</figcaption>}
  </figure>}
  {specSinks.length > 0 && <><h2>Heat sinks and fan mounts for a {specCan} mm can <span class="muted">({specSinks.length}, any brand)</span></h2>
    <ul>{specSinks.map((h) => <li><a href={url.part(h.id)}>{brandName(h.brand)} {partLabel(h)}</a>{h.number && <span class="muted"> {h.name}</span>}</li>)}</ul></>}
  <h2>Branded parts matching this spec <span class="muted">({linked.length})</span></h2>
  {spec.category === 'battery' && plugs.length > 1 && <p data-pagefind-ignore><label>Plug <select id="plugfilter"><option value="">any (plugs can be changed)</option>{plugs.map((c) => <option value={c}>{c}</option>)}</select></label></p>}
  {linked.length === 0 ? <p class="muted">None linked yet.</p> :
  <div class="tablescroll"><table class="stacked">
    <tr><th>Brand</th><th class="num">Number</th><th>Name</th><th class="num">Pack</th><th>Material</th>{spec.category === 'bearing' && <th>Seal</th>}{spec.category === 'pinion' && <th class="num">Bore mm</th>}{spec.category === 'battery' && <><th class="num">C</th><th>Case</th><th>Size mm</th><th class="num">g</th><th>Plug</th></>}<th>Match</th></tr>
    {linked.map(({ part, link }) => <tr data-plug={part.connector ?? ''}><td data-label="Brand">{brandName(part.brand)}</td><td class="num" data-label="Number">{part.number && <a href={url.part(part.id)}>{part.number}</a>}</td><td class="name">{part.number ? part.name : <a href={url.part(part.id)}>{part.name}</a>}</td><td class="num" data-label="Pack">{part.pack_qty ?? ''}</td><td data-label="Material">{part.material ?? ''}</td>{spec.category === 'bearing' && <td data-label="Seal">{part.seal ?? ''}</td>}{spec.category === 'pinion' && <td class="num" data-label="Bore mm">{part.bore_mm ?? ''}</td>}{spec.category === 'battery' && <><td class="num" data-label="C">{part.c_rating ?? ''}</td><td data-label="Case">{part.case ?? ''}</td><td data-label="Size mm">{part.dimensions_mm?.join(' x ') ?? ''}</td><td class="num" data-label="g">{part.weight_g ?? ''}</td><td data-label="Plug">{part.connector ?? ''}</td></>}<td data-label="Match">{link.match}</td></tr>)}
  </table></div>}
  {balanced.length > 0 && <>
    <h2 id="balance-packs">Batteries with this balance plug <span class="muted">({balanced.length})</span></h2>
    <div class="tablescroll"><table class="stacked">
      <tr><th>Brand</th><th class="num">Number</th><th>Name</th><th class="num">Cells</th><th>Main plug</th></tr>
      {balanced.map((part) => <tr><td data-label="Brand">{brandName(part.brand)}</td><td class="num" data-label="Number">{part.number && <a href={url.part(part.id)}>{part.number}</a>}</td><td class="name">{part.number ? part.name : <a href={url.part(part.id)}>{part.name}</a>}</td><td class="num" data-label="Cells">{part.cells ?? ''}</td><td data-label="Main plug">{part.connector ?? ''}</td></tr>)}
    </table></div></>}
  {plugged.length > 0 && <>
    <h2 id="plugged">Parts with this plug <span class="muted">({plugged.length})</span></h2>
    <div class="tablescroll"><table class="stacked">
      <tr><th>Brand</th><th class="num">Number</th><th>Name</th><th>Category</th><th class="num">Cells</th></tr>
      {plugged.map((part) => <tr><td data-label="Brand">{brandName(part.brand)}</td><td class="num" data-label="Number">{part.number && <a href={url.part(part.id)}>{part.number}</a>}</td><td class="name">{part.number ? part.name : <a href={url.part(part.id)}>{part.name}</a>}</td><td data-label="Category">{part.category ?? ''}</td><td class="num" data-label="Cells">{part.cells ?? ''}</td></tr>)}
    </table></div></>}
  {leads.length > 0 && <>
    <h2 id="leads">Leads and adapters with this plug <span class="muted">({leads.length})</span></h2>
    <div class="tablescroll"><table class="stacked">
      <tr><th>Brand</th><th class="num">Number</th><th>Name</th><th>Plugs</th></tr>
      {leads.map((part) => <tr><td data-label="Brand">{brandName(part.brand)}</td><td class="num" data-label="Number">{part.number && <a href={url.part(part.id)}>{part.number}</a>}</td><td class="name">{part.number ? part.name : <a href={url.part(part.id)}>{part.name}</a>}</td><td data-label="Plugs">{part.connectors!.join(', ')}</td></tr>)}
    </table></div></>}
  {(db.setsBySpec.get(spec.id) ?? []).length > 0 && <>
    <h2>In sets</h2>
    <table>
      <tr><th>Brand</th><th class="num">Number</th><th>Set</th><th class="num">Qty</th><th>Notes</th></tr>
      {db.setsBySpec.get(spec.id)!.map((x) => <tr><td>{brandName(x.part.brand)}</td><td class="num">{x.part.number && <a href={url.part(x.part.id)}>{x.part.number}</a>}</td><td>{x.part.number ? x.part.name : <a href={url.part(x.part.id)}>{x.part.name}</a>}</td><td class="num">{x.qty ?? ''}</td><td class="muted">{x.notes ?? ''}</td></tr>)}
    </table></>}
  {sameSize.length > 0 && <>
    <h2>All {String(spec.size_class).replace('-', ' ')} servos <span class="muted">({sameSize.length}, by case length then height)</span></h2>
    <p class="muted">Check the case size and the mounting holes before swapping: two servos of one size class do not always fit the same mount.</p>
    <table class="stacked">
      <tr><th>Brand</th><th class="num">Number</th><th>Name</th><th>Case mm (LxWxH)</th><th class="num">Spline</th><th class="num">kg/cm</th><th class="num">s/60°</th><th class="num">V</th><th class="num">g</th></tr>
      {sameSize.map(({ part, spline }) => <tr><td data-label="Brand">{brandName(part.brand)}</td><td class="num" data-label="Number">{part.number && <a href={url.part(part.id)}>{part.number}</a>}</td><td class="name">{part.number ? part.name : <a href={url.part(part.id)}>{part.name}</a>}</td>
        <td data-label="Case mm (LxWxH)">{part.dimensions_mm?.join(' x ') ?? ''}</td><td class="num" data-label="Spline">{spline ? `${spline}T` : ''}</td><td class="num" data-label="kg/cm">{part.torque_kgcm ?? ''}</td><td class="num" data-label="s/60°">{part.speed_s ?? ''}</td><td class="num" data-label="V">{part.voltage ?? ''}</td><td class="num" data-label="g">{part.weight_g ?? ''}</td></tr>)}
    </table></>}
  <h2>Used in <span class="muted">(via those parts)</span></h2>
  {uses.length === 0 ? <p class="muted">No release lists a matching part yet.</p> :
  <table>
    <tr><th class="num">Year</th><th>Release</th><th>As part</th><th>Role</th></tr>
    {uses.map((u) => <tr><td class="num"><DateText r={u.release} year /><DateDoubt reason={yearDoubt(u.release)} /></td><td><a href={url.release(u.release.id)}>{brandName(u.release.brand)} {u.release.name}</a></td><td><a href={url.part(u.part.id)}>{partLabel(u.part)}</a></td><td><span class={`role ${u.role}`}>{u.role === 'kit' ? 'in the box' : u.role}</span></td></tr>)}
  </table>
  <DoubtNote on={uses.some((u) => !!yearDoubt(u.release))} />
  <SeenNote rows={uses.map((u) => u.release)} />}
  <script>
    const sel = document.getElementById('plugfilter') as HTMLSelectElement | null;
    sel?.addEventListener('change', () => {
      for (const tr of document.querySelectorAll<HTMLTableRowElement>('tr[data-plug]')) tr.hidden = !!sel.value && tr.dataset.plug !== sel.value;
    });
  </script>
  <p class="muted">Derived by walking release, part and equivalence links; the material is a property of each branded part, not of the spec.</p>
  <DataLink path={(spec as { toml_path?: string }).toml_path} id={spec.id} />
</Base>
