---
import Base from '../../../layouts/Base.astro';
import { db } from '../../../lib/data';
import Icon from '../../../components/Icon.astro';
import { specIcon, specLabel, specsByCategory } from '../../../lib/specs';
const cats = [...specsByCategory.keys()].sort();
// spec categories with at least one spec that follows a published standard, and those standards
const stdCats = cats.filter((c) => specsByCategory.get(c)!.some((s) => s.standards?.length));
const stdCodes = [...new Set(db.specs.flatMap((s) => s.standards ?? []))];
const list = (xs: string[]) => xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}` : xs.join('');
const stdText = list(stdCats.map((c) => (specLabel[c] ?? c).toLowerCase()));
---
<Base title="Generic specs" description="Brand-independent specifications (screws, bearings, silicone oils) and the branded parts that match them.">
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / Specs</div>
  <h1>Generic specs</h1>
  <p>A spec is the brand-independent version of a part: an M3x10 countersunk hex screw, a 5x10x4 bearing, a 350 cSt silicone oil. Branded parts link to the spec they are equivalent to, so you can find the same part from another brand, or every kit that uses it.</p>
  <table>
    <tr><th>Category</th><th class="num">Specs</th><th class="num">Linked parts</th></tr>
    {cats.map((c) => { const ss = specsByCategory.get(c)!; const n = ss.reduce((t, s) => t + (c === 'ring-pinion' ? (db.setsBySpec.get(s.id)?.length ?? 0) : 0) + (db.partsBySpec.get(s.id)?.length ?? 0) + (db.protocolParts.get(s.id)?.length ?? 0), 0); return <tr>
      <td><a href={`/rc/specs/${c}/`}>{specIcon[c] && <Icon name={specIcon[c]} size="1.25em" />} {specLabel[c] ?? c}</a></td><td class="num">{ss.length}</td><td class="num">{n}</td>
    </tr>; })}
  </table>
  {stdCats.length > 0 && <p>Specs for {stdText} follow published <a href="/rc/standards/">standards</a> ({stdCodes.length}: {stdCodes.slice(0, 4).join(', ')}{stdCodes.length > 4 ? ', ...' : ''}).</p>}
</Base>
