---
import Base from '../../layouts/Base.astro';
import { db, url } from '../../lib/data';
---
<Base title="RC cars" description="RC car brands, kits and parts in Hobbydex.">
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / RC cars</div>
  <h1>RC cars</h1>
  <h2>Brands</h2>
  <ul class="cards">
    {db.brands.map((b) => (
      <li><a href={url.brand(b.id)}><b>{b.name}</b></a><br />
        <span class="muted">{db.kitsByBrand.get(b.id)?.length ?? 0} kits · {db.partsByBrand.get(b.id)?.length ?? 0} parts</span></li>
    ))}
  </ul>
  <p><a href="/rc/compare/">Compare two releases</a> <span class="muted">· what changed between editions, or what two kits share</span></p>
  <h2>Part categories</h2>
  <p>Parts by what they are, from ball ends to wings, with the brands that make them. <a href="/rc/categories/">All categories</a></p>
  <h2>Generic specs</h2>
  <p>Brand-independent <a href="/rc/specs/screw/">screws</a>, <a href="/rc/specs/bearing/">bearings</a>, <a href="/rc/specs/pinion/">pinions</a>, <a href="/rc/specs/battery/">batteries</a>, <a href="/rc/specs/servo/">servos</a>, <a href="/rc/specs/motor/">motors</a> and <a href="/rc/specs/oil/">silicone oils</a>, with the branded parts that match them. <a href="/rc/specs/">All specs</a></p>
  <h2>Kits <span class="muted">· <a href="/rc/kits/">by type</a></span></h2>
  <table>
    <tr><th>Brand</th><th>Kit</th><th>Category</th><th>Scale</th><th>Drive</th><th>Releases</th></tr>
    {db.kits.map((k) => (
      <tr>
        <td><a href={url.brand(k.brand)}>{db.brand.get(k.brand)?.name}</a></td>
        <td><a href={url.kit(k.id)}>{k.name}</a></td>
        <td>{k.category}</td><td>{k.scale}</td><td>{k.drive}</td>
        <td>{(db.releasesByKit.get(k.id) ?? []).map((r, i) => <>{i > 0 && ', '}<a href={url.release(r.id)}>{r.name}</a></>)}</td>
      </tr>
    ))}
  </table>
</Base>
