---
import Base from '../../layouts/Base.astro';
import HideDiscontinued from '../../components/HideDiscontinued.astro';
import { db, url } from '../../lib/data';
---
<Base title="RC cars" description="RC car brands, platforms and parts in Hobbydex.">
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / RC cars</div>
  <h1>RC cars</h1>
  <h2>Browse</h2>
  <ul class="browse">
    <li><a href="/rc/releases/">Releases</a> <span class="muted">· every release, filter by brand, type, scale and year</span></li>
    <li><a href="/rc/platforms/">Platforms</a> <span class="muted">· every chassis and platform, by type</span></li>
    <li><a href="/rc/types/">Car types</a> <span class="muted">· buggies, crawlers, touring cars and more</span></li>
    <li><a href="/rc/makes/">Car makes</a> <span class="muted">· every Porsche, Ford or Toyota across RC brands</span></li>
    <li><a href="/rc/categories/">Part categories</a> <span class="muted">· parts by what they are, from ball ends to wings</span></li>
    <li><a href="/rc/specs/">Generic specs</a> <span class="muted">· brand-independent screws, bearings, pinions, batteries, servos, motors and oils</span></li>
    <li><a href="/rc/servos/">Compare servos</a> <span class="muted">· torque, speed and size side by side</span></li>
    <li><a href="/rc/escs/">Compare ESCs</a> <span class="muted">· current, BEC, plugs and waterproofing side by side</span></li>
    <li><a href="/rc/motors/">Compare motors</a> <span class="muted">· kV, turns, can and shaft side by side</span></li>
    <li><a href="/rc/compare/">Compare two releases</a> <span class="muted">· what changed between editions, or what two platforms share</span></li>
  </ul>
  <h2>Brands</h2>
  {db.brands.some((b) => b.status === 'gone') && <HideDiscontinued />}
  <ul class="cards">
    {db.brands.map((b) => (
      <li data-discontinued={b.status === 'gone' ? '' : undefined}><a href={url.brand(b.id)}><b>{b.name}</b></a><br />
        <span class="muted">{[[db.kitsByBrand.get(b.id)?.length ?? 0, 'platforms'], [db.partsByBrand.get(b.id)?.length ?? 0, 'parts']].filter(([n]) => n).map(([n, w]) => `${n} ${w}`).join(' · ')}</span></li>
    ))}
  </ul>
</Base>
<style>
  .browse { list-style: none; padding: 0; }
  .browse li { margin: 0.4em 0; }
</style>
