---
import Base from '../../../layouts/Base.astro';
import { db } from '../../../lib/data';
import Icon from '../../../components/Icon.astro';
import { kitTypeLabel, kitTypeOrder, kitTypeIcon } from '../../../lib/kitTypes';
const label = kitTypeLabel;
const order = kitTypeOrder;
const byCat = new Map<string, typeof db.kits>();
for (const k of db.kits) {
  const c = k.category || 'car';
  if (!byCat.has(c)) byCat.set(c, []);
  byCat.get(c)!.push(k);
}
// releases of a type on another type's chassis (Tamiya race trucks on the TT-01E kit)
const onOther = new Map<string, typeof db.releases>();
for (const r of db.releases) {
  if (!r.category || r.category === (db.kit.get(r.kit)?.category || 'car')) continue;
  if (!onOther.has(r.category)) onOther.set(r.category, []);
  onOther.get(r.category)!.push(r);
}
const cats = [...new Set([...byCat.keys(), ...onOther.keys()])].sort((a, b) => (order.indexOf(a) + 1 || 99) - (order.indexOf(b) + 1 || 99));
---
<Base title="Platforms by type" description="Every RC platform in Hobbydex, grouped by type and scale.">
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / Platforms</div>
  <h1>Platforms by type</h1>
  <p class="muted">{db.kits.length} platforms · <a href="/rc/platforms/by-date/">by date</a></p>
  <ul class="typegrid">{cats.map((c) => <li><a href={`/rc/platforms/types/${c}/`}><Icon name={kitTypeIcon(c)} size="2rem" /><b>{label[c] ?? c}</b><span class="muted">{byCat.get(c)?.length ?? `${onOther.get(c)!.length} releases`}</span></a></li>)}</ul>
</Base>
