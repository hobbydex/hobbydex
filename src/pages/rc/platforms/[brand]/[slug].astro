---
import { colourDot } from '../../../../lib/colourDot';
import { buildLabel } from '../../../../lib/build';
import ReleaseArt from '../../../../components/ReleaseArt.astro';
import { shownNote, isSourceNote, withoutKnownFromParts } from '../../../../lib/notes';
import SourceNote from '../../../../components/SourceNote.astro';
import FactSource from '../../../../components/FactSource.astro';
import KitSets from '../../../../components/KitSets.astro';
import { paintChip } from '../../../../lib/paintSwatch';
import Base from '../../../../layouts/Base.astro';
import Discontinued from '../../../../components/Discontinued.astro';
import HideDiscontinued from '../../../../components/HideDiscontinued.astro';
import { db, key, url, retiredMoves, brandName, byPartNo, partNo, yearOf, byReleaseDate, conversionsForKit, dateKey as dateKeyOf , yearDoubt, seriesMates, docPage, type Doc, type Part, type Release } from '../../../../lib/data';
import { FILE_KINDS, fileRows, hostLabel, pageLabel, makerOwnLinks } from '../../../../lib/docFacts';
import DateText from '../../../../components/DateText.astro';
import DateDoubt from '../../../../components/DateDoubt.astro';
import DoubtNote from '../../../../components/DoubtNote.astro';
import Icon from '../../../../components/Icon.astro';
import DataLink from '../../../../components/DataLink.astro';
import ColourSwitch from '../../../../components/ColourSwitch.astro';
import { colourwayGroups, colourLabels, groupName, releaseColour } from '../../../../lib/colourways';
import WebSearch from '../../../../components/WebSearch.astro';
import Videos from '../../../../components/Videos.astro';
import FanLinks from '../../../../components/FanLinks.astro';
import { catName } from '../../../../lib/categories';
import { optionFits, byCat, SPLIT_ABOVE, partsUrl } from '../../../../lib/kitFits';
import FitTable from '../../../../components/FitTable.astro';
import '../../../../styles/catgroup.css';
import { kitTypeIcon, kitTypeOne } from '../../../../lib/kitTypes';
import { driveLabel } from '../../../../lib/drive';
import { gearing, type Gearing } from '../../../../lib/gearing';
import { describe, count } from '../../../../lib/descriptions';
import { newestDatedParts, realPartDate } from '../../../../lib/latestParts';
export function getStaticPaths() {
  // a former id (renamed or corrected) keeps working: its page redirects to the current one
  const moved = db.kits.flatMap((x) => (x.former_ids ?? []).map((f) => ({ params: { brand: key(f)[0], slug: key(f)[1] }, props: { redirect: url.platform(x.id) } })));
  const taken = new Set([...db.kits.map((k) => k.id), ...db.kits.flatMap((x) => x.former_ids ?? [])]);
  const gone = retiredMoves('kit', taken).map((m) => ({ params: { brand: key(m.id)[0], slug: key(m.id)[1] }, props: { redirect: m.to } }));
  return [...db.kits.map((k) => ({ params: { brand: key(k.id)[0], slug: key(k.id)[1] }, props: { kit: k } })), ...moved, ...gone];
}
if (Astro.props.redirect) return Astro.redirect(Astro.props.redirect, 301);
const kit = Astro.props.kit!;   // set on every page that is not a redirect
const releases = [...(db.releasesByKit.get(kit.id) ?? [])].sort(byReleaseDate);
// the parts in a release's box: its rows with a part (the release page's In the box count)
const boxCount = (r: Release) => (r.contains ?? []).filter((c) => c.role === 'kit' && db.part.get(c.part)).length;
// one release: its In the box section is the note's link
const only = releases.length === 1 && boxCount(releases[0]) > 0 ? releases[0] : undefined;
// the list: current releases (on sale or announced) first, then the discontinued ones;
// newest first in each, dated before undated (undated ones by item number, higher numbers being newer)
const dateKey = (r: (typeof releases)[number]) => dateKeyOf(r) || (yearOf(r) ? String(yearOf(r)) : '');
const newestFirst = (a: (typeof releases)[number], b: (typeof releases)[number]) =>
  (dateKey(a) ? 0 : 1) - (dateKey(b) ? 0 : 1) || dateKey(b).localeCompare(dateKey(a))
  || (a.number ? 0 : 1) - (b.number ? 0 : 1) || (b.number ?? '').localeCompare(a.number ?? '', undefined, { numeric: true }) || a.name.localeCompare(b.name);
const current = releases.filter((r) => r.status !== 'discontinued').sort(newestFirst);
const discontinued = releases.filter((r) => r.status === 'discontinued').sort(newestFirst);
const show = { number: releases.some((r) => r.number), edition: releases.some((r) => r.edition), surface: releases.some((r) => r.surface),
  status: new Set(current.map((r) => r.status)).size > 1,
  build: releases.some((r) => buildLabel(r.kind, r.power)) };   // the column only when the current releases differ in status
// the compare link takes the two newest dated releases (undated ones sort last)
const dated = releases.filter((r) => r.released || yearOf(r));
const pair = (dated.length >= 2 ? dated : releases).slice(-2);
const { allFits, bearingSets, screwSets, fits } = optionFits(kit);
// the newest option parts with a real date (latestParts.ts), current ones only, one per part
const groups = byCat(fits, (x) => x.part.category);
const split = fits.length > SPLIT_ABOVE;   // a big platform lists only its categories here; each has its own page
const platUrl = url.platform(kit.id);
const numn = Math.max(5, ...fits.map((x) => partNo(x.part).length));
const partTotal = new Set(allFits.map((x) => x.part.id)).size;
const newestParts = newestDatedParts([...new Map(fits.map((x) => [x.part.id, x.part])).values()].filter((p) => p.status !== 'discontinued'), 15);
const relations = db.kitRelations.get(kit.id) ?? [];
// successor links (supersedes): the newer platforms that replace this one, and the older one this one replaces
const replacedByKits = db.kitReplacedBy.get(kit.id) ?? [];
const replacesKit = kit.supersedes ? db.kit.get(kit.supersedes) : undefined;
// car lines (series) this platform's releases belong to that run on other platforms too
const seriesOn = [...new Set(releases.map((r) => r.series).filter((x): x is string => !!x))].map((series) => {
  const others = new Map<string, string>();
  for (const r of releases.filter((x) => x.series === series)) for (const m of seriesMates(r)) if (m.kit !== kit.id) others.set(m.kit, db.kit.get(m.kit)?.name ?? m.kit);
  return { series, others: [...others] };
}).filter((x) => x.others.length > 0);
// parts of interchangeable rebrands, for kits whose own releases list none
const ownParts = releases.reduce((n, r) => n + (r.contains?.length ?? 0), 0);
const borrowed = ownParts > 0 ? [] : relations.filter((r) => r.link.parts === 'interchangeable').flatMap((r) =>
  (db.releasesByKit.get(r.other) ?? []).flatMap((rel) => (rel.contains ?? []).map((c) => ({ c, rel, p: db.part.get(c.part)! })))).filter((x) => x.p);
// stock gearing of the releases, one entry per spur/pinion pair
const gearings = new Map<string, { g: Gearing; rels: typeof releases }>();
for (const r of releases) { const g = gearing(r); if (!g) continue; const k = `${g.zs}/${g.zp}`; if (!gearings.has(k)) gearings.set(k, { g, rels: [] }); gearings.get(k)!.rels.push(r); }
const seen = new Set<string>();
const borrowedUnique = borrowed.filter((x) => !seen.has(x.c.part) && seen.add(x.c.part)).sort((a, b) => byPartNo(a.p, b.p));
const conversions = conversionsForKit(kit.id);
// the maker's videos of the whole kit, then those of its releases
const videos = [...new Set([...(db.videosByKit.get(kit.id) ?? []), ...releases.flatMap((r) => db.videosByRelease.get(r.id) ?? [])])];
// parts listed by dealers for a kit that shares this platform (same_platform_as, either direction): the parts whose fits
// name that kit as a whole or one of its releases, minus those already listed above as fitting this kit
const listedHere = new Set(allFits.map((x) => x.part.id));
const partsWord = { interchangeable: 'interchangeable', partly: 'partly shared', unknown: 'not confirmed' } as const;
const relatedFits = relations.filter((r, i) => r.relation === 'platform' && db.kit.has(r.other) && relations.findIndex((x) => x.other === r.other) === i).map((r) => {
  const o = db.kit.get(r.other)!;
  const relNames = new Map((db.releasesByKit.get(o.id) ?? []).map((x) => [x.id, x.name]));
  const byPart = new Map<string, { part: Part; rels: string[] }>();   // rels: the related kit's releases it is listed for; none for the whole kit
  for (const { part, fit } of db.fitsByKit.get(o.id) ?? []) {
    if (fit.car || listedHere.has(part.id)) continue;
    if (fit.releases && !fit.releases.some((id) => relNames.has(id))) continue;
    const e = byPart.get(part.id) ?? { part, rels: [] };
    for (const id of fit.releases ?? []) if (relNames.has(id) && !e.rels.includes(relNames.get(id)!)) e.rels.push(relNames.get(id)!);
    byPart.set(part.id, e);
  }
  return { o, link: r.link, rows: [...byPart.values()].sort((a, b) => byPartNo(a.part, b.part)) };
}).filter((x) => x.rows.length > 0);
import SeenNote from '../../../../components/SeenNote.astro';
// each document of the releases once, with the releases that have it (a body manual may be the car's alone, a chassis manual shared)
const docRels = new Map<string, Release[]>();
for (const r of releases) for (const id of r.documents ?? []) if (db.doc.get(id)) docRels.set(id, [...(docRels.get(id) ?? []), r]);
const allDocs = [...docRels.keys()].map((id) => db.doc.get(id)!);
// the maker's manuals, parts lists and exploded views, and the supplements, by kind; the product pages are the sources
const fileKinds = { ...FILE_KINDS, supplement: 'Supplement' };
const fileDocs = allDocs.filter((d) => d.page && d.kind in fileKinds);
// the platform's own documents: held by three or more releases, or all of them when the platform has two releases or fewer;
// the rest are on the release pages (a body set's manual is held by the kit and its built XB twin: two)
const own = (d: Doc) => releases.length <= 2 || docRels.get(d.id)!.length > 2;
const files = fileRows(fileDocs.filter(own), fileKinds).map(([label, ds]) => [label, [...ds].sort((a, b) => docRels.get(b.id)!.length - docRels.get(a.id)!.length)] as const);
const moreFiles = fileDocs.length - fileDocs.filter(own).length;
const webLink = (d: Doc) => docPage(d, docRels.get(d.id)?.[0]?.released);
const sources = allDocs.filter((d) => d.kind === 'product_page');
// the product pages of its releases, as the release pages show them (own links, else the product_page documents), once per URL
const productUrls = [...new Set(releases.flatMap((r) => {
  const own = makerOwnLinks(r.links);
  if (own.length > 0) return own.map((l) => l.url);
  return (r.documents ?? []).map((id) => db.doc.get(id)).filter((d): d is Doc => !!d && d.kind === 'product_page')
    .map((d) => docPage(d, r.released)).filter((u): u is string => !!u);
}))];
// the shops' product pages of its releases, shown apart from the maker's
const dealerUrls = [...new Set(releases.flatMap((r) => (r.links ?? []).filter((l) => l.kind === 'dealer').map((l) => l.url)))];
// the search index (Base's hidden block): brand, name, type, scale, and the vehicles its releases depict
const indexWords = [brandName(kit.brand), kit.name, kitTypeOne[kit.category ?? 'car'] ?? kit.category, kit.scale,
  ...releases.flatMap((r) => [r.depicts?.make, r.depicts?.model])].filter(Boolean).join(' ');
// the meta description: its scale, drive and type, the years its releases span, and the parts that fit it
const years = releases.map((r) => yearOf(r)).filter((y) => y > 0);
const partCount = new Set(allFits.map((x) => x.part.id)).size;
const metaDescription = describe(`${brandName(kit.brand)} ${kit.name}`,
  [[kit.scale, driveLabel(kit.drive), kitTypeOne[kit.category ?? 'car'] ?? kit.category, 'platform'].filter(Boolean).join(' '),
    releases.length > 0 && (years.length ? `${count(releases.length, 'release')} from ${Math.min(...years)} to ${Math.max(...years)}` : count(releases.length, 'release')),
    partCount > 0 && `${count(partCount, 'part')}`].filter((x): x is string => !!x));
const indexFilters = kit.drive ? [`drive:${driveLabel(kit.drive)}`] : [];
// a platform with no release, named only by parts that fit it: the label gives the count of those parts (the parts list below)
const knownFromParts = releases.length === 0 ? partCount : 0;
const notesText = knownFromParts > 0 ? withoutKnownFromParts(kit.notes) : kit.notes;
---
<Base title={`${brandName(kit.brand)} ${kit.name} ${kitTypeOne[kit.category ?? 'car'] ?? kit.category} platform`} description={metaDescription} kind="platform" sub={brandName(kit.brand)} words={indexWords} filters={indexFilters}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href={url.brand(kit.brand)}>{brandName(kit.brand)}</a> / {kit.name}</div>
  <p class="pagetype">Platform</p>
  <h1>{brandName(kit.brand)} {kit.name}</h1>
  {knownFromParts > 0 && <p class="pagenote"><span class="badge">Known from parts only</span> <span class="muted">named by {knownFromParts} <a href="#option-parts">{knownFromParts === 1 ? 'part' : 'parts'}</a>; no release of it in our data yet</span></p>}
  {releases.length > 0 && (only ? <p class="muted pagenote">What's in the box: <a href={`${url.release(only.id)}#kit`}>{only.name} ({boxCount(only)} parts)</a> →</p>
    : <p class="muted pagenote">A platform groups the releases built on one chassis. What's in the box is on each release page, listed below.</p>)}
  {kit.sources?.name && <p><FactSource field="name" url={kit.sources.name} dot={false} /></p>}
  <WebSearch query={`${brandName(kit.brand)} ${kit.name}`} links={kit.links} />
  <div class="factsrow">
  <dl class="facts">
    <dt>Category</dt><dd><a href={`/rc/platforms/types/${kit.category || 'car'}/`}>{kitTypeOne[kit.category ?? 'car'] ?? kit.category}</a>{isSourceNote(kit.notes) && <> <SourceNote text={kit.notes!} /></>}{kit.sources?.category && <FactSource field="category" url={kit.sources.category} />}</dd>
    {kit.scale && <><dt>Scale</dt><dd>{kit.scale}{kit.sources?.scale && <FactSource field="scale" url={kit.sources.scale} />}</dd></>}
    {kit.drive && <><dt>Drive</dt><dd>{driveLabel(kit.drive)}</dd></>}
    {kit.power && <><dt>Power</dt><dd>{kit.power}</dd></>}
    {replacesKit && <><dt>Replaces</dt><dd><a href={url.platform(replacesKit.id)}>{brandName(replacesKit.brand)} {replacesKit.name}</a></dd></>}
    {replacedByKits.length > 0 && <><dt>Replaced by</dt><dd>{replacedByKits.map((o, i) => <>{i > 0 && <br />}<a href={url.platform(o.id)}>{brandName(o.brand)} {o.name}</a></>)}</dd></>}
    {dealerUrls.length > 0 && <><dt class="muted">Dealer page</dt><dd>{dealerUrls.length <= 3
      ? dealerUrls.map((u, i) => <>{i > 0 && ' · '}<a href={u} rel="nofollow noopener" target="_blank">{hostLabel(u)}</a></>)
      : `${dealerUrls.length} dealer pages`}</dd></>}
    {productUrls.length > 0 && <><dt>Product page</dt><dd>{productUrls.length <= 3
      ? productUrls.map((u, i) => <>{i > 0 && ' · '}<a href={u} rel="nofollow noopener" target="_blank">{productUrls.length > 1 ? pageLabel(u) : hostLabel(u)}</a></>)
      : sources.length > 0 ? <a href="#sources">{productUrls.length} product pages</a> : `${productUrls.length} product pages`}</dd></>}
  </dl>
    <span class="typeicon" title={kitTypeOne[kit.category ?? 'car'] ?? kit.category}>{kit.art ? <ReleaseArt id={kit.id} category={kit.category} kitArt={kit.art} size="5rem" /> : <Icon name={kitTypeIcon(kit.category)} label={kitTypeOne[kit.category ?? 'car'] ?? kit.category} size="5rem" />}</span>
  </div>
  <h2 id="releases">Releases</h2>
  {current.length > 0 && discontinued.length > 0 && <HideDiscontinued />}
  {(() => {
    // one table: current releases first, then the discontinued ones; unchecking "Show discontinued" hides those rows,
    // unless every release is discontinued: then there is no toggle and the rows always show
    const rows = [...current, ...discontinued];
    // a colourway group (the same car in several colours, lib/colourways.ts) is one row, at its first release's place
    const groups = colourwayGroups(rows);
    const once = [...new Set(rows.map((r) => groups.find((g) => g.includes(r))!))];
    return <>
      {rows.length === 0 && <p class="muted">No releases of this platform in our data yet.</p>}
      {rows.length > 0 && current.length === 0 && <p class="muted">Every release is discontinued.</p>}
      {rows.length > 0 && <table class="releases">
        <tr><th class="num">Year</th><th>Release</th>{show.number && <th class="num">Item no.</th>}{show.build && <th>Build</th>}{show.edition && <th>Edition</th>}{show.surface && <th>Surface</th>}{show.status && <th>Status</th>}</tr>
        {once.map((g) => { const head = rows.find((x) => g.includes(x))!; const multi = g.length > 1; const labels = colourLabels(g);
          const earliest = [...g].sort(byReleaseDate)[0];
          return <tr data-discontinued={head.status === 'discontinued' && current.length > 0 ? '' : undefined}>
          <td class="num" data-label="Year"><DateText r={earliest} year /><DateDoubt reason={yearDoubt(earliest)} /></td><td class="name"><ReleaseArt id={head.id} category={head.category ?? kit.category} color={multi ? undefined : releaseColour(head)} art={head.art} size="1.3em" class="inrow" /> <a href={url.release(head.id)}>{multi ? groupName(g) : head.name}</a><Discontinued item={head} />{multi && <ColourSwitch label="Colours of this release" size="inline" items={g.map((x, i) => ({ id: x.id, number: x.number, colour: labels[i], text: x.livery, current: false, href: url.release(x.id) }))} />}</td>{show.number && <td class="num" data-label="Item no.">{g.map((x) => x.number ?? '').filter(Boolean).join(', ')}</td>}{show.build && <td data-label="Build">{buildLabel(head.kind, head.power)}</td>}{show.edition && <td data-label="Edition">{head.edition ?? ''}</td>}{show.surface && <td data-label="Surface">{(head.surface ?? []).join(', ')}</td>}{show.status && <td data-label="Status" class="muted">{head.status === 'discontinued' ? '' : head.status}</td>}
        </tr>; })}
      </table>}
  <SeenNote rows={releases} />
  <DoubtNote on={releases.some((r) => !!yearDoubt(r))} /></>;
  })()}
  {(fits.length > 0 || bearingSets.length > 0 || screwSets.length > 0) && <p class="partsummary" data-pagefind-ignore>
    <a href="#option-parts"><strong>{count(partTotal, 'option part')}</strong></a> listed as fitting
    {groups.length > 1 && <>: {groups.map(({ g, rows }, i) => <>{i > 0 && ' · '}<a href={split ? partsUrl(platUrl, g) : `#cat-${g || 'other'}`}>{g ? catName(g) : 'Other'}</a> ({rows.length})</>)}</>}
    {(bearingSets.length > 0 || screwSets.length > 0) && <span class="muted"> · plus {count(bearingSets.length + screwSets.length, 'bearing and screw set')} from other makers</span>}</p>}
  <Videos videos={videos} />
  <FanLinks links={kit.links} />
  {notesText && !isSourceNote(notesText) && <p class="muted">{notesText}</p>}
  {seriesOn.map((x) => <p>Also in the {x.series} series on: {x.others.map(([id, name], i) => <>{i > 0 && ' · '}<a href={url.platform(id)}>{name}</a></>)}</p>)}
  {relations.length > 0 && <>
    <h2>Same car or platform</h2>
    <ul>
      {relations.map((r) => { const o = db.kit.get(r.other); const label = r.relation === 'rebrand' ? (r.reverse ? 'Also sold as' : 'Rebrand of') : 'Shares its platform with'; return <li>
        {label} <a href={url.platform(r.other)}>{o ? `${brandName(o.brand)} ${o.name}` : r.other}</a>
        {r.link.parts && <span class="muted"> · parts {r.link.parts}</span>}{r.link.notes && <span class="muted"> · {r.link.notes}</span>}
      </li>; })}
    </ul></>}
  {(files.length > 0 || moreFiles > 0) && <>
    <h2>Manuals and parts lists</h2>
    {files.map(([label, ds]) => <><h3>{label}</h3>
      <ul>{ds.map((d) => { const n = docRels.get(d.id)!.length; return <li><a href={d.page} rel="nofollow">{d.title}</a>{n < releases.length && <span class="muted"> ({n} of {releases.length} releases)</span>}</li>; })}</ul></>)}
    {moreFiles > 0 && <p class="muted">{moreFiles} more on the release pages</p>}</>}
  {conversions.length > 0 && <><h2>Conversion kits for this car <span class="muted">({conversions.length})</span></h2>
    <ul>{conversions.map((c) => <li><a href={url.release(c.id)}>{brandName(c.brand)} {c.name}</a><Discontinued item={c} />{c.number && <span class="muted"> {c.number}</span>}</li>)}</ul></>}
  {gearings.size > 0 && <section data-pagefind-ignore>
    <h2>Stock gearing</h2>
    {[...gearings.values()].map(({ g, rels }) => <div class="gearing">
      <span set:html={g.svg} />
      <p><span class="ratio">{g.ratio.toFixed(2)} : 1</span><br />
        <a href={url.part(g.spur.id)}>{g.zs}T spur</a> / <a href={url.part(g.pinion.id)}>{g.zp}T pinion</a>{g.pitch && <span class="muted"> · {g.pitch}</span>}<br />
        <span class="muted">{rels.length === releases.length ? (releases.length > 1 ? 'Every release' : 'In the box') : rels.map((r, i) => <>{i > 0 && ', '}<a href={url.release(r.id)}>{r.name}</a><Discontinued item={r} /></>)}</span></p>
    </div>)}
    <p class="muted">Spur/pinion ratio of the gears in the box. The transmission's internal ratio is not in our data, so this is not the final drive ratio.</p></section>}
  {pair.length > 1 && <p><a href={`/rc/compare/?a=${encodeURIComponent(pair[0].id)}&b=${encodeURIComponent(pair[1].id)}`}>Compare the last two releases</a> <span class="muted">or any two releases on the compare page</span></p>}
  {borrowedUnique.length > 0 && <section data-pagefind-ignore>
    <h2>Parts, from the interchangeable rebrand <span class="muted">({borrowedUnique.length})</span></h2>
    <p class="muted">No parts list for this platform itself; these come from the rebrand above, whose parts interchange.</p>
    {byCat(borrowedUnique, (x) => x.p.category).map(({ g, rows }) => <div class="catgroup">
      <h3>{g && <Icon name={g} />} {g ? catName(g) : 'Other'} <span class="muted">({rows.length})</span></h3>
      <table>
        <tr><th class="num numcol" style={`--numn:${Math.max(5, ...borrowedUnique.map((x) => partNo(x.p).length))}`}>Number</th><th>Name</th><th class="w-brand">Brand</th><th class="w-from">From</th></tr>
        {rows.map(({ rel, p }) => <tr data-discontinued={p.status === 'discontinued' ? '' : undefined}><td class="num">{p.number && <a href={url.part(p.id)}>{p.number}</a>}</td><td><Fragment set:html={p.category === 'paint' ? (paintChip(p, 14, 'circle') ?? '') : colourDot(p.color)} />{p.number ? p.name : <a href={url.part(p.id)}>{p.name}</a>}<Discontinued item={p} /></td><td>{brandName(p.brand)}</td><td><a href={url.release(rel.id)}>{rel.name}</a><Discontinued item={rel} /></td></tr>)}
      </table></div>)}
  </section>}
  {newestParts.length > 0 && <section class="newest-parts" data-pagefind-ignore>
    <h2>Newest parts for this platform</h2>
    <table>
      <tr><th class="num">Date</th><th class="w-brand">Brand</th><th>Item</th></tr>
      {newestParts.map((p) => <tr><td class="num" data-label="Date"><DateText r={p} /></td><td data-label="Brand">{brandName(p.brand)}</td><td data-label="Item"><a href={url.part(p.id)}>{p.name}</a></td></tr>)}
    </table>
    {!split && <p class="muted"><a href="#option-parts" data-sort-date>Show all option parts, newest first</a></p>}
  </section>}
  {(fits.length > 0 || bearingSets.length > 0 || screwSets.length > 0) && <section id="option-parts" data-pagefind-ignore>
    <h2>Option parts listed as fitting <span class="muted">({new Set(fits.map((x) => x.part.id)).size})</span></h2>
    {fits.some((x) => x.part.status === 'discontinued') && <HideDiscontinued />}
    {fits.length > 1 && !split && <label class="sortparts">Sort <select data-part-sort><option value="number">By part number</option><option value="date">Newest first</option></select></label>}
    <KitSets rows={bearingSets} kind="bearing kit" kitName={kit.name} />
    <KitSets rows={screwSets} kind="screw kit" kitName={kit.name} />
    {groups.length > 0 && !split && groups.map(({ g, rows }) => <details class="catgroup" id={`cat-${g || 'other'}`}>
      <summary><h3>{g && <Icon name={g} />} {g ? catName(g) : 'Other'} <span class="muted">({rows.length})</span></h3></summary>
      <FitTable rows={rows} {numn} />
    </details>)}
    {split && <ul class="catlinks">{groups.map(({ g, rows }) => <li><a href={partsUrl(platUrl, g)}>{g && <Icon name={g} />} {g ? catName(g) : 'Other'}</a> <span class="muted">({rows.length})</span></li>)}</ul>}
  </section>}
  {relatedFits.map(({ o, link, rows }) => <details class="kitsets relatedfits" data-pagefind-ignore>
    <summary>Listed for the related {brandName(o.brand)} {o.name} <span class="muted">({rows.length})</span></summary>
    <p class="muted">Listed by dealers for the {brandName(o.brand)} {o.name}; parts {partsWord[link.parts ?? 'unknown']} with this platform</p>
    {byCat(rows, (x) => x.part.category).map(({ g, rows: grp }) => <div class="relatedgroup">
      <h3>{g && <Icon name={g} />} {g ? catName(g) : 'Other'} <span class="muted">({grp.length})</span></h3>
      <table class="stacked">
        <tr><th class="num numcol" style={`--numn:${Math.max(5, ...rows.map((x) => partNo(x.part).length))}`}>Number</th><th>Name</th><th class="w-brand">Brand</th><th class="w-fit">Listed for</th></tr>
        {grp.map(({ part, rels }) => <tr data-discontinued={part.status === 'discontinued' ? '' : undefined}><td class="num">{part.number && <a href={url.part(part.id)}>{part.number}</a>}</td><td><Fragment set:html={part.category === 'paint' ? (paintChip(part, 14, 'circle') ?? '') : colourDot(part.color)} />{part.number ? part.name : <a href={url.part(part.id)}>{part.name}</a>}<Discontinued item={part} /></td><td data-label="Brand">{brandName(part.brand)}</td><td data-label="Listed for">{rels.length > 0 ? rels.join(', ') : `Whole ${o.name}`}</td></tr>)}
      </table></div>)}
  </details>)}
  {sources.length > 0 && <><h2>Sources <span class="muted">({sources.length})</span></h2>
    <details class="sheets" id="sources"><summary class="muted">{sources.length === 1 ? "the source" : "all sources"}</summary><ul>{sources.map((d) => <li>{webLink(d) ? <a href={webLink(d)} rel="nofollow">{d.title}</a> : d.title}{d.date && <span class="muted"> · {d.date}</span>}</li>)}</ul></details></>}
  <script>
    // the option parts list: by part number (as built), or newest first within each category; the newest block's
    // "Show all" link switches to newest first
    const section = document.getElementById('option-parts');
    const sel = section?.querySelector<HTMLSelectElement>('select[data-part-sort]');
    const sortBy = (mode: string) => {
      for (const table of section?.querySelectorAll<HTMLTableElement>('.catgroup table') ?? []) {
        const rows = [...table.querySelectorAll<HTMLTableRowElement>('tr[data-order]')];
        rows.sort((a, b) => (mode === 'date' ? (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '') : 0)
          || Number(a.dataset.order) - Number(b.dataset.order));
        for (const r of rows) table.append(r);
      }
      if (sel) sel.value = mode;
    };
    // a category chip (#cat-...) opens its closed section
    const openHash = () => { const el = document.getElementById(decodeURIComponent(location.hash.slice(1))); if (el instanceof HTMLDetailsElement) el.open = true; };
    openHash(); addEventListener('hashchange', openHash);
    sel?.addEventListener('change', () => sortBy(sel.value));
    document.querySelector<HTMLAnchorElement>('a[data-sort-date]')?.addEventListener('click', () => sortBy('date'));
  </script>
  <style>
    .gearing { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; margin: 0.5rem 0; }
    .gearing p { margin: 0; flex: 1 1 14rem; }
    .gearing .ratio { font-size: 1.25rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .gearing :global(svg) { display: block; max-width: 100%; height: auto; }
    table.releases .colourswitch { margin: 0.25rem 0 0; }
    table.releases .colourswitch a.swatch { width: 1.3rem; height: 1.3rem; }
  </style>
  <DataLink path={kit.toml_path} id={kit.id} />
</Base>
