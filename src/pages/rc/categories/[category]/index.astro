---
import Base from '../../../../layouts/Base.astro';
import PartTable from '../../../../components/PartTable.astro';
import { db, brandName, key } from '../../../../lib/data';
import { catName } from '../../../../lib/categories';
import CategoryExplorer from '../../../../components/CategoryExplorer.astro';
import Icon from '../../../../components/Icon.astro';
import { byCategory, categories, countOf, specFor, BIG } from '../../../../lib/categoryIndex';
import { columns } from '../../../../lib/categoryColumns';
import { MOTOR_SPEED_NOTE, BATTERY_NOTE } from '../../../../lib/specs';
export function getStaticPaths() {
  // a former category id (a category split or renamed) keeps working: its page redirects to the current one
  const moved = db.categories.flatMap((c) => (c.former_ids ?? []).map((f) => ({ params: { category: f.split('/')[1] }, props: { redirect: `/rc/categories/${c.id.split('/')[1]}/` } })));
  return [...categories.map((category) => ({ params: { category } })), ...moved];
}
const { category } = Astro.params;
const { redirect } = Astro.props as { redirect?: string };
if (redirect) return Astro.redirect(redirect, 301);
const brands = [...byCategory.get(category)!.entries()].sort((a, b) => brandName(a[0]).localeCompare(brandName(b[0])));
const parts = brands.flatMap(([, ps]) => ps);
// A category above BIG parts is not one plain table (bearings alone are 12,000 rows and 9 MB): the page holds the
// first rows and the filters, and the script loads the rest from parts.json.
const big = parts.length > BIG;
const table = !!columns[category] && parts.length <= BIG;
const byCount = [...brands].sort((a, b) => b[1].length - a[1].length);
const info = db.categories.find((c) => c.id === `category/${category}`);
---
<Base title={catName(category)} description={`${catName(category)}: ${countOf(category)} RC parts from ${brands.length} brands${table || (big && columns[category]) ? ', with their key specs' : ''}.`} kind="category" words={[catName(category), info?.summary].filter(Boolean).join(' ')}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href="/rc/categories/">Categories</a> / {catName(category)}</div>
  <h1><Icon name={category} size="1.4em" /> {catName(category)}</h1>
  {info?.description && <p>{info.description}</p>}
  {category === 'motor' && <details class="muted"><summary>What kV and turns mean</summary>{MOTOR_SPEED_NOTE.map((t) => <p>{t}</p>)}</details>}
  {category === 'battery' && <details class="muted"><summary>Batteries explained: cells, voltage, C-rating, LiFe, charging and storing</summary>{BATTERY_NOTE.map(([h, t]) => <p><b>{h}.</b> {t}</p>)}</details>}
  {info?.terms && <details class="muted"><summary>Terms explained</summary><dl class="terms">{info.terms.map((t) => <><dt>{t.term}</dt><dd>{t.text}</dd></>)}</dl></details>}
  <p class="muted">{countOf(category)} parts from {brands.length} brands.
    {specFor[category] && <> Brand-independent sizes: <a href={`/rc/specs/${specFor[category]}/`}>generic specs</a>.</>}
    {' '}<a href={`/search/?category=${encodeURIComponent(catName(category))}`}>Search in this category</a>
    {category === 'esc' && <> · <a href="/rc/escs/">Compare ESCs</a></>}{category === 'motor' && <> · <a href="/rc/motors/">Compare motors</a></>}</p>
  {!big
    ? <p class="muted">By brand: {brands.map(([b, ps], i) => <>{i > 0 && ' · '}<a href={`/rc/categories/${category}/${key(b)[0]}/`}>{brandName(b)}</a> {ps.length}</>)}</p>
    : <details class="muted"><summary>Brand pages ({brands.length})</summary><p>{byCount.map(([b, ps], i) => <>{i > 0 && ' · '}<a href={`/rc/categories/${category}/${key(b)[0]}/`}>{brandName(b)}</a> {ps.length}</>)}</p></details>}
  {big && <CategoryExplorer category={category} parts={parts} />}
  {table && <PartTable category={category} parts={parts} />}
</Base>
<style>
  dl.terms { margin: 0.5rem 0 0; }
  dl.terms dt { font-weight: 600; margin-top: 0.8rem; }
  dl.terms dd { margin: 0.15rem 0 0; }
</style>
