---
import { colourDot } from '../../../../lib/colourDot';
import { paintChip } from '../../../../lib/paintSwatch';
import Base from '../../../../layouts/Base.astro';
import Discontinued from '../../../../components/Discontinued.astro';
import PartTable from '../../../../components/PartTable.astro';
import { db, brandName, byPartNo, key, url } from '../../../../lib/data';
import { catName } from '../../../../lib/categories';
import { byCategory, categories } from '../../../../lib/categoryIndex';
import { columns } from '../../../../lib/categoryColumns';
export function getStaticPaths() {
  return categories.flatMap((category) => [...byCategory.get(category)!.keys()].map((b) => ({ params: { category, brand: key(b)[0] }, props: { brandId: b } })));
}
const { category } = Astro.params;
const { brandId } = Astro.props;
const parts = [...byCategory.get(category)!.get(brandId)!].sort(byPartNo);
---
<Base title={`${brandName(brandId)} ${catName(category).toLowerCase()}`} description={`${parts.length} ${catName(category).toLowerCase()} from ${brandName(brandId)}.`}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href="/rc/categories/">Categories</a> / <a href={`/rc/categories/${category}/`}>{catName(category)}</a> / {brandName(brandId)}</div>
  <h1>{brandName(brandId)} <span class="muted">·</span> {catName(category)}</h1>
  {columns[category] ? <PartTable category={category} parts={parts} showBrand={false} /> :
  <table>
    <tr><th>Part</th><th>Name</th><th class="num">Releases</th></tr>
    {parts.map((p) => <tr><td>{p.number && <a href={url.part(p.id)}>{p.number}</a>}</td><td><Fragment set:html={p.category === 'paint' ? (paintChip(p, 14, 'circle') ?? '') : colourDot(p.color)} />{p.number ? p.name : <a href={url.part(p.id)}>{p.name}</a>}<Discontinued item={p} /></td><td class="num">{new Set((db.usesByPart.get(p.id) ?? []).map((u) => u.release.id)).size || ''}</td></tr>)}
  </table>}
</Base>
