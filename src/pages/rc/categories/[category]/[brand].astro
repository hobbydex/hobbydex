---
import { colourDot } from '../../../../lib/colourDot';
import { paintChip } from '../../../../lib/paintSwatch';
import Base from '../../../../layouts/Base.astro';
import Discontinued from '../../../../components/Discontinued.astro';
import PartTable from '../../../../components/PartTable.astro';
import { db, brandName, byPartNo, key, url } from '../../../../lib/data';
import { catName } from '../../../../lib/categories';
import { byCategory, categories } from '../../../../lib/categoryIndex';
import { columns } from '../../../../lib/categoryColumns';
import { describe, count } from '../../../../lib/descriptions';
import { categoryBrandMoves } from '../../../../lib/emptied-moves';
export function getStaticPaths() {
  const pages = categories.flatMap((category) => [...byCategory.get(category)!.keys()].map((b) => ({ params: { category, brand: key(b)[0] }, props: { brandId: b } })));
  // an emptied category x brand page (its parts moved or were reclassified) answers 301 to the page that replaces it
  const live = new Set(pages.map((x) => `${x.params.category}/${x.params.brand}`));
  const moved = Object.entries(categoryBrandMoves).filter(([from]) => !live.has(from) && !from.startsWith('uncategorised/'))
    .map(([from, to]) => { const [category, brand] = from.split('/') as [string, string]; return { params: { category, brand }, props: { redirect: to } }; });
  return [...pages, ...moved];
}
const { category } = Astro.params as { category: string };
const { redirect } = Astro.props as { redirect?: string };
if (redirect) return Astro.redirect(redirect, 301);
const { brandId } = Astro.props as { brandId: string };
const parts = [...byCategory.get(category)!.get(brandId)!].sort(byPartNo);
const platforms = new Set(parts.flatMap((p) => (p.fits ?? []).map((f) => f.kit))).size;
const metaDescription = describe(`${brandName(brandId)} ${catName(category).toLowerCase()}`, [count(parts.length, 'part'), platforms > 0 && `${count(platforms, 'platform')} fitted`].filter((x): x is string => !!x));
---
<Base title={`${brandName(brandId)} ${catName(category).toLowerCase()}`} description={metaDescription} kind="category" words={`${brandName(brandId)} ${catName(category)}`}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href="/rc/categories/">Categories</a> / <a href={`/rc/categories/${category}/`}>{catName(category)}</a> / {brandName(brandId)}</div>
  <h1>{brandName(brandId)} <span class="muted">·</span> {catName(category)}</h1>
  {columns[category] ? <PartTable category={category} parts={parts} showBrand={false} /> :
  <table>
    <tr><th>Part</th><th>Name</th><th class="num">Releases</th></tr>
    {parts.map((p) => <tr><td>{p.number && <a href={url.part(p.id)}>{p.number}</a>}</td><td><Fragment set:html={p.category === 'paint' ? (paintChip(p, 14, 'circle') ?? '') : colourDot(p.color)} />{p.number ? p.name : <a href={url.part(p.id)}>{p.name}</a>}<Discontinued item={p} /></td><td class="num">{new Set((db.usesByPart.get(p.id) ?? []).map((u) => u.release.id)).size || ''}</td></tr>)}
  </table>}
</Base>
