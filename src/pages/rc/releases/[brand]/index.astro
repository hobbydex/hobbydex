---
import Base from '../../../../layouts/Base.astro';
import { db, url, key, brandName, yearOf, yearText } from '../../../../lib/data';
// one brand's releases, newest first (unknown years last), sortable by any column
export function getStaticPaths() {
  return [...new Set(db.releases.map((r) => r.brand))].map((b) => ({ params: { brand: key(b)[0] }, props: { brand: b } }));
}
const { brand } = Astro.props as { brand: string };
const releases = db.releases.filter((r) => r.brand === brand)
  .sort((a, b) => (yearOf(b) || -1) - (yearOf(a) || -1) || a.name.localeCompare(b.name));
const kitName = (id: string) => db.kit.get(id)?.name ?? '';
---
<Base title={`${brandName(brand)} releases`} description={`Every ${brandName(brand)} kit and RTR release in Hobbydex, newest first.`}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href="/rc/releases/">Releases</a> / {brandName(brand)}</div>
  <h1>{brandName(brand)} releases</h1>
  <p class="muted">{releases.length} releases, newest first; click a heading to sort. The brand's kits and parts are on <a href={url.brand(brand)}>its brand page</a>.</p>
  <table class="sortable">
    <thead><tr><th class="num">Year</th><th>Release</th><th>Kit</th><th class="num">Item no.</th><th>Kind</th><th class="num">Parts</th></tr></thead>
    <tbody>{releases.map((r) => <tr>
      <td class="num">{yearText(r)}</td><td><a href={url.release(r.id)}>{r.name}</a></td><td><a href={url.kit(r.kit)}>{kitName(r.kit)}</a></td>
      <td class="num">{r.number ?? ''}</td><td>{r.kind}</td><td class="num">{r.contains?.length ?? 0}</td>
    </tr>)}</tbody>
  </table>
  <script src="/sort-table.js" defer></script>
</Base>
