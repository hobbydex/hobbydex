---
import WebSearch from '../../../../components/WebSearch.astro';
import Base from '../../../../layouts/Base.astro';
import { db, key, url, brandName, yearOf, yearText, dateText } from '../../../../lib/data';
import { catName } from '../../../../lib/categories';
import Icon from '../../../../components/Icon.astro';
import { kitTypeIcon, kitTypeOne } from '../../../../lib/kitTypes';
import { bearingList } from '../../../../lib/bearingList';
export function getStaticPaths() {
  return db.releases.map((r) => ({ params: { brand: key(r.id)[0], key: key(r.id)[1] }, props: { release: r } }));
}
const { release } = Astro.props;
const kit = db.kit.get(release.kit)!;
const docs = (release.documents ?? []).map((d) => db.doc.get(d)).filter((d) => d !== undefined);
const rows = (release.contains ?? []).map((c) => ({ ...c, p: db.part.get(c.part)! })).filter((c) => c.p);
const section = (role: string) => rows.filter((c) => c.role === role).sort((a, b) => a.p.number.localeCompare(b.p.number));
const hasSplit = rows.some((c) => c.role !== 'listed');
const hasQty = rows.some((c) => c.qty !== undefined);
const hasStep = rows.some((c) => c.step !== undefined);
const cats = [...new Set(rows.map((c) => c.p.category).filter((c): c is string => !!c))].sort((a, b) => catName(a).localeCompare(catName(b)));
const related = (db.kitRelations.get(kit.id) ?? []).map((r) => ({ ...r, k: db.kit.get(r.other) })).filter((r) => r.k);
const bearings = bearingList(release);
const copyText = bearings ? bearings.lines.map((l) => `${l.qty !== undefined ? `${l.qty}x ` : ''}${l.name}`).join('\n') : '';
const sections: [string, string][] = [['kit', 'In the box'], ['option', 'Option and upgrade parts'], ['listed', hasSplit ? 'Also listed for this release' : 'Spare parts list']];
---
<Base title={`${brandName(release.brand)} ${release.name}`} description={`${brandName(release.brand)} ${release.name} (${release.year}): parts list and options.`} kind="release" sub={`${brandName(release.brand)} · ${release.year}`}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href={url.brand(release.brand)}>{brandName(release.brand)}</a> / <a href={url.kit(kit.id)}>{kit.name}</a> / {release.name}</div>
  <h1 data-pagefind-meta="title" data-pagefind-weight="10" data-pagefind-sort="title">{brandName(release.brand)} {release.name}</h1>
  <WebSearch query={release.number ? `"${release.number}" ${brandName(release.brand)}` : `${brandName(release.brand)} ${release.name}`} copy={release.number} copyLabel="Copy item number" links={release.links} />
  <div class="factsrow">
  <dl class="facts">
    <dt>Kit</dt><dd><a href={url.kit(kit.id)}>{kit.name}</a></dd>
    {kit.scale && <><dt>Scale</dt><dd>{kit.scale}</dd></>}
    {(kit.category || kit.drive || kit.power) && <><dt>Type</dt><dd>{[kit.category, kit.drive, kit.power].filter(Boolean).join(' · ')}</dd></>}
    {related.length > 0 && <><dt>Related</dt><dd>{related.map((r, i) => <>{i > 0 && ' · '}<a href={url.kit(r.k!.id)}>{brandName(r.k!.brand)} {r.k!.name}</a> <span class="muted">({r.relation === 'rebrand' ? 'rebrand' : 'same platform'}{r.link.parts ? `, parts ${r.link.parts}` : ''})</span></>)}</dd></>}
    {release.number && <><dt>Item number</dt><dd>{release.number}</dd></>}
    {release.released ? <><dt>Released</dt><dd>{dateText(release)}</dd></> : <><dt>Year</dt><dd>{yearText(release)}</dd></>}
    {release.edition && <><dt>Edition</dt><dd>{release.edition}</dd></>}
    <dt>Kind</dt><dd>{release.kind}</dd>
    <dt>Status</dt><dd>{release.status}</dd>
  </dl>
    <a class="typeicon" href={`/rc/kits/types/${kit.category || 'car'}/`} title={kitTypeOne[kit.category ?? 'car'] ?? kit.category}><Icon name={kitTypeIcon(kit.category)} size="5rem" /></a>
  </div>
  {docs.length > 0 && <><h2>Sources</h2>
    {docs.length <= 4 || new Set(docs.map((d) => d.url)).size === docs.length
      ? <ul>{docs.map((d) => <li>{d.url ? <a href={d.url} rel="nofollow">{d.title}</a> : d.title}{d.version && <span class="muted"> · {d.version}</span>}{d.date && <span class="muted"> · {d.date}</span>}</li>)}</ul>
      : <ul>{[...new Set(docs.map((d) => d.url ?? ''))].map((u) => { const ds = docs.filter((d) => (d.url ?? '') === u); return <li>
          {u ? <a href={u} rel="nofollow">{new URL(u).hostname}{new URL(u).pathname.length > 1 ? new URL(u).pathname : ''}</a> : 'Documents'} <span class="muted">· {ds.length} documents</span>
          <details><summary class="muted">list</summary><ul>{ds.map((d) => <li>{d.title}{d.date && <span class="muted"> · {d.date}</span>}</li>)}</ul></details>
        </li>; })}</ul>}
    <p><a href={`/rc/compare/?a=${encodeURIComponent(release.id)}`}>Compare with another release</a></p></>}
  {bearings && <>
    <h2>Bearings <span class="muted">({bearings.lines.length} {bearings.lines.length === 1 ? 'size' : 'sizes'})</span></h2>
    <p class="muted">{bearings.counted ? 'Counts per car, from the build manual.' : 'Sizes of the bearings in the box; the count per car is not in our source for this release.'}{bearings.lines.some((l) => l.bushing) && ' A bushing is listed with the ball bearing that replaces it.'}</p>
    <table>
      <tr><th>Size</th>{bearings.counted && <th class="num">Qty</th>}<th>Parts</th></tr>
      {bearings.lines.map((l) => <tr><td><a href={url.spec(l.spec)}>{l.name}</a></td>{bearings.counted && <td class="num">{l.qty}</td>}<td>{l.parts.map((p, i) => <>{i > 0 && ', '}<a href={url.part(p.id)}>{p.number}</a></>)}{l.bushing && <span class="muted"> · bushing in the kit</span>}</td></tr>)}
    </table>
    {bearings.unsized.length > 0 && <p class="muted">Also {bearings.unsized.length} bearing {bearings.unsized.length === 1 ? 'part' : 'parts'} of unknown size: {bearings.unsized.map((p, i) => <>{i > 0 && ', '}<a href={url.part(p.id)}>{p.number}</a></>)}.</p>}
    <p><button type="button" class="copybtn" data-copy={copyText}>Copy bearing list</button></p>
    <script>
      for (const b of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy bearing list'), 1500); } catch {}
      });
    </script></>}
  {hasQty && <p class="muted">Quantities are per car, read from the build manual's steps; Pack is how many pieces one part number buys.</p>}
  {!hasSplit && rows.length > 0 && <p class="muted">The manufacturer's parts list for this release does not say which parts come in the box and which are options; it is one flat list. That split needs the build manual, which has not been imported yet.</p>}
  {cats.length > 1 && <p data-pagefind-ignore><label>Show <select id="catfilter"><option value="">all categories</option>{cats.map((c) => <option value={c}>{catName(c)}</option>)}</select></label></p>}
  {sections.map(([role, label]) => { const s = section(role); return s.length > 0 && <>
    <h2>{label} <span class="muted">({s.length})</span></h2>
    <table>
      <tr><th class="num">Number</th><th>Name</th><th>Category</th>{hasQty && <th class="num">Qty</th>}<th class="num">Pack</th><th>Brand</th>{hasStep && <th>Step</th>}</tr>
      {s.map((c) => <tr data-cat={c.p.category ?? ''}><td class="num"><a href={url.part(c.p.id)}>{c.p.number}</a></td><td>{c.p.category && <a class="caticon" href={`/rc/categories/${c.p.category}/`} title={catName(c.p.category)}><Icon name={c.p.category} /></a>} {c.p.name}</td><td class="muted">{catName(c.p.category)}</td>{hasQty && <td class="num">{c.qty ?? ''}</td>}<td class="num">{c.p.pack_qty ?? ''}</td><td>{brandName(c.p.brand)}</td>{hasStep && <td class="muted">{c.step ?? ''}</td>}</tr>)}
    </table></>; })}
  <script>
    const sel = document.getElementById('catfilter') as HTMLSelectElement | null;
    sel?.addEventListener('change', () => {
      for (const tr of document.querySelectorAll<HTMLTableRowElement>('tr[data-cat]')) tr.hidden = !!sel.value && tr.dataset.cat !== sel.value;
    });
  </script>
</Base>
