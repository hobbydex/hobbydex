---
import { buildLabel } from '../../../lib/build';
import Base from '../../../layouts/Base.astro';
import Discontinued from '../../../components/Discontinued.astro';
import { db, url, key, brandName, dateKey, dateDoubt, SEEN_NOTE } from '../../../lib/data';
import DateText from '../../../components/DateText.astro';
import DateDoubt from '../../../components/DateDoubt.astro';
import DoubtNote from '../../../components/DoubtNote.astro';
// The newest releases with a known date, the filterable table over every release (list.json, loaded by the
// release table script), and every brand's full release list on its own page (/rc/releases/<brand>/): one table
// of all 5,500 releases was 1.3 MB. The newest table stays in the HTML for readers without script and for search engines.
const NEWEST = 100;
const dated = db.releases.filter((r) => dateKey(r)).sort((a, b) => dateKey(b).localeCompare(dateKey(a)) || brandName(a.brand).localeCompare(brandName(b.brand)) || a.name.localeCompare(b.name)).slice(0, NEWEST);
const byBrand = [...db.releases.reduce((m, r) => m.set(r.brand, (m.get(r.brand) ?? 0) + 1), new Map<string, number>())]
  .sort((a, b) => b[1] - a[1] || brandName(a[0]).localeCompare(brandName(b[0])));
import SeenNote from '../../../components/SeenNote.astro';
import Icon from '../../../components/Icon.astro';
import { kitTypeLabel, kitTypeOrder, kitTypeIcon } from '../../../lib/kitTypes';
import { releasesByType } from '../../../lib/releaseTypes';
// every type with its release count, in the platform type order
const typeCats = [...releasesByType.keys()].sort((a, b) => (kitTypeOrder.indexOf(a) + 1 || 99) - (kitTypeOrder.indexOf(b) + 1 || 99));
---
<Base title="Releases" description="RC kit and RTR releases in Hobbydex: filter every release by brand, type, scale, build and year, or see the newest, and every brand's releases on its own page.">
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / Releases</div>
  <h1>Releases</h1>
  <p class="muted">{db.releases.length} releases from {byBrand.length} brands. A table you can filter by brand, type, scale, build and year, then every brand's release list.</p>
  <h2 id="table">Releases <span class="muted">· <a href="/rc/releases/by-year/">all releases by year</a></span></h2>
  <form id="release-filters" class="release-filters" hidden>
    <label><span>Brand</span><select id="f-brand"></select></label>
    <label><span>Type</span><select id="f-type"></select></label>
    <label><span>Scale</span><select id="f-scale"></select></label>
    <label><span>Build</span><select id="f-build"></select></label>
    <div class="yearstep" role="group" aria-label="Year">
      <span class="yearlbl">Year</span>
      <span class="ybtns">
      <button type="button" id="y-back5" aria-label="Five years back">«</button>
      <button type="button" id="y-back1" aria-label="One year back">‹</button>
      <button type="button" id="y-all" aria-pressed="true">All years</button>
      <button type="button" id="y-fwd1" aria-label="One year forward">›</button>
      <button type="button" id="y-fwd5" aria-label="Five years forward">»</button>
      </span>
    </div>
    <label><span>Sort</span><select id="f-sort">
      <option value="date-desc">Newest first</option><option value="date-asc">Oldest first</option>
      <option value="name-asc">Name A to Z</option><option value="name-desc">Name Z to A</option>
      <option value="brand-asc">Brand A to Z</option><option value="brand-desc">Brand Z to A</option>
    </select></label>
    <button type="button" id="release-clear">Clear filters</button>
  </form>
  <ul class="typegrid typechips" aria-label="Types">{typeCats.map((t) => <li>
    <a href={`/rc/releases/types/${t}/`}><Icon name={kitTypeIcon(t)} size="1.2rem" /><b>{kitTypeLabel[t] ?? t}</b></a>
    <span class="muted">{releasesByType.get(t)!.length} · <a class="tablelink" href={`/rc/releases/?type=${t}`}>in the table</a></span>
  </li>)}</ul>
  <div id="release-results" hidden data-src="/rc/releases/list.json" data-seen-note={SEEN_NOTE}>
    <p class="muted" id="release-count" aria-live="polite"></p>
    <table class="releases">
      <thead><tr><th data-sort="date"><button type="button" class="sortbtn">Released</button></th><th data-sort="brand"><button type="button" class="sortbtn">Brand</button></th><th data-sort="name"><button type="button" class="sortbtn">Release</button></th><th>Type</th><th>Scale</th><th>Build</th></tr></thead>
      <tbody></tbody>
    </table>
    <p><button type="button" id="release-more" hidden>Show more</button></p>
  </div>
  <table class="releases" id="release-newest">
    <tr><th class="num">Released</th><th>Brand</th><th>Release</th><th class="num">Item no.</th><th>Build</th><th class="num">Parts</th></tr>
    {dated.map((r) => <tr>
      <td class="num" data-label="Released"><DateText r={r} /><DateDoubt reason={dateDoubt(r)} /></td><td data-label="Brand"><a href={url.brand(r.brand)}>{brandName(r.brand)}</a></td><td class="name" data-label="Release"><a href={url.release(r.id)}>{r.name}</a><Discontinued item={r} /></td>
      <td class="num" data-label="Item no.">{r.number ?? ''}</td><td data-label="Build">{buildLabel(r.kind)}</td><td class="num" data-label="Parts">{r.contains?.length ?? 0}</td>
    </tr>)}
  </table>
  <DoubtNote on={dated.some((r) => !!dateDoubt(r))} />
  <SeenNote rows={dated} />
  <h2>By brand</h2>
  <table class="sortable">
    <thead><tr><th>Brand</th><th class="num">Releases</th><th><span class="sr-only">Filtered table</span></th></tr></thead>
    <tbody>{byBrand.map(([b, n]) => <tr><td><a href={`/rc/releases/${key(b)[0]}/`}>{brandName(b)}</a></td><td class="num">{n}</td><td><a href={`/rc/releases/?brand=${key(b)[0]}`}>in the table</a></td></tr>)}</tbody>
  </table>
  <script src="/sort-table.js" defer></script>
  <script src="/release-table.js" type="module"></script>
  <style is:global>
  @media (max-width: 600px) { table.releases td[data-label]:not(:empty) { display: inline-block; white-space: normal; } }
  .release-filters { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.6rem 0.9rem; align-items: end; margin: 0.75rem 0; }
  .release-filters label { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.85rem; color: var(--muted); }
  .release-filters select { font-size: 0.95rem; padding: 0.35rem 0.5rem; color: var(--fg); min-width: 0; width: 100%; box-sizing: border-box; }
  .release-filters[hidden], #release-newest[hidden] { display: none !important; }
  .yearstep { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; min-width: 0; }
  #release-results .relart.inrow { display: inline-block; width: 2.6em; height: 1.3em; vertical-align: -0.25em; margin-right: 0.3rem; mask-size: 100% 100%; -webkit-mask-size: 100% 100%; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; }
  .yearstep .yearlbl { flex: 0 0 100%; font-size: 0.85rem; color: var(--muted); }
  .yearstep .ybtns { display: flex; flex-wrap: nowrap; align-items: center; gap: 0.25rem; }
  .yearstep button { padding: 0.3rem 0.45rem; font-size: 0.95rem; color: var(--fg); }
  .yearstep button:disabled { opacity: 0.4; cursor: default; }
  .yearstep button[aria-pressed="true"] { border-color: var(--accent); }
  .yearstep #y-all { white-space: nowrap; }
  .yearstep button:not(#y-all) { min-width: 2.2rem; }
  .release-filters button { justify-self: start; padding: 0.35rem 0.8rem; }
  #release-results .relart, #release-results .icon { color: var(--muted); margin-right: 0.15rem; }
  ul.typegrid.typechips { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.4rem; margin: 0.5rem 0 0.75rem; }
  ul.typegrid.typechips > li { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.35rem 0.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; min-width: 0; font-size: 0.8rem; }
  ul.typegrid.typechips > li > a:first-child { display: flex; flex-direction: row; align-items: center; gap: 0.35rem; padding: 0; background: none; border: 0; color: var(--fg); font-size: 0.85rem; line-height: 1.2; text-align: left; }
  ul.typegrid.typechips > li > a:first-child:hover { color: var(--accent); }
  ul.typegrid.typechips > li > a:first-child b { font-weight: 600; }
  ul.typegrid.typechips a.tablelink { display: inline; padding: 0; border: 0; background: none; font-size: 0.8rem; color: var(--accent); }
  @media (max-width: 600px) {
    ul.typegrid.typechips { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.3rem; }
    ul.typegrid.typechips > li { padding: 0.3rem 0.35rem; }
    ul.typegrid.typechips > li > a:first-child { font-size: 0.78rem; gap: 0.15rem; flex-direction: column; align-items: flex-start; }
    ul.typegrid.typechips > li > a:first-child b { min-width: 0; }
    .release-filters { grid-template-columns: 1fr 1fr; gap: 0.5rem 0.6rem; }
    .release-filters button { grid-column: 1 / -1; }
    .release-filters .yearstep { grid-column: 1 / -1; }
    #release-results td.name { display: block !important; white-space: normal; overflow-wrap: anywhere; }
    #release-results table, #release-results tbody { width: 100%; max-width: 100%; }
  }
  #release-results thead th button { all: unset; cursor: pointer; font: inherit; color: inherit; }
  #release-results thead th button:hover { color: var(--accent); }
  #release-results thead th[aria-sort] button::after { content: " \2191"; color: var(--muted); }
  #release-results thead th[aria-sort="descending"] button::after { content: " \2193"; }
  #release-results tr.yeardiv th { text-align: left; font-size: 0.85rem; color: var(--muted); background: var(--surface); }
  </style>
</Base>
