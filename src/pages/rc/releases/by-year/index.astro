---
import Base from '../../../../layouts/Base.astro';
import { db, listYear } from '../../../../lib/data';
// every release with a known year, one page per year (one table of all releases is too big for a page)
const counts = [...db.releases.reduce((m, r) => { const y = listYear(r); return y ? m.set(y, (m.get(y) ?? 0) + 1) : m; }, new Map<number, number>())].sort((a, b) => b[0] - a[0]);
const dated = counts.reduce((s, [, n]) => s + n, 0);
---
<Base title="Releases by year" description="Every dated RC release in Hobbydex, newest year first.">
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href="/rc/releases/">Releases</a> / by year</div>
  <h1>Releases by year</h1>
  <p class="muted">{dated} of {db.releases.length} releases have a release year or a first sighting; the others are on their <a href="/rc/releases/">brand's release list</a>.</p>
  <table>
    <tr><th>Year</th><th class="num">Releases</th></tr>
    {counts.map(([y, n]) => <tr><td><a href={`/rc/releases/by-year/${y}/`}>{y}</a></td><td class="num">{n}</td></tr>)}
  </table>
</Base>
