---
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import ReleaseArt from '../../../../components/ReleaseArt.astro';
import { db, url, brandName, yearText } from '../../../../lib/data';
import { kitTypeLabel, kitTypeIcon, kitTypeAbout } from '../../../../lib/kitTypes';
import DriveFilter from '../../../../components/DriveFilter.astro';
import { driveLabel } from '../../../../lib/drive';
export function getStaticPaths() {
  return [...new Set([...db.kits.map((k) => k.category || 'car'), ...db.releases.flatMap((r) => (r.category ? [r.category] : []))])].map((type) => ({ params: { type } }));
}
const { type } = Astro.params;
const label = kitTypeLabel[type] ?? type;
const scaleKey = (s?: string) => (s ? Number(s.split('/')[1]) : 999);
const kits = db.kits.filter((k) => (k.category || 'car') === type)
  .sort((a, b) => scaleKey(a.scale) - scaleKey(b.scale) || brandName(a.brand).localeCompare(brandName(b.brand)) || a.name.localeCompare(b.name));
// one table per scale, largest models first (1/5 before 1/10); kits without a scale last
// releases of this type on another type's chassis (Tamiya race trucks on the TT-01E touring car kit)
const onOther = db.releases.filter((r) => r.category === type && (db.kit.get(r.kit)?.category || 'car') !== type)
  .sort((a, b) => brandName(a.brand).localeCompare(brandName(b.brand)) || a.name.localeCompare(b.name));
const scales = [...new Set(kits.map((k) => k.scale ?? ''))].sort((a, b) => scaleKey(a || undefined) - scaleKey(b || undefined));
---
<Base title={label} description={`${label}: ${kits.length} RC kits in Hobbydex, by scale and brand.`}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href="/rc/kits/">Kits</a> / {label}</div>
  <h1><Icon name={kitTypeIcon(type)} size="1.4em" /> {label} <span class="muted">({kits.length + onOther.length})</span></h1>
  {kitTypeAbout[type] && <p class="about">{kitTypeAbout[type]}</p>}
  {scales.length > 1 && <p class="muted" data-pagefind-ignore>{scales.map((sc, i) => <>{i > 0 && ' · '}<a href={`#scale-${sc ? sc.replace('/', '-') : 'unknown'}`}>{sc || 'scale unknown'}</a> ({kits.filter((k) => (k.scale ?? '') === sc).length})</>)}</p>}
  <DriveFilter drives={kits.map((k) => k.drive)} />
  {scales.map((sc) => { const ks = kits.filter((k) => (k.scale ?? '') === sc); return <section class="drivegroup">
    <h2 id={`scale-${sc ? sc.replace('/', '-') : 'unknown'}`}>{sc || 'Scale unknown'} <span class="muted">({ks.length})</span></h2>
    <table>
      <tr><th class="artcol"></th><th>Brand</th><th>Kit</th><th>Drive</th><th>Power</th><th class="num">Releases</th></tr>
      {ks.map((k) => <tr data-drive={k.drive ?? ''}>
        <td class="artcol"><a href={url.kit(k.id)} tabindex="-1" aria-hidden="true">{k.art ? <ReleaseArt id={k.id} category={k.category} kitArt={k.art} size="1.3em" class="inrow" /> : <Icon name={kitTypeIcon(k.category)} size="1.3em" />}</a></td>
        <td><a href={url.brand(k.brand)}>{brandName(k.brand)}</a></td><td><a href={url.kit(k.id)}>{k.name}</a></td>
        <td>{driveLabel(k.drive)}</td><td>{k.power ?? ''}</td><td class="num">{db.releasesByKit.get(k.id)?.length ?? 0}</td>
      </tr>)}
    </table></section>; })}
  {onOther.length > 0 && <>
    <h2>On another chassis <span class="muted">({onOther.length})</span></h2>
    <p class="muted">Releases of this type built on a kit of another type.</p>
    <table>
      <tr><th>Brand</th><th>Release</th><th>Kit</th><th class="num">Year</th></tr>
      {onOther.map((r) => <tr><td><a href={url.brand(r.brand)}>{brandName(r.brand)}</a></td><td><a href={url.release(r.id)}>{r.name}</a></td><td><a href={url.kit(r.kit)}>{db.kit.get(r.kit)?.name}</a></td><td class="num">{yearText(r)}</td></tr>)}
    </table></>}
  <style>.about { max-width: 46rem; font-size: 1.05rem; }</style>
</Base>
<style>
  .artcol { width: 3.2em; padding-right: 0 !important; }
  .artcol a { color: var(--fg); }
</style>
