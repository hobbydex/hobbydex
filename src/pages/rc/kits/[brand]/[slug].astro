---
import Base from '../../../../layouts/Base.astro';
import { db, key, url, brandName, yearOf, yearText } from '../../../../lib/data';
import Icon from '../../../../components/Icon.astro';
import { kitTypeIcon, kitTypeOne } from '../../../../lib/kitTypes';
export function getStaticPaths() {
  return db.kits.map((k) => ({ params: { brand: key(k.id)[0], slug: key(k.id)[1] }, props: { kit: k } }));
}
const { kit } = Astro.props;
const releases = [...(db.releasesByKit.get(kit.id) ?? [])].sort((a, b) => yearOf(a) - yearOf(b) || a.name.localeCompare(b.name));
const count = (r: (typeof releases)[number], role: string) => (r.contains ?? []).filter((c) => c.role === role).length;
const show = { number: releases.some((r) => r.number), edition: releases.some((r) => r.edition), kit: releases.some((r) => count(r, 'kit')),
  option: releases.some((r) => count(r, 'option')), listed: releases.some((r) => count(r, 'listed')) };
const fits = [...(db.fitsByKit.get(kit.id) ?? [])].sort((a, b) => a.part.number.localeCompare(b.part.number));
const relations = db.kitRelations.get(kit.id) ?? [];
// parts of interchangeable rebrands, for kits whose own releases list none
const ownParts = releases.reduce((n, r) => n + (r.contains?.length ?? 0), 0);
const borrowed = ownParts > 0 ? [] : relations.filter((r) => r.link.parts === 'interchangeable').flatMap((r) =>
  (db.releasesByKit.get(r.other) ?? []).flatMap((rel) => (rel.contains ?? []).map((c) => ({ c, rel, p: db.part.get(c.part)! })))).filter((x) => x.p);
const seen = new Set<string>();
const borrowedUnique = borrowed.filter((x) => !seen.has(x.c.part) && seen.add(x.c.part)).sort((a, b) => a.p.number.localeCompare(b.p.number));
---
<Base title={`${brandName(kit.brand)} ${kit.name}`} description={`${brandName(kit.brand)} ${kit.name}: releases and parts.`} kind="kit" sub={brandName(kit.brand)}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href={url.brand(kit.brand)}>{brandName(kit.brand)}</a> / {kit.name}</div>
  <div class="kithead">
    <a href={`/rc/kits/types/${kit.category || 'car'}/`} title={kitTypeOne[kit.category ?? 'car'] ?? kit.category}><Icon name={kitTypeIcon(kit.category)} size="3rem" /></a>
    <h1 data-pagefind-meta="title" data-pagefind-weight="10" data-pagefind-sort="title">{brandName(kit.brand)} {kit.name}</h1>
  </div>
  <dl class="facts">
    <dt>Category</dt><dd>{kit.category}</dd>
    {kit.scale && <><dt>Scale</dt><dd>{kit.scale}</dd></>}
    {kit.drive && <><dt>Drive</dt><dd>{kit.drive}</dd></>}
    {kit.power && <><dt>Power</dt><dd>{kit.power}</dd></>}
  </dl>
  {kit.notes && <p class="muted">{kit.notes}</p>}
  {relations.length > 0 && <>
    <h2>Same car or platform</h2>
    <ul>
      {relations.map((r) => { const o = db.kit.get(r.other); const label = r.relation === 'rebrand' ? (r.reverse ? 'Also sold as' : 'Rebrand of') : 'Shares its platform with'; return <li>
        {label} <a href={url.kit(r.other)}>{o ? `${brandName(o.brand)} ${o.name}` : r.other}</a>
        {r.link.parts && <span class="muted"> · parts {r.link.parts}</span>}{r.link.notes && <span class="muted"> · {r.link.notes}</span>}
      </li>; })}
    </ul></>}
  <h2>Releases</h2>
  <table>
    <tr><th class="num">Year</th><th>Release</th>{show.number && <th class="num">Item no.</th>}{show.edition && <th>Edition</th>}{show.kit && <th class="num">In the box</th>}{show.option && <th class="num">Options</th>}{show.listed && <th class="num">Listed</th>}</tr>
    {releases.map((r) => <tr>
      <td class="num">{yearText(r)}</td><td><a href={url.release(r.id)}>{r.name}</a></td>{show.number && <td class="num">{r.number ?? ''}</td>}{show.edition && <td>{r.edition ?? ''}</td>}
      {show.kit && <td class="num">{count(r, 'kit') || ''}</td>}{show.option && <td class="num">{count(r, 'option') || ''}</td>}{show.listed && <td class="num">{count(r, 'listed') || ''}</td>}
    </tr>)}
  </table>
  {releases.length > 1 && <p><a href={`/rc/compare/?a=${encodeURIComponent(releases[releases.length - 2].id)}&b=${encodeURIComponent(releases[releases.length - 1].id)}`}>Compare the last two releases</a> <span class="muted">or any two releases on the compare page</span></p>}
  {borrowedUnique.length > 0 && <>
    <h2>Parts, from the interchangeable rebrand <span class="muted">({borrowedUnique.length})</span></h2>
    <p class="muted">No parts list for this kit itself; these come from the rebrand above, whose parts interchange.</p>
    <table>
      <tr><th class="num">Number</th><th>Name</th><th>Brand</th><th>From</th></tr>
      {borrowedUnique.map(({ c, rel, p }) => <tr><td class="num"><a href={url.part(p.id)}>{p.number}</a></td><td>{p.name}</td><td>{brandName(p.brand)}</td><td><a href={url.release(rel.id)}>{rel.name}</a></td></tr>)}
    </table></>}
  {fits.length > 0 && <>
    <h2>Option parts listed as fitting <span class="muted">({fits.length})</span></h2>
    <table>
      <tr><th class="num">Number</th><th>Name</th><th>Brand</th><th>Fit</th></tr>
      {fits.map(({ part, fit }) => <tr><td class="num"><a href={url.part(part.id)}>{part.number}</a></td><td>{part.name}</td><td>{brandName(part.brand)}</td><td>{fit.type}{fit.notes && <span class="muted"> · {fit.notes}</span>}</td></tr>)}
    </table></>}
</Base>
