---
import Base from '../../../layouts/Base.astro';
import { db, key, url, type Spec, type Standard } from '../../../lib/data';
import { specColumns, specLabel, specSort } from '../../../lib/specs';
export function getStaticPaths() {
  return db.standards.map((s) => ({ params: { slug: key(s.id)[0] }, props: { std: s } }));
}
const { std } = Astro.props as { std: Standard };
const by = std.replaced_by ? db.standard.get(std.replaced_by) : undefined;
const replaces = db.standards.filter((s) => s.replaced_by === std.id);
const specs = db.specs.filter((s) => s.standards?.includes(std.code)).sort(specSort);
// one table per spec category the standard covers; each shows the category's own columns, and only those
// that some row has a value for (a wire standard has no thread, a screw standard no diameter)
const has = (s: Spec, k: string) => s[k] !== undefined && s[k] !== null && s[k] !== '';
const cell = (s: Spec, k: string, unset = '') => typeof s[k] === 'boolean' ? (s[k] ? 'yes' : 'no') : has(s, k) ? String(s[k]) : unset;
const groups = [...new Set(specs.map((s) => s.category))].map((category) => {
  const rows = specs.filter((s) => s.category === category);
  const cols = (specColumns[category] ?? []).filter(([k]) => rows.some((s) => has(s, k)));
  return { category, rows, cols: cols.map(([k, label, unset]) => ({ k, label, unset, num: rows.every((s) => typeof s[k] === 'number' || !has(s, k)) })) };
});
---
<Base title={`${std.code}: ${std.title}`} description={`${std.code}, ${std.title}: the generic specs in Hobbydex that follow it and the branded parts that match.`}>
  <div class="crumbs" data-pagefind-ignore><a href="/">Hobbydex</a> / <a href="/rc/">RC cars</a> / <a href="/rc/specs/">Specs</a> / <a href="/rc/standards/">Standards</a> / {std.code}</div>
  <h1 data-pagefind-meta="title" data-pagefind-weight="10">{std.code}: {std.title}</h1>
  {std.notes && <p>{std.notes}</p>}
  <dl class="facts">
    {std.url && <><dt>Publisher's page</dt><dd><a href={std.url} rel="external">{new URL(std.url).hostname}</a> <span class="muted">(title, scope, edition; the text is sold)</span></dd></>}
    {by && <><dt>Replaced by</dt><dd><a href={url.standard(by.id)}>{by.code}</a> {by.title}</dd></>}
    {replaces.length > 0 && <><dt>Replaces</dt><dd>{replaces.map((r, i) => <>{i > 0 && ', '}<a href={url.standard(r.id)}>{r.code}</a></>)}</dd></>}
  </dl>
  <h2>Sizes <span class="muted">({specs.length})</span></h2>
  {specs.length === 0 ? <p class="muted">No spec cites it yet.</p> :
  groups.map((g) => <>
    {groups.length > 1 && <h3>{specLabel[g.category] ?? g.category}</h3>}
    <div class="tablescroll"><table>
      <tr><th>Spec</th>{g.cols.map((c) => <th class={c.num ? 'num' : undefined}>{c.label}</th>)}<th class="num">Matching parts</th></tr>
      {g.rows.map((s) => <tr><td><a href={url.spec(s.id)}>{s.name ?? key(s.id)[1]}</a></td>{g.cols.map((c) => <td class={c.num ? 'num' : undefined}>{cell(s, c.k, c.unset)}</td>)}<td class="num">{db.partsBySpec.get(s.id)?.length ?? 0}</td></tr>)}
    </table></div>
  </>)}
</Base>
